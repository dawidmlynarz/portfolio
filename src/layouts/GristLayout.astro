---
/**
 * Grist (/grist): its own slim header (logo home to /grist, About and the site's theme switch on the
 * right) and the simple footer. Shares BaseLayout, so SEO tags, theme and fonts stay the
 * site's. No motion module: nothing on Grist animates except the gems and the New badge (CSS).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/blocks/Footer.astro";
import Container from "@/components/layout/Container.astro";
import Logo from "@/components/grist/Logo.astro";
import AboutButton from "@/components/grist/AboutButton.astro";
import AboutPanel from "@/components/grist/AboutPanel.astro";
import ThemeToggle from "@/components/blocks/ThemeToggle.astro";
import NewBadge from "@/components/grist/NewBadge.astro";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof BaseLayout> & {
  /** Dawid's preview copy of the front door: a Sandbox badge by the logo, which leads back to it. */
  sandbox?: boolean;
};

const { sandbox = false, ...props } = Astro.props;
---

<BaseLayout {...props}>
  <slot name="head" slot="head" />
  <div class="grist">
    <header class="grist__header">
      <Container class="grist__bar">
        <div class="grist__brand">
          <a
            class="grist__home"
            href={sandbox ? "/grist/sandbox" : "/grist"}
            aria-label={sandbox ? "Grist sandbox, every drop" : "Grist, all drops"}
            data-no-tear
          >
            <Logo hop />
          </a>
          {sandbox && <NewBadge label="Sandbox" />}
        </div>
        <div class="grist__actions">
          <AboutButton panel="about" />
          <ThemeToggle />
        </div>
      </Container>
    </header>
    <AboutPanel id="about" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer variant="simple" />
  </div>
</BaseLayout>

<style>
  @layer components {
    .grist {
      display: grid;
      grid-template-rows: auto 1fr auto;
      grid-template-columns: minmax(0, 1fr);
      min-block-size: 100svh;
    }

    .grist__header {
      border-block-end: var(--border-width) solid var(--color-border-subtle);
    }

    .grist__bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding-block: var(--space-4);
    }

    .grist__brand {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .grist__home {
      --underline-size: 0%;

      display: block;
    }

    .grist__actions {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }

    /* The theme switch as in the site's nav: a round ghost button, no ring, a soft fill on hover. */
    .grist__actions :global(.theme-toggle:not([hidden])) {
      display: grid;
      place-items: center;
      inline-size: var(--space-10);
      block-size: var(--space-10);
      padding: 0;
      border: 0;
    }

    /*
     * Text links: the site's hairline underline, without the portfolio's row tear (Grist doesn't
     * load the motion module). On hover the ink softens a shade instead.
     */
    .grist :global(a.link) {
      transition:
        background-size var(--duration-link) var(--ease-out-expo),
        color var(--duration-fast) var(--ease-standard);
    }

    .grist :global(a.link:hover) {
      color: var(--color-text-muted);
    }

    .grist__home :global(.logo) {
      block-size: var(--space-6);
    }

    main:focus {
      outline: none;
    }
  }
</style>
