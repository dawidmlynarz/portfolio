---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/blocks/Nav.astro";
import Footer from "@/components/blocks/Footer.astro";
import Button from "@/components/ui/Button.astro";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof BaseLayout> & {
  /** Let the first section run under the floating nav (full-bleed heroes). */
  navOverlap?: boolean;
  /** One screen, no footer (/contact): the page is exactly the viewport tall when its content
   * fits, so there is nothing to scroll; on very short screens it still scrolls. */
  fit?: boolean;
};

const { navOverlap = false, fit = false, ...base } = Astro.props;
---

<BaseLayout {...base}>
  <div class:list={["site", { "site--nav-overlap": navOverlap, "site--fit": fit }]} id="top">
    <a class="skip-link" href="#main" data-no-tear>
      Skip to content
    </a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!fit && (
      <>
        <Footer />
        <Button
          class="to-top"
          href="#top"
          variant="secondary"
          icon="arrow-up"
          label="Back to top"
        />
      </>
    )}
  </div>
</BaseLayout>

<script>
  import "@/scripts/motion";
</script>

<style>
  @layer components {
    .site {
      display: grid;
      grid-template-rows: 1fr auto;
      grid-template-columns: minmax(0, 1fr);
      min-block-size: 100svh;
    }

    .skip-link {
      position: fixed;
      inset-block-start: var(--space-2);
      inset-inline-start: var(--space-2);
      z-index: calc(var(--z-nav) + 1);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-sm);
      color: var(--color-bg);
      background-color: var(--color-text);
      translate: 0 -200%;
    }

    .skip-link:focus-visible {
      translate: 0;
    }

    /* Back to top floats over the page on the nav's glass; Button draws it and its hover. */
    .to-top {
      position: fixed;
      inset-block-end: var(--space-8);
      inset-inline-end: var(--space-8);
      z-index: var(--z-nav);
      background-color: var(--color-overlay);
      backdrop-filter: blur(var(--blur-nav));
    }

    /* Hidden at the top of the page, fades in after the first screen of scrolling. */
    @supports (animation-timeline: scroll()) {
      .to-top {
        opacity: 0;
        visibility: hidden;
        animation-name: to-top-show;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-range: 50vh 80vh;
      }

      .to-top:where(a) {
        animation-timeline: scroll(root);
      }

      .to-top:focus-visible {
        opacity: 1;
        visibility: visible;
      }
    }

    @keyframes to-top-show {
      to {
        opacity: 1;
        visibility: visible;
      }
    }

    /* One screen: main fills the viewport and its last child takes the room that is left. */
    .site--fit {
      grid-template-rows: 1fr;
    }

    .site--fit main {
      display: grid;
      grid-template-rows: auto minmax(var(--space-24), 1fr);
      grid-template-columns: minmax(0, 1fr);
    }

    main:focus {
      outline: none;
    }

    /* Keep content clear of the floating nav pill unless the page opts in to run under it. */
    main {
      padding-block-start: var(--nav-clearance);
    }

    .site--nav-overlap main {
      padding-block-start: 0;
    }
  }
</style>
