---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/blocks/Nav.astro";
import Footer from "@/components/blocks/Footer.astro";
import BackdropPicker from "@/components/blocks/BackdropPicker.astro";
import { isProduction } from "@/lib/site";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof BaseLayout> & {
  /** Let the first section run under the floating nav (full-bleed heroes). */
  navOverlap?: boolean;
};

const { navOverlap = false, ...base } = Astro.props;
---

<BaseLayout {...base}>
  <div class:list={["site", { "site--nav-overlap": navOverlap }]} id="top">
    <a class="skip-link" href="#main" data-no-tear>
      Skip to content
    </a>
    {!isProduction && <BackdropPicker />}
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <a class="to-top" href="#top" data-no-tear>
      <svg class="to-top__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" />
      </svg>
      <span class="visually-hidden">Back to top</span>
    </a>
  </div>
</BaseLayout>

<script>
  import "@/scripts/motion";
</script>

<style>
  @layer components {
    .site {
      display: grid;
      grid-template-rows: 1fr auto;
      grid-template-columns: minmax(0, 1fr);
      min-block-size: 100svh;
    }

    .skip-link {
      position: fixed;
      inset-block-start: var(--space-2);
      inset-inline-start: var(--space-2);
      z-index: calc(var(--z-nav) + 1);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-sm);
      color: var(--color-bg);
      background-color: var(--color-text);
      translate: 0 -200%;
    }

    .skip-link:focus-visible {
      translate: 0;
    }

    .to-top {
      --underline-size: 0%;

      position: fixed;
      inset-block-end: var(--space-8);
      inset-inline-end: var(--space-8);
      z-index: var(--z-nav);
      display: grid;
      place-items: center;
      padding: var(--space-3);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background-color: var(--color-overlay);
      backdrop-filter: blur(var(--blur-nav));
      transition: background-color var(--duration-fast) var(--ease-standard);
    }

    .to-top:hover {
      background-color: var(--color-bg-subtle);
    }

    .to-top__icon {
      inline-size: 1.25em;
      block-size: 1.25em;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* Hidden at the top of the page, fades in after the first screen of scrolling. */
    @supports (animation-timeline: scroll()) {
      .to-top {
        opacity: 0;
        visibility: hidden;
        animation-name: to-top-show;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-range: 50vh 80vh;
      }

      .to-top:where(a) {
        animation-timeline: scroll(root);
      }

      .to-top:focus-visible {
        opacity: 1;
        visibility: visible;
      }
    }

    @keyframes to-top-show {
      to {
        opacity: 1;
        visibility: visible;
      }
    }

    main:focus {
      outline: none;
    }

    /* Keep content clear of the floating nav pill unless the page opts in to run under it. */
    main {
      padding-block-start: var(--nav-clearance);
    }

    .site--nav-overlap main {
      padding-block-start: 0;
    }
  }
</style>
