---
import { Image, getImage } from "astro:assets";
import { breadcrumbs, personId, websiteId } from "@/lib/schema";
import SiteLayout from "@/layouts/SiteLayout.astro";
import Container from "@/components/layout/Container.astro";
import Tag from "@/components/ui/Tag.astro";
import ClientLogo from "@/components/ui/ClientLogo.astro";
import Prose from "@/components/content/Prose.astro";
import Metrics from "@/components/content/Metrics.astro";
import NextUp from "@/components/content/NextUp.astro";
import CaseStudyToc from "@/components/content/CaseStudyToc.astro";
import HeroBackdrop from "@/components/blocks/HeroBackdrop.astro";
import type { MarkdownHeading } from "astro";
import type { Work } from "@/lib/work";

interface Props {
  entry: Work;
  /** Up to three case studies for "Next up", in order. */
  nextUp?: Work[];
  /** The MDX headings, for the contents mini map. */
  headings?: MarkdownHeading[];
}

const { entry, nextUp = [], headings = [] } = Astro.props;
const { data } = entry;

// Structured data image: the cover cropped to 1200×630. The share image is the site-wide one.
const og = await getImage({
  src: data.cover,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpeg",
  quality: 82,
});
const site = Astro.site!;
const url = new URL(`/work/${entry.id}`, site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CreativeWork",
      "@id": `${url}#case-study`,
      name: data.title,
      headline: data.title,
      description: data.seoDescription ?? data.description,
      image: new URL(og.src, site).href,
      url,
      ...(data.year ? { dateCreated: String(data.year) } : {}),
      keywords: [data.industry, ...data.tags].join(", "),
      author: { "@id": personId(site) },
      isPartOf: { "@id": websiteId(site) },
    },
    breadcrumbs(site, [
      ["Work", "/work"],
      [data.title, `/work/${entry.id}`],
    ]),
  ],
};

const facts = [
  { term: "My role", detail: data.via ? `${data.role} (via ${data.via})` : data.role },
  { term: "Industry", detail: data.industry },
  { term: "Business", detail: data.business },
  ...(data.date || data.year ? [{ term: "Date", detail: data.date ?? String(data.year) }] : []),
];
---

<SiteLayout
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.description}
  type="article"
  jsonLd={jsonLd}
>
  <article class="case-study">
    <header class="case-study__header hero-backdrop-host">
      <HeroBackdrop />
      <Container class="case-study__intro">
        {data.client ? (
          <p class="case-study__logo">
            <ClientLogo client={data.client} label={`Case study for ${data.company}`} />
          </p>
        ) : (
          <p class="text-caption case-study__eyebrow">Case study · {data.company}</p>
        )}
        <h1 class="case-study__title" data-reveal="lines">
          {data.title}
        </h1>
        <p class="text-lead case-study__lead">{data.lead ?? data.description}</p>
        <ul class="case-study__tags" role="list">
          {data.tags.map((tag) => (
            <Tag as="li">{tag}</Tag>
          ))}
        </ul>
      </Container>

      <div class="case-study__cover" data-parallax>
        <Image
          class="case-study__cover-img"
          src={data.cover}
          alt={data.coverAlt}
          widths={[800, 1200, 1600, 2400, 3200].filter((w) => w <= data.cover.width)}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          format="avif"
        />
      </div>

      <Container width="narrow">
        <dl class="case-study__facts">
          {facts.map(({ term, detail }) => (
            <div class="case-study__fact">
              <dt class="text-caption">{term}</dt>
              <dd>{detail}</dd>
            </div>
          ))}
        </dl>
      </Container>
    </header>

    <Prose class="case-study__body">
      {data.metrics.length > 0 && <Metrics items={data.metrics} />}
      <slot />
    </Prose>
  </article>

  <CaseStudyToc headings={headings} body=".case-study__body" />
  <NextUp entries={nextUp} />
</SiteLayout>

<style>
  @layer components {
    .case-study__header {
      display: grid;
      gap: var(--space-12);
      padding-block: var(--space-section-sm) var(--space-section-sm);
    }

    .case-study__intro {
      display: grid;
      justify-items: start;
      gap: var(--space-6);
    }

    /* The client's logo stands in for the "Case study · Company" line. */
    .case-study__logo :global(svg) {
      display: block;
      inline-size: auto;
      block-size: var(--space-12);
    }

    .case-study__eyebrow,
    .case-study__lead {
      color: var(--color-text-muted);
    }

    .case-study__tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      padding: 0;
    }

    /* Edge to edge at every size: a 3:2 crop on phones. From 48em the frame is 2:1 and holds the
       cover at 16:9, centred; the motion layer drifts it through the frame as the page scrolls
       past ([data-parallax], motion.ts). Without motion it stays centred. */
    .case-study__cover {
      position: relative;
      overflow: hidden;
      aspect-ratio: 3 / 2;
      background-color: var(--color-bg-subtle);
    }

    .case-study__cover-img {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }

    .case-study__facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-8);
      padding-block-end: var(--space-8);
      border-block-end: var(--border-width) solid var(--color-border-subtle);
    }

    .case-study__fact {
      display: grid;
      gap: var(--space-1);
      align-content: start;
    }

    .case-study__fact dt {
      color: var(--color-text-muted);
    }

    .case-study__fact dd {
      margin: 0;
    }

    .case-study__body {
      padding-block-end: var(--space-section-md);
    }

    @media (width < 48em) {
      .case-study__logo :global(svg) {
        block-size: var(--space-10);
      }
    }

    @media (width >= 48em) {
      .case-study__cover {
        aspect-ratio: 2 / 1;
      }

      .case-study__cover-img {
        position: absolute;
        inset-block-start: 50%;
        inset-inline-start: 0;
        block-size: auto;
        aspect-ratio: 16 / 9;
        translate: 0 -50%;
      }
    }
  }
</style>
