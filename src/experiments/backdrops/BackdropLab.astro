---
/**
 * Backdrop lab: the hero backdrop options (tokens.css, [data-hero-bg]) as small page heads, each in
 * light and dark side by side, with links that open the real pages with that backdrop picked.
 * A private playground (/playground/backgrounds), not linked anywhere.
 *
 * Isolated experiment (CLAUDE.md rule 6): classes live under .backdrop-lab and read only site
 * tokens. data-theme on a tile pins it to one theme.
 */
import { BACKDROPS } from "@/lib/backdrops";

const PAGES = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/work", label: "Case studies" },
  { href: "/work/pantheon", label: "Case study" },
];
const THEMES = ["light", "dark"] as const;
---

<ol class="backdrop-lab" role="list">
  {BACKDROPS.map(({ value, label, note }) => (
    <li class="backdrop-lab__option">
      <div class="backdrop-lab__head">
        <h2 class="backdrop-lab__name">{label}</h2>
        <p class="backdrop-lab__note">{note}</p>
        <p class="backdrop-lab__pages text-small">
          <span class="backdrop-lab__muted">See it on</span>{" "}
          {PAGES.map(({ href, label: page }, index) => (
            <>
              <a href={`${href}?bg=${value}`}>{page}</a>
              {index < PAGES.length - 1 && <span class="backdrop-lab__muted"> · </span>}
            </>
          ))}
        </p>
      </div>
      <div class="backdrop-lab__tiles">
        {THEMES.map((theme) => (
          <div class="backdrop-lab__tile" data-hero-bg={value} data-theme={theme}>
            <p class="text-caption backdrop-lab__muted">{theme}</p>
            <p class="backdrop-lab__title">
              Designing products <span class="backdrop-lab__muted">that ship.</span>
            </p>
          </div>
        ))}
      </div>
    </li>
  ))}
</ol>

<style>
  @layer components {
    .backdrop-lab {
      display: grid;
      gap: var(--space-section-sm);
      padding: 0;
    }

    .backdrop-lab__option {
      display: grid;
      gap: var(--space-6);
    }

    .backdrop-lab__head {
      display: grid;
      gap: var(--space-2);
      max-inline-size: var(--measure);
    }

    .backdrop-lab__name {
      font-size: var(--text-h4);
      line-height: var(--leading-h4);
    }

    .backdrop-lab__note,
    .backdrop-lab__muted {
      color: var(--color-text-muted);
    }

    .backdrop-lab__tiles {
      display: grid;
      gap: var(--space-4);
    }

    .backdrop-lab__tile {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--space-8);
      aspect-ratio: 16 / 9;
      padding: var(--space-6);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-lg);
      color: var(--color-text);
      background: var(--bg-hero);
    }

    .backdrop-lab__title {
      max-inline-size: 12em;
      font-family: var(--font-heading);
      font-size: var(--text-h3);
      font-weight: var(--weight-medium);
      line-height: var(--leading-h3);
      letter-spacing: var(--tracking-h3);
    }

    @media (width >= 48em) {
      .backdrop-lab__tiles {
        grid-template-columns: 1fr 1fr;
      }
    }
  }
</style>
