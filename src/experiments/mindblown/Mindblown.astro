---
/**
 * Mindblown: the About hero. A dotted stage with Dawid's cut-out portrait; hovering lifts the lid
 * so the brain peeks out, clicking pops it off and a random batch of "thought" cards bursts out, each opening a popover;
 * clicking the brain sucks them back in and throws a fresh batch. A tilted ticker
 * stripe closes the section. Behaviour: mindblown.ts. Copy: content.ts. Styles: mindblown.css.
 *
 * Isolated experiment (CLAUDE.md rule 6): every class lives under .mindblown and the section
 * reads only semantic site tokens; illustration colours are local.
 *
 * Without JS (or before it runs) the resting portrait, the note and the stripe still render.
 * The default slot is the page intro: it sits at the top of the stage and fades out when the
 * head opens, so the thoughts can land where it was.
 */
import "@fontsource/gochi-hand/latin-400.css";
import "./mindblown.css";
import restFace from "./assets/rest-face.webp";
import shockedFace from "./assets/shocked-face.webp";
import superFace from "./assets/super-face.webp";
import restTop from "./assets/rest-top.webp";
import shockedTop from "./assets/shocked-top.webp";
import superTop from "./assets/super-top.webp";
import painFace from "./assets/pain-face.webp";
import painTop from "./assets/pain-top.webp";
import silhouette from "./assets/silhouette.webp";
import { BELT } from "./content";

const img = { width: restFace.width, height: restFace.height, decoding: "async" } as const;

/* The hover burst around the gap under the lid (viewBox -160 -60 320 120, centred on the gap):
   speed lines fanning left and right, dots and sparkles. Fixed seed, so every build matches. */
let seed = 7;
const rnd = (a: number, b: number) => {
  seed = (seed * 16807) % 2147483647;
  return a + ((seed - 1) / 2147483646) * (b - a);
};
const r1 = (n: number) => Math.round(n * 10) / 10;
const lines = Array.from({ length: 18 }, (_, i) => {
  const side = i % 2 ? 1 : -1,
    a = (rnd(-26, 26) * Math.PI) / 180,
    from = rnd(34, 62),
    to = from + rnd(26, 92);
  return {
    x1: r1(side * Math.cos(a) * from),
    y1: r1(Math.sin(a) * from * 0.8),
    x2: r1(side * Math.cos(a) * to),
    y2: r1(Math.sin(a) * to * 0.8),
    w: r1(rnd(0.8, 2)),
    tone: i % 3,
  };
});
const dots = Array.from({ length: 16 }, (_, i) => {
  const side = i % 2 ? 1 : -1;
  return {
    cx: r1(side * rnd(40, 150)),
    cy: r1(rnd(-52, 52)),
    r: r1(rnd(1, 3.4)),
    tone: i % 3,
    d: r1(rnd(0, 2)),
  };
});
const sparks = [
  [-118, -34, 1.6],
  [126, -22, 1.3],
  [-74, 40, 1],
  [92, 44, 1.2],
  [-8, -54, 0.9],
] as const;
const belt = [...BELT, ...BELT];
---

<div class="mindblown" data-mindblown>
  <section class="mindblown__stage" aria-labelledby="mindblown-title">
    {Astro.slots.has("default") && (
      <div class="mindblown__intro">
        <slot />
      </div>
    )}
    <h2 class="visually-hidden" id="mindblown-title">
      About Dawid Młynarz
    </h2>
    <div class="mindblown__head-space"></div>

    <div class="mindblown__head-pos">
      <div class="mindblown__rig">
        <div class="mindblown__blob" aria-hidden="true"></div>
        <div
          class="mindblown__head"
          role="button"
          tabindex="0"
          aria-label="Open my head to see what's inside"
          aria-expanded="false"
        >
          <div class="mindblown__layer mindblown__layer--base">
            <img
              class="mindblown__piece mindblown__piece--rest"
              src={restFace.src}
              alt="Dawid, black and white portrait with round glasses"
              {...img}
            />
            <img
              class="mindblown__piece mindblown__piece--shock"
              src={shockedFace.src}
              alt=""
              {...img}
            />
            <img
              class="mindblown__piece mindblown__piece--super"
              src={superFace.src}
              alt=""
              {...img}
            />
            <img
              class="mindblown__piece mindblown__piece--pain"
              src={painFace.src}
              alt=""
              {...img}
            />
          </div>
          <div
            class="mindblown__ring"
            aria-hidden="true"
            style={`--mb-silhouette: url(${silhouette.src})`}
          >
            <div class="mindblown__inside">
              <div class="mindblown__hole"></div>
            </div>
          </div>
          <div class="mindblown__inside mindblown__inside--front" aria-hidden="true">
            <div class="mindblown__brain-clip">
              <svg class="mindblown__brain" viewBox="0 0 140 78">
                <!-- a soft, cloudy cartoon brain: flat pink, lighter and darker blobs, little
                     folds, navy eyes and a smile. The bottom is hidden by the hole's rim. -->
                <path
                  d="M9 78 C1 70 1 56 10 49 A13 13 0 0 1 15 31 A16 16 0 0 1 37 16 A17 17 0 0 1 62 8 A17 17 0 0 1 87 9 A16 16 0 0 1 109 17 A15 15 0 0 1 126 33 A13 13 0 0 1 131 51 C139 58 139 71 131 78 Z"
                  fill="var(--mb-brain)"
                ></path>
                <path
                  d="M14 44 q-4 -10 5 -14 q6 -2 6 4 q0 5 -6 6 q-3 1 -5 4z M12 58 q-3 -6 2 -8 q4 0 3 5 q-1 4 -5 3z"
                  fill="var(--mb-brain-light)"
                ></path>
                <path
                  d="M124 44 q6 -2 6 6 q-1 8 -7 9 q-4 0 -3 -6 q1 -8 4 -9z M112 66 q8 -9 12 -4 q2 5 -6 9 q-7 4 -6 -5z"
                  fill="var(--mb-brain-dark)"
                ></path>
                <path
                  d="M30 30 q5 -5 10 0 M50 22 q2 6 8 6 q4 0 4 -6 M57 28 q0 6 -3 9 M82 18 q5 -4 10 1 M96 30 q6 -4 10 2 M101 31 q0 6 -3 9 M28 52 q5 3 9 -1 M40 66 q5 -5 10 0 M94 64 q4 -4 9 -1 M72 30 q-3 4 0 8 M104 50 q4 2 7 -1"
                  fill="none"
                  stroke="var(--mb-brain-fold)"
                  stroke-width="2.6"
                  stroke-linecap="round"
                ></path>
                <g class="mindblown__eye">
                  <ellipse
                    class="mindblown__pupil"
                    cx="58"
                    cy="48"
                    rx="4.6"
                    ry="7"
                    fill="var(--mb-brain-ink)"
                  ></ellipse>
                </g>
                <g class="mindblown__eye">
                  <ellipse
                    class="mindblown__pupil"
                    cx="82"
                    cy="48"
                    rx="4.6"
                    ry="7"
                    fill="var(--mb-brain-ink)"
                  ></ellipse>
                </g>
                <path
                  d="M64 60 q6 6 12 0"
                  fill="none"
                  stroke="var(--mb-brain-ink)"
                  stroke-width="2.4"
                  stroke-linecap="round"
                ></path>
              </svg>
            </div>
            <div class="mindblown__streams-clip">
              <svg class="mindblown__streams" viewBox="0 0 100 60">
                <filter id="mindblown-warp" x="-20%" y="-20%" width="140%" height="140%">
                  <feTurbulence
                    class="mindblown__warp"
                    type="fractalNoise"
                    baseFrequency="0.03 0.08"
                    numOctaves="2"
                    seed="4"
                    result="noise"
                  ></feTurbulence>
                  <feDisplacementMap in="SourceGraphic" in2="noise" scale="7"></feDisplacementMap>
                </filter>
                <g filter="url(#mindblown-warp)">
                  {[7, 18, 29, 71, 82, 93].map((x, i) => (
                    <path
                      class={`mindblown__stream mindblown__stream--${i % 3}`}
                      d={`M${x} 64 C${x + 7} 50 ${x - 7} 38 ${x} 28 S${x + 7} 8 ${x} -4`}
                      style={`--mb-delay: ${-i * 0.37}s`}
                    ></path>
                  ))}
                </g>
              </svg>
            </div>
          </div>
          <div class="mindblown__layer mindblown__layer--lid">
            <div class="mindblown__lid-front" aria-hidden="true">
              <img
                class="mindblown__piece mindblown__piece--rest"
                src={restFace.src}
                alt=""
                {...img}
              />
              <img
                class="mindblown__piece mindblown__piece--shock"
                src={shockedFace.src}
                alt=""
                {...img}
              />
              <img
                class="mindblown__piece mindblown__piece--super"
                src={superFace.src}
                alt=""
                {...img}
              />
              <img
                class="mindblown__piece mindblown__piece--pain"
                src={painFace.src}
                alt=""
                {...img}
              />
            </div>
            <img
              class="mindblown__piece mindblown__piece--rest"
              src={restTop.src}
              alt=""
              {...img}
            />
            <img
              class="mindblown__piece mindblown__piece--shock"
              src={shockedTop.src}
              alt=""
              {...img}
            />
            <img
              class="mindblown__piece mindblown__piece--super"
              src={superTop.src}
              alt=""
              {...img}
            />
            <img
              class="mindblown__piece mindblown__piece--pain"
              src={painTop.src}
              alt=""
              {...img}
            />
          </div>
        </div>
        <svg class="mindblown__fx" viewBox="-160 -60 320 120" aria-hidden="true">
          <g class="mindblown__fx-group">
            {lines.map((l) => (
              <line
                class={`mindblown__fx-line mindblown__fx--${l.tone}`}
                x1={l.x1}
                y1={l.y1}
                x2={l.x2}
                y2={l.y2}
                stroke-width={l.w}
                pathLength="1"
              ></line>
            ))}
            {dots.map((d) => (
              <circle
                class={`mindblown__fx-dot mindblown__fx--${d.tone}`}
                cx={d.cx}
                cy={d.cy}
                r={d.r}
                style={`--mb-delay: ${d.d}s`}
              ></circle>
            ))}
            {sparks.map(([x, y, k]) => (
              <path
                class="mindblown__fx-spark mindblown__fx--2"
                d="M0 -6 L1.4 -1.4 L6 0 L1.4 1.4 L0 6 L-1.4 1.4 L-6 0 L-1.4 -1.4Z"
                transform={`translate(${x} ${y}) scale(${k})`}
              ></path>
            ))}
          </g>
        </svg>
        <button
          class="mindblown__brain-btn"
          type="button"
          aria-label="Show new thoughts"
          hidden
        ></button>
      </div>
      <div class="mindblown__note" aria-hidden="true">
        <svg viewBox="0 0 120 70">
          <path
            d="M100 64 C 82 30, 52 14, 10 10 M10 10 l17 10 M10 10 l18 -5"
            fill="none"
            stroke="currentcolor"
            stroke-width="3"
            stroke-linecap="round"
          ></path>
        </svg>
        <span>
          hi, I'm Dawid.
          <br />
          wanna see inside?
        </span>
      </div>
      <div class="mindblown__bubble" aria-hidden="true">
        ow.
      </div>
      <div class="mindblown__note-close" aria-hidden="true">
        <svg viewBox="0 0 120 70">
          <path
            d="M100 64 C 82 30, 52 14, 10 10 M10 10 l17 10 M10 10 l18 -5"
            fill="none"
            stroke="currentcolor"
            stroke-width="3"
            stroke-linecap="round"
          ></path>
        </svg>
        <span>
          seen enough?
          <br />
          <span data-close-verb>click</span> my head to close it.
        </span>
      </div>
    </div>

    <canvas class="mindblown__confetti" aria-hidden="true"></canvas>
    <div class="mindblown__cards"></div>

    <p class="mindblown__tip">
      click a thought.
      <br />
      drag it around.
      <br />
      poke my brain for more.
    </p>
  </section>

  <div class="mindblown__belt" aria-hidden="true">
    <div class="mindblown__belt-track">
      {belt.map((item) => (
        <>
          <span class="mindblown__belt-item">{item}</span>
          <span class="mindblown__belt-star">✶</span>
        </>
      ))}
    </div>
  </div>

  <div class="mindblown__pop" hidden>
    <div class="mindblown__pop-scrim"></div>
    <div
      class="mindblown__pop-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="mindblown-pop-title"
      data-lenis-prevent
    ></div>
  </div>
  <div class="mindblown__cursor" aria-hidden="true"></div>
</div>

<script>
  import { init } from "./mindblown";

  for (const root of document.querySelectorAll<HTMLElement>("[data-mindblown]")) init(root);
</script>
