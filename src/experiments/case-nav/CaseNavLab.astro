---
/**
 * Case-study navigation playground (previews only, never on production). Six ways to move between
 * case studies, next to today's "Next case study" block (the slot), picked with a switcher that
 * sits above the footer and at the top of the page. The pick is kept for the session, so it
 * follows you from one case study to the next. Behaviour: case-nav-lab.ts.
 *
 * 1 Split        previous and next side by side, full width, covers glitch on hover
 * 2 Pull through the next cover opens from a card to full bleed as you scroll to the end
 * 3 Index        every case study as a ruled list; the cover follows the pointer
 * 4 Filmstrip    every cover in a sideways strip, starting at the one you're reading
 * 5 Remote       a floating "channel" pill: ‹ 03 / 08 ›, arrow keys, a burst of static between
 * 6 Stories      segments along the top edge, one per case study, filling as you read
 *
 * Lab order (`all`, by `order`) drives every option, so 03 / 08 always means the same thing; the
 * curated `next` only feeds the current block. Without JavaScript the current block shows.
 *
 * Isolated experiment (CLAUDE.md rule 6): classes live under .case-nav-lab / .cn-* and read only
 * semantic site tokens.
 */
import { Image } from "astro:assets";
import { workHref, type Work } from "@/lib/work";

interface Props {
  entry: Work;
  all: Work[];
  next?: Work;
}

const { entry, all } = Astro.props;
const index = Math.max(
  0,
  all.findIndex((work) => work.id === entry.id),
);
const at = (offset: number) => all[(index + offset + all.length) % all.length]!;
const prev = at(-1);
const following = at(1);
const pad = (n: number) => String(n).padStart(2, "0");
const total = pad(all.length);

const OPTIONS = [
  { id: "current", name: "Current" },
  { id: "split", name: "Split" },
  { id: "pull", name: "Pull through" },
  { id: "index", name: "Index" },
  { id: "film", name: "Filmstrip" },
  { id: "remote", name: "Remote" },
  { id: "stories", name: "Stories" },
] as const;

const coverWidths = (work: Work, list: number[]) => list.filter((w) => w <= work.data.cover.width);
const meta = (work: Work) => [work.data.company, work.data.year].filter(Boolean).join(" · ");
---

<div class="case-nav-lab" data-case-nav-lab>
  <!-- 0 · Current: the NextProject block, also the no-JS state -->
  <div data-case-nav-option="current">
    <slot />
  </div>

  <!-- 1 · Split -->
  <nav class="cn-split" aria-label="More case studies" data-case-nav-option="split" hidden>
    {[
      { work: prev, side: "prev", label: "Previous case study" },
      { work: following, side: "next", label: "Next case study" },
    ].map(({ work, side, label }) => (
      <a
        class:list={["cn-split__side", `cn-split__side--${side}`]}
        href={workHref(work)}
        data-no-tear
      >
        <span class="cn-split__media">
          <Image
            class="cn-split__cover"
            src={work.data.cover}
            alt=""
            widths={coverWidths(work, [480, 800, 1200, 1600])}
            sizes="(min-width: 48em) 50vw, 100vw"
            loading="lazy"
          />
          {["a", "b"].map((slice) => (
            <Image
              class={`cn-split__cover cn-split__slice cn-split__slice--${slice}`}
              src={work.data.cover}
              alt=""
              aria-hidden="true"
              widths={coverWidths(work, [480, 800, 1200, 1600])}
              sizes="(min-width: 48em) 50vw, 100vw"
              loading="lazy"
            />
          ))}
        </span>
        <span class="cn-split__text">
          <span class="text-caption cn-split__label">
            {side === "prev" ? "← " : ""}
            {label}
            {side === "next" ? " →" : ""}
          </span>
          <span class="cn-split__title">{work.data.title}</span>
          <span class="text-small cn-split__meta">{meta(work)}</span>
        </span>
      </a>
    ))}
  </nav>

  <!-- 2 · Pull through -->
  <section class="cn-pull" aria-labelledby="cn-pull-title" data-case-nav-option="pull" hidden>
    <a class="cn-pull__stage" href={workHref(following)} data-no-tear>
      <span class="cn-pull__media">
        <Image
          class="cn-pull__cover"
          src={following.data.cover}
          alt=""
          widths={coverWidths(following, [800, 1200, 1600, 2400])}
          sizes="100vw"
          loading="lazy"
        />
      </span>
      <span class="cn-pull__text">
        <span class="text-caption">
          Next case study · {pad(all.indexOf(following) + 1)} / {total}
        </span>
        <span class="cn-pull__title" id="cn-pull-title">
          {following.data.title}
        </span>
        <span class="text-small">{meta(following)}</span>
      </span>
    </a>
  </section>

  <!-- 3 · Index with a cover that follows the pointer -->
  <nav class="cn-index" aria-labelledby="cn-index-title" data-case-nav-option="index" hidden>
    <div class="cn-index__inner">
      <h2 class="text-caption cn-index__heading" id="cn-index-title">
        All case studies
      </h2>
      <ol class="cn-index__list" role="list">
        {all.map((work, n) => (
          <li class="cn-index__row">
            <a
              class="cn-index__link"
              href={workHref(work)}
              aria-current={work.id === entry.id ? "page" : undefined}
              data-cn-preview={n}
              data-no-tear
            >
              <span class="text-caption cn-index__num">{pad(n + 1)}</span>
              <span class="cn-index__title">{work.data.title}</span>
              <span class="text-small cn-index__meta">
                {work.id === entry.id ? "Reading now" : meta(work)}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
    <div class="cn-index__preview" aria-hidden="true" data-cn-preview-frame>
      {all.map((work, n) => (
        <Image
          class="cn-index__preview-img"
          src={work.data.cover}
          alt=""
          widths={coverWidths(work, [480, 800])}
          sizes="22rem"
          loading="lazy"
          data-cn-preview-img={n}
        />
      ))}
    </div>
  </nav>

  <!-- 4 · Filmstrip -->
  <nav class="cn-film" aria-labelledby="cn-film-title" data-case-nav-option="film" hidden>
    <div class="cn-film__head">
      <h2 class="text-caption cn-film__heading" id="cn-film-title">
        Case studies · {pad(index + 1)} / {total}
      </h2>
      <div class="cn-film__arrows">
        {["prev", "next"].map((dir) => (
          <button
            class="cn-film__arrow"
            type="button"
            data-cn-film={dir}
            aria-label={dir === "prev" ? "Scroll back" : "Scroll on"}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={dir === "prev" ? "M19 12H5M11 6l-6 6 6 6" : "M5 12h14M13 6l6 6-6 6"} />
            </svg>
          </button>
        ))}
      </div>
    </div>
    <ol class="cn-film__track" role="list" data-cn-film-track>
      {all.map((work, n) => (
        <li class="cn-film__item" data-cn-film-current={work.id === entry.id ? "" : undefined}>
          <a
            class="cn-film__link"
            href={workHref(work)}
            aria-current={work.id === entry.id ? "page" : undefined}
            data-no-tear
          >
            <span class="cn-film__media">
              <Image
                class="cn-film__cover"
                src={work.data.cover}
                alt=""
                widths={coverWidths(work, [480, 800])}
                sizes="(min-width: 48em) 24rem, 75vw"
                loading="lazy"
              />
            </span>
            <span class="text-caption cn-film__num">
              {pad(n + 1)}
              {work.id === entry.id && " · Reading now"}
            </span>
            <span class="cn-film__title">{work.data.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <!-- 5 · Remote -->
  <nav class="cn-remote" aria-label="Case studies" data-case-nav-option="remote" hidden>
    {[
      { work: prev, dir: "prev", label: "Previous case study" },
      { work: following, dir: "next", label: "Next case study" },
    ].map(({ work, dir, label }) => (
      <a
        class:list={["cn-remote__button", `cn-remote__button--${dir}`]}
        href={workHref(work)}
        aria-label={`${label}: ${work.data.title}`}
        data-cn-remote={dir}
        data-no-tear
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={dir === "prev" ? "M15 5l-7 7 7 7" : "M9 5l7 7-7 7"} />
        </svg>
        <span class="cn-remote__peek" aria-hidden="true">
          <span class="text-caption">{label}</span>
          <span class="cn-remote__peek-title">{work.data.title}</span>
        </span>
      </a>
    ))}
    <p class="cn-remote__channel">
      <span class="text-caption cn-remote__ch">Ch</span>
      <span class="cn-remote__num">{pad(index + 1)}</span>
      <span class="cn-remote__total">/ {total}</span>
    </p>
  </nav>
  <div class="cn-static" aria-hidden="true" data-cn-static hidden></div>

  <!-- 6 · Stories -->
  <nav class="cn-stories" aria-label="Case studies" data-case-nav-option="stories" hidden>
    <ol class="cn-stories__bar" role="list">
      {all.map((work, n) => (
        <li
          class:list={[
            "cn-stories__segment",
            n < index && "cn-stories__segment--read",
            n === index && "cn-stories__segment--current",
          ]}
        >
          <a
            class="cn-stories__link"
            href={workHref(work)}
            aria-current={n === index ? "page" : undefined}
            data-no-tear
          >
            <span class="cn-stories__track">
              <span class="cn-stories__fill"></span>
            </span>
            <span class="cn-stories__tip">
              <span class="text-caption">{pad(n + 1)}</span>
              {work.data.company}
            </span>
          </a>
        </li>
      ))}
    </ol>
    <a class="cn-stories__next" href={workHref(following)} data-no-tear>
      <span class="text-caption">Up next</span>
      <span class="cn-stories__next-title">{following.data.company}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
  </nav>
</div>

{["top", "bottom"].map((where) => (
  <nav
    class:list={["case-nav-lab__switch", `case-nav-lab__switch--${where}`]}
    aria-label={where === "top" ? "Navigation playground" : "Navigation playground (end)"}
    data-case-nav-switch
    hidden={where === "top"}
  >
    <p class="text-caption case-nav-lab__switch-label">Navigation playground</p>
    <ul class="case-nav-lab__switch-list" role="list">
      {OPTIONS.map(({ id, name }, n) => (
        <li>
          <a
            class="case-nav-lab__switch-link"
            href={`?nav=${id}`}
            data-case-nav-pick={id}
            data-no-tear
          >
            <span class="case-nav-lab__switch-num">{n}</span> {name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
))}

<script>
  import "./case-nav-lab.ts";
</script>

<style>
  @layer components {
    /* ---------- Switcher ---------- */
    .case-nav-lab__switch {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-4);
      inline-size: 100%;
      max-inline-size: calc(var(--container-max) + 2 * var(--gutter));
      margin-inline: auto;
      padding: var(--space-4) var(--gutter);
    }

    .case-nav-lab__switch--bottom {
      border-block-start: var(--border-width) dashed var(--color-border-muted);
    }

    .case-nav-lab__switch-label {
      color: var(--color-text-muted);
    }

    .case-nav-lab__switch-list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      padding: 0;
    }

    .case-nav-lab__switch-link {
      --underline-size: 0%;

      display: inline-flex;
      gap: var(--space-1);
      align-items: baseline;
      padding: var(--space-1) var(--space-3);
      border: var(--border-width) solid var(--color-border-muted);
      border-radius: var(--radius-pill);
      font-size: var(--text-small);
      color: var(--color-text-muted);
      text-decoration: none;
    }

    .case-nav-lab__switch-link:hover {
      color: var(--color-text);
      border-color: var(--color-border);
    }

    .case-nav-lab__switch-link[aria-current="true"] {
      color: var(--color-on-inverse);
      background-color: var(--color-inverse-bg);
      border-color: var(--color-inverse-bg);
    }

    .case-nav-lab__switch-num {
      font-family: var(--font-mono);
      font-size: var(--text-caption);
      opacity: 0.6;
    }

    /* Options are display: grid / flex below, which would beat the hidden attribute. */
    .case-nav-lab > [hidden],
    .case-nav-lab__switch[hidden] {
      display: none;
    }

    /* Shared bits */
    :where(.case-nav-lab) a {
      --underline-size: 0%;

      color: inherit;
    }

    .case-nav-lab svg {
      inline-size: 1.125em;
      block-size: 1.125em;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .case-nav-lab img {
      display: block;
      inline-size: 100%;
      block-size: auto;
    }

    /* ---------- 1 · Split ---------- */
    .cn-split {
      display: grid;
      gap: var(--border-width);
      background-color: var(--color-border-subtle);
      border-block-start: var(--border-width) solid var(--color-border-subtle);
    }

    .cn-split__side {
      display: grid;
      align-content: start;
      gap: var(--space-6);
      padding-block-end: var(--space-section-sm);
      background-color: var(--color-bg);
    }

    .cn-split__media {
      position: relative;
      display: block;
      overflow: hidden;
    }

    .cn-split__cover {
      aspect-ratio: 3 / 2;
      object-fit: cover;
      transition: scale var(--duration-zoom) var(--ease-out-expo);
    }

    .cn-split__slice {
      position: absolute;
      inset: 0;
      opacity: 0;
      pointer-events: none;
    }

    .cn-split__side:hover .cn-split__cover:not(.cn-split__slice),
    .cn-split__side:focus-visible .cn-split__cover:not(.cn-split__slice) {
      scale: 1.03;
      animation: cn-jolt var(--duration-glitch) steps(1, end);
    }

    .cn-split__side:hover .cn-split__slice--a,
    .cn-split__side:focus-visible .cn-split__slice--a {
      animation: cn-tear-a var(--duration-glitch) steps(1, end);
    }

    .cn-split__side:hover .cn-split__slice--b,
    .cn-split__side:focus-visible .cn-split__slice--b {
      animation: cn-tear-b var(--duration-glitch) steps(1, end);
    }

    .cn-split__text {
      display: grid;
      gap: var(--space-2);
      padding-inline: var(--gutter);
      max-inline-size: 40rem;
    }

    .cn-split__side--next .cn-split__text {
      justify-self: end;
      text-align: end;
    }

    .cn-split__label,
    .cn-split__meta {
      color: var(--color-text-muted);
    }

    .cn-split__title {
      font: var(--weight-medium) var(--text-h3) / var(--leading-h3) var(--font-heading);
      letter-spacing: var(--tracking-h3);
      text-wrap: balance;
    }

    @media (width >= 48em) {
      .cn-split {
        grid-template-columns: 1fr 1fr;
      }
    }

    /* ---------- 2 · Pull through ---------- */
    .cn-pull {
      position: relative;
    }

    .cn-pull__stage {
      position: relative;
      display: grid;
      align-items: end;
      overflow: hidden;
      block-size: 100svh;
      color: var(--color-on-inverse);
    }

    .cn-pull__media,
    .cn-pull__text {
      grid-area: 1 / 1;
    }

    /* The inverse surface under a faded cover: dark in light mode, light in dark mode, so the
       title in the on-inverse colour always reads. */
    .cn-pull__media {
      display: block;
      block-size: 100%;
      background-color: var(--color-inverse-bg);
    }

    .case-nav-lab .cn-pull__cover {
      block-size: 100%;
      object-fit: cover;
      opacity: 0.35;
    }

    .cn-pull__text {
      position: relative;
      display: grid;
      gap: var(--space-4);
      justify-items: start;
      padding: var(--space-section-md) var(--gutter);
    }

    .cn-pull__text .text-caption,
    .cn-pull__text .text-small {
      color: var(--color-on-inverse-muted);
    }

    .cn-pull__title {
      max-inline-size: 18ch;
      font: var(--weight-medium) var(--text-h1) / var(--leading-h1) var(--font-heading);
      letter-spacing: var(--tracking-h1);
      text-wrap: balance;
    }

    /* With scroll timelines: the section is taller than the screen and the stage sticks, so the
       cover opens from a card in the middle to full bleed while you scroll through it, then the
       title rises in. */
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .cn-pull {
          block-size: 200svh;
          view-timeline-name: --cn-pull;
        }

        .cn-pull__stage {
          position: sticky;
          inset-block-start: 0;
        }

        .cn-pull__media {
          animation: cn-pull-open linear both;
          animation-timeline: --cn-pull;
          animation-range: contain 0% contain 60%;
        }

        .case-nav-lab .cn-pull__cover {
          animation: cn-pull-fade linear both;
          animation-timeline: --cn-pull;
          animation-range: contain 30% contain 70%;
        }

        .cn-pull__text {
          animation: cn-pull-text linear both;
          animation-timeline: --cn-pull;
          animation-range: contain 50% contain 85%;
        }
      }
    }

    @keyframes cn-pull-open {
      from {
        clip-path: inset(24% 26% 24% 26% round var(--radius-lg));
      }

      to {
        clip-path: inset(0 round 0);
      }
    }

    @keyframes cn-pull-fade {
      from {
        opacity: 1;
      }

      to {
        opacity: 0.35;
      }
    }

    @keyframes cn-pull-text {
      from {
        opacity: 0;
        translate: 0 var(--space-12);
      }

      to {
        opacity: 1;
        translate: 0;
      }
    }

    /* ---------- 3 · Index ---------- */
    .cn-index {
      position: relative;
      padding-block: var(--space-section-md);
      border-block-start: var(--border-width) solid var(--color-border-subtle);
    }

    .cn-index__inner {
      max-inline-size: calc(var(--container-max) + 2 * var(--gutter));
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .cn-index__heading {
      margin-block-end: var(--space-6);
      color: var(--color-text-muted);
    }

    .cn-index__list {
      padding: 0;
    }

    .cn-index__row {
      border-block-start: var(--border-width) solid var(--color-border-subtle);
    }

    .cn-index__row:last-child {
      border-block-end: var(--border-width) solid var(--color-border-subtle);
    }

    .cn-index__link {
      display: grid;
      grid-template-columns: var(--space-10) minmax(0, 1fr);
      gap: var(--space-1) var(--space-4);
      align-items: baseline;
      padding-block: var(--space-4);
      transition: opacity var(--duration-fast) var(--ease-standard);
    }

    .cn-index__num,
    .cn-index__meta {
      color: var(--color-text-muted);
    }

    .cn-index__title {
      font: var(--weight-medium) var(--text-h4) / var(--leading-h4) var(--font-heading);
      letter-spacing: var(--tracking-h4);
    }

    .cn-index__meta {
      grid-column: 2;
    }

    .cn-index__link[aria-current="page"] .cn-index__title {
      color: var(--color-text-muted);
    }

    .cn-index__link[aria-current="page"] .cn-index__meta::before {
      content: "● ";
    }

    /* Hovering one row quiets the rest, like the menu. */
    .cn-index__list:has(.cn-index__link:hover) .cn-index__link:not(:hover) {
      opacity: 0.35;
    }

    @media (width >= 62em) {
      .cn-index__link {
        grid-template-columns: var(--space-16) minmax(0, 1fr) 16rem;
        padding-block: var(--space-6);
      }

      .cn-index__title {
        font-size: var(--text-h3);
        line-height: var(--leading-h3);
        letter-spacing: var(--tracking-h3);
      }

      .cn-index__meta {
        grid-column: 3;
        text-align: end;
      }
    }

    /* The cover follows the pointer, beside it (case-nav-lab.ts sets --cn-x / --cn-y and
       data-active). */
    .cn-index__preview {
      position: fixed;
      inset-block-start: 0;
      inset-inline-start: 0;
      z-index: 1;
      display: none;
      inline-size: 22rem;
      overflow: hidden;
      border-radius: var(--radius-md);
      pointer-events: none;
      translate: var(--cn-x, 0) calc(var(--cn-y, 0px) - 50%);
      opacity: 0;
      scale: 0.9;
      transition:
        opacity var(--duration-fast) var(--ease-standard),
        scale var(--duration-link) var(--ease-out-expo);
    }

    @media (hover: hover) and (pointer: fine) {
      .cn-index__preview {
        display: grid;
      }
    }

    .cn-index__preview[data-active] {
      opacity: 1;
      scale: 1;
    }

    .case-nav-lab .cn-index__preview-img {
      grid-area: 1 / 1;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      visibility: hidden;
    }

    .case-nav-lab .cn-index__preview-img[data-shown] {
      visibility: visible;
      animation: cn-jolt var(--duration-glitch) steps(1, end);
    }

    /* ---------- 4 · Filmstrip ---------- */
    .cn-film {
      display: grid;
      gap: var(--space-6);
      padding-block: var(--space-section-md);
      border-block-start: var(--border-width) solid var(--color-border-subtle);
    }

    .cn-film__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      inline-size: 100%;
      max-inline-size: calc(var(--container-max) + 2 * var(--gutter));
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .cn-film__heading {
      color: var(--color-text-muted);
    }

    .cn-film__arrows {
      display: flex;
      gap: var(--space-2);
    }

    .cn-film__arrow {
      display: grid;
      place-items: center;
      inline-size: var(--space-12);
      block-size: var(--space-12);
      padding: 0;
      border: var(--border-width) solid var(--color-border-muted);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background: none;
      cursor: pointer;
    }

    .cn-film__arrow:hover {
