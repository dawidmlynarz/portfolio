---
/**
 * Experiment: the drop page's loot box with a frame that evolves by rarity. Outlines only, so the
 * content inside keeps its padding and stays usable; the "human curated" stamp stays as it is.
 *
 * approach "ladder": the outline itself climbs. Common is today's ink frame. Uncommon colours the
 *   border, Rare adds corner brackets inside it, Epic an inner hairline, Legendary a tier-coloured
 *   shadow and glow, Mythic a border of light that turns.
 * approach "corners": gaming-card corners. The tier icon sits on three corners (the stamp has the
 *   fourth), cut into the border. Higher tiers add the inner hairline, a second outline, the glow and
 *   the turning border.
 */
import Button from "@/components/ui/Button.astro";
import HumanStamp from "@/components/grist/HumanStamp.astro";
import RarityLabel from "@/components/grist/RarityLabel.astro";
import TileIcon from "@/components/grist/TileIcon.astro";
import IconAura from "./IconAura.astro";
import { RARITIES, type DropType, type Rarity } from "@/lib/grist";

interface Props {
  tier: Rarity;
  approach: "ladder" | "corners";
}

const { tier, approach } = Astro.props;
const rank = RARITIES.indexOf(tier);
const at = (from: Rarity) => rank >= RARITIES.indexOf(from);
const TYPE: Record<Rarity, DropType> = {
  common: "rule",
  uncommon: "prompt",
  rare: "checklist",
  epic: "spec",
  legendary: "skill",
  mythic: "workflow",
};
const corners = approach === "corners";
---

<section
  class:list={[
    "frame",
    `frame--${approach}`,
    `frame--${tier}`,
    {
      "frame--tinted": at("uncommon") || (corners && tier === "common"),
      "frame--brackets": !corners && at("rare"),
      "frame--inner": (corners && at("rare")) || (!corners && at("epic")),
      "frame--double": corners && at("epic"),
      "frame--glow": at("legendary"),
      "frame--turning": tier === "mythic",
    },
  ]}
  style={`--tier: var(--rarity-${tier}-icon)`}
  aria-label={`${tier} frame, ${approach}`}
>
  <HumanStamp size="sm" class="frame__stamp" />
  {corners &&
    (["start-start", "end-start", "end-end"] as const).map((corner) => (
      <span class:list={["frame__corner", `frame__corner--${corner}`]} aria-hidden="true">
        {at("mythic") ? <IconAura tier={tier} size="sm" /> : <TileIcon tier={tier} size="sm" />}
      </span>
    ))}
  <div class="frame__head">
    <h3 class="frame__title">The drop</h3>
    <p class="frame__type">
      <RarityLabel rarity={tier} type={TYPE[tier]} size="md" />
    </p>
  </div>
  <pre class="frame__text"><code>Use the design system's tokens for every colour, spacing, size, radius, shadow and font. Never write a raw value if a token exists. If no token fits, stop and tell me which value you need.</code></pre>
  <div class="frame__actions">
    <Button variant="secondary" size="sm" icon="sparkles">
      Copy for AI
    </Button>
    <Button variant="secondary" size="sm" icon="arrow-down">
      Download
    </Button>
  </div>
</section>

<style>
  @layer components {
    @property --frame-turn {
      syntax: "<angle>";
      inherits: false;
      initial-value: 0deg;
    }

    .frame {
      --line: calc(var(--border-width) * 2);
      --ink: var(--color-text);
      --tier-light: light-dark(
        var(--tier),
        color-mix(in oklab, var(--tier), var(--color-text) 45%)
      );

      position: relative;
      display: grid;
      gap: var(--space-6);
      padding: var(--space-6);
      border: var(--line) solid var(--ink);
      background-color: var(--color-bg);
      box-shadow: var(--space-2) var(--space-2) 0 var(--ink);
    }

    .frame--tinted {
      border-color: var(--tier);
    }

    /* Corner brackets inside the frame, on three corners (the stamp has the fourth). */
    .frame--brackets::before {
      --arm: var(--space-4);
      --bar: var(--border-width);

      content: "";
      position: absolute;
      inset: var(--space-1);
      pointer-events: none;
      background:
        linear-gradient(var(--tier) 0 0) top left / var(--arm) var(--bar),
        linear-gradient(var(--tier) 0 0) top left / var(--bar) var(--arm),
        linear-gradient(var(--tier) 0 0) bottom left / var(--arm) var(--bar),
        linear-gradient(var(--tier) 0 0) bottom left / var(--bar) var(--arm),
        linear-gradient(var(--tier) 0 0) bottom right / var(--arm) var(--bar),
        linear-gradient(var(--tier) 0 0) bottom right / var(--bar) var(--arm);
      background-repeat: no-repeat;
    }

    /* A hairline inside the padding, half the tier's strength. */
    .frame--inner::after {
      content: "";
      position: absolute;
      inset: var(--space-2);
      border: var(--border-width) solid color-mix(in oklab, var(--tier) 30%, transparent);
      pointer-events: none;
    }

    /* A second outline outside the first. */
    .frame--double {
      outline: var(--border-width) solid color-mix(in oklab, var(--tier) 45%, transparent);
      outline-offset: var(--space-1);
    }

    .frame--glow {
      box-shadow:
        var(--space-2) var(--space-2) 0 var(--tier),
        0 0 var(--space-4)
          light-dark(
            color-mix(in oklab, var(--tier) 10%, transparent),
            color-mix(in oklab, var(--tier) 20%, transparent)
          );
    }

    /* Mythic: the border is a band of light that travels round. */
    .frame--turning {
      border-color: transparent;
      background:
        linear-gradient(var(--color-bg) 0 0) padding-box,
        conic-gradient(
            from var(--frame-turn),
            var(--tier),
            var(--tier-light) 8%,
            var(--tier) 16%,
            var(--tier) 100%
          )
          border-box;
    }

    .frame__stamp {
      position: absolute;
      inset-block-start: 0;
      inset-inline-end: var(--space-6);
      z-index: 1;
      translate: 0 -50%;
    }

    /* Corner icons sit on the corner point, on a patch of page colour that cuts the border. */
    .frame__corner {
      position: absolute;
      z-index: 1;
      display: grid;
      place-items: center;
      padding: var(--space-1);
      font-size: var(--text-small);
      background-color: var(--color-bg);
      translate: -50% -50%;
    }

    .frame__corner--start-start {
      inset-block-start: calc(-1 * var(--line) / 2);
      inset-inline-start: calc(-1 * var(--line) / 2);
    }

    .frame__corner--end-start {
      inset-block-end: calc(-1 * var(--line) / 2);
      inset-inline-start: calc(-1 * var(--line) / 2);
      translate: -50% 50%;
    }

    .frame__corner--end-end {
      inset-block-end: calc(-1 * var(--line) / 2);
      inset-inline-end: calc(-1 * var(--line) / 2);
      translate: 50% 50%;
    }

    .frame__head {
      display: grid;
      gap: var(--space-2);
    }

    .frame__title {
      padding-inline-end: calc(var(--space-24) + var(--space-12));
      font-size: var(--text-h3);
      line-height: var(--leading-h3);
      letter-spacing: var(--tracking-h3);
    }

    .frame__type {
      display: flex;
      align-items: center;
    }

    .frame__text {
      margin: 0;
      padding: var(--space-4);
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
      font-size: var(--text-small);
      line-height: var(--leading-small);
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      background-color: var(--color-bg-subtle);
    }

    .frame__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    @media (prefers-reduced-motion: no-preference) {
      .frame--turning {
        animation: frame-turn 8s linear infinite;
      }
    }

    @keyframes frame-turn {
      to {
        --frame-turn: 1turn;
      }
    }

    @media (width >= 48em) {
      .frame {
        padding: var(--space-8);
      }

      .frame__stamp {
        inset-inline-end: var(--space-8);
      }
    }
  }
</style>
