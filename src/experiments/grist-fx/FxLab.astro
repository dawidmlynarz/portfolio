---
/**
 * Experiment: the Grist effects playground. Three parts, each following the site theme (flip it with
 * the switch in the header):
 *   1. Rarity icon auras (IconAura), with an intensity switch.
 *   2. Card effects from react-cards-opening (vendor/rco-effects, MIT), played on real drop cards:
 *      pick an effect, or the tier mix, and hover, focus or press Play. Also a drop-day reveal.
 *   3. Drop frames by rarity (FrameMock), two approaches.
 * Everything here is complete without JS: the auras and frames are CSS, and the effects only add.
 */
import { getCollection } from "astro:content";
import DropCard from "@/components/grist/DropCard.astro";
import IconAura from "./IconAura.astro";
import FrameMock from "./FrameMock.astro";
import { RARITIES, RARITY_LABELS, type Rarity } from "@/lib/grist";
import { dropDay } from "@/lib/drops";

const all = await getCollection("grist");
const cards = RARITIES.map((tier) => ({ tier, drop: all.find((d) => d.data.rarity === tier)! }));

const EFFECTS = ["embers", "stardust", "sparks", "flames", "aurora", "beams"] as const;
const LABEL: Record<(typeof EFFECTS)[number], string> = {
  embers: "Embers",
  stardust: "Stardust",
  sparks: "Sparks",
  flames: "Flame",
  aurora: "Aurora",
  beams: "Beams",
};
/** My sweet spot: nothing on Common, one quiet effect in the middle, two from Legendary up. */
const MIX: Record<Rarity, readonly string[]> = {
  common: [],
  uncommon: ["stardust"],
  rare: ["sparks"],
  epic: ["stardust", "aurora"],
  legendary: ["embers", "beams"],
  mythic: ["flames", "aurora", "embers"],
};
---

<div class="fx-lab" data-aura="subtle">
  <section class="fx-lab__part" aria-labelledby="fx-icons">
    <header class="fx-lab__head">
      <h2 id="fx-icons">1. Rarity icon auras</h2>
      <p class="fx-lab__muted">
        CSS only. Common stays plain, Uncommon breathes, Rare and Epic twinkle (Epic adds an
        orbiting spark), Legendary lets off embers and keeps its shine, Mythic gets a turning halo.
        Reduced motion keeps a still glow.
      </p>
      <fieldset class="fx-lab__switch">
        <legend class="text-caption">Intensity</legend>
        {["off", "subtle", "lively"].map((value) => (
          <label class="fx-lab__option">
            <input type="radio" name="fx-aura" value={value} checked={value === "subtle"} />
            {value[0]!.toUpperCase() + value.slice(1)}
          </label>
        ))}
      </fieldset>
    </header>
    <ul class="fx-lab__tiers" role="list">
      {RARITIES.map((tier) => (
        <li class="fx-lab__tier">
          <span class="fx-lab__big">
            <IconAura tier={tier} size="lg" />
          </span>
          <span class="fx-lab__inline">
            <IconAura tier={tier} size="md" />
            <span class:list={["fx-lab__name", `rarity-label--${tier}`]}>
              {RARITY_LABELS[tier]}
            </span>
          </span>
          <span class="fx-lab__inline fx-lab__muted">
            <IconAura tier={tier} size="sm" /> small
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="fx-lab__part" aria-labelledby="fx-cards">
    <header class="fx-lab__head">
      <h2 id="fx-cards">2. Card effects</h2>
      <p class="fx-lab__muted">
        From react-cards-opening (MIT): the effects run on one canvas with GSAP, which the site
        already uses, so I copied the framework-free part in and left React out. Hover or focus a
        card, or press Play. Lights add up on dark and are painted on light. Reduced motion plays
        nothing.
      </p>
      <fieldset class="fx-lab__switch">
        <legend class="text-caption">Effect</legend>
        <label class="fx-lab__option">
          <input type="radio" name="fx-effect" value="mix" checked /> Tier mix
        </label>
        {EFFECTS.map((name) => (
          <label class="fx-lab__option">
            <input type="radio" name="fx-effect" value={name} />
            {LABEL[name]}
          </label>
        ))}
      </fieldset>
      <p class="fx-lab__muted text-small">
        Tier mix: Common nothing · Uncommon Stardust · Rare Sparks · Epic Stardust and Aurora ·
        Legendary Embers and Beams · Mythic Flame, Aurora and Embers.
      </p>
      <div class="fx-lab__buttons">
        <button type="button" class="fx-lab__button" data-fx-play-all>
          Play all
        </button>
        <button type="button" class="fx-lab__button" data-fx-reveal-all>
          Drop-day reveal
        </button>
      </div>
    </header>
    <ul class="fx-lab__cards" role="list">
      {cards.map(({ tier, drop }) => (
        <li class="fx-card" data-tier={tier} data-mix={MIX[tier].join(" ")}>
          <span class="fx-card__tone" style={`color: var(--rarity-${tier}-icon)`} hidden />
          <div class="fx-card__face fx-card__face--locked" aria-hidden="true">
            <DropCard
              locked={{
                type: drop.data.drop,
                rarity: tier,
                date: dropDay(drop.data.season, drop.data.slot),
              }}
            />
          </div>
          <div class="fx-card__face fx-card__face--open">
            <DropCard drop={drop} />
          </div>
          <button type="button" class="fx-lab__button fx-card__play">
            Play on {RARITY_LABELS[tier]}
          </button>
        </li>
      ))}
    </ul>
  </section>

  <section class="fx-lab__part" aria-labelledby="fx-frames">
    <header class="fx-lab__head">
      <h2 id="fx-frames">3. Drop frames</h2>
      <p class="fx-lab__muted">
        Outlines only, so the content keeps its room. A: the outline climbs with the tier. B:
        gaming-card corners with the tier icon, cut into the border; the stamp keeps the fourth
        corner.
      </p>
    </header>
    <div class="fx-lab__frames">
      {(["ladder", "corners"] as const).map((approach) => (
        <div class="fx-lab__column">
          <h3 class="fx-lab__column-title">
            {approach === "ladder" ? "A · Outline ladder" : "B · Card corners"}
          </h3>
          {RARITIES.map((tier) => (
            <div class="fx-lab__frame">
              <p class="text-caption fx-lab__muted">{RARITY_LABELS[tier]}</p>
              <FrameMock tier={tier} approach={approach} />
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>
</div>

<script>
  import "./vendor/rco-effects/styles.css";
  import { playEffects, clearEffects, type EffectName } from "./vendor/rco-effects/effects";

  const lab = document.querySelector<HTMLElement>(".fx-lab");

  // Intensity switch for the auras.
  lab?.querySelectorAll<HTMLInputElement>('input[name="fx-aura"]').forEach((input) =>
    input.addEventListener("change", () => {
      lab.dataset.aura = input.value;
    }),
  );

  /** The tier colour as a hex, read off a hidden element (the effects only take plain hex). */
  function toneOf(card: HTMLElement) {
    const probe = card.querySelector<HTMLElement>(".fx-card__tone");
    if (!probe) return "#ffffff";
    probe.hidden = false;
    const rgb = getComputedStyle(probe).color.match(/\d+/g)?.map(Number) ?? [255, 255, 255];
    probe.hidden = true;
    return `#${rgb
      .slice(0, 3)
      .map((n) => n.toString(16).padStart(2, "0"))
      .join("")}`;
  }

  /** Dark page if the body's background is dark: lights add up there, and are painted on light. */
  function isDark() {
    const rgb = getComputedStyle(document.body).backgroundColor.match(/\d+/g)?.map(Number) ?? [255];
    return (rgb[0]! + rgb[1]! + rgb[2]!) / 3 < 128;
  }

  function chosen(card: HTMLElement): EffectName[] {
    const pick = lab?.querySelector<HTMLInputElement>('input[name="fx-effect"]:checked')?.value;
    const names = pick === "mix" || !pick ? (card.dataset.mix ?? "").split(" ") : [pick];
    return names.filter(Boolean) as EffectName[];
  }

  /** A fresh layer each time, so a theme switch gets the right blend (a layer keeps its first). */
  function play(card: HTMLElement) {
    const names = chosen(card);
    if (!names.length) return;
    const old = card.querySelector<HTMLElement>(".rco-fx-layer");
    if (old) {
      clearEffects(old);
      old.remove();
    }
    const layer = document.createElement("div");
    layer.className = "rco-fx-layer fx-card__layer";
    layer.setAttribute("aria-hidden", "true");
    // Inline, because the vendored stylesheet is unlayered and would beat a layered rule.
    layer.style.inset = "calc(-1 * var(--space-12))";
    card.prepend(layer);
    const face = card.querySelector<HTMLElement>(".fx-card__face--open") ?? card;
    const box = face.getBoundingClientRect();
    playEffects(layer, names, {
      at: face,
      size: Math.min(box.width, 360),
      ratio: box.height / box.width,
      tone: toneOf(card),
      blend: isDark() ? "add" : "normal",
    });
  }

  const cards = [...document.querySelectorAll<HTMLElement>(".fx-card")];
  const busy = new WeakMap<HTMLElement, number>();
  for (const card of cards) {
    // Hover plays at most once every few seconds, so moving across the grid doesn't stack shows.
    const onHover = () => {
      const last = busy.get(card) ?? 0;
      if (Date.now() - last < 3000) return;
      busy.set(card, Date.now());
      play(card);
    };
    card.addEventListener("pointerenter", onHover);
    card.addEventListener("focusin", onHover);
    card.querySelector(".fx-card__play")?.addEventListener("click", () => play(card));
  }

  lab
    ?.querySelector("[data-fx-play-all]")
    ?.addEventListener("click", () =>
      cards.forEach((card, i) => setTimeout(() => play(card), i * 250)),
    );

  // Drop day: each card starts locked, then turns into the drop with its tier's show.
  lab?.querySelector("[data-fx-reveal-all]")?.addEventListener("click", () => {
    cards.forEach((card) => card.classList.add("fx-card--locked"));
    cards.forEach((card, i) =>
      setTimeout(
        () => {
          card.classList.remove("fx-card--locked");
          play(card);
        },
        700 + i * 600,
      ),
    );
  });
</script>

<style>
  @layer components {
    .fx-lab {
      display: grid;
      gap: var(--space-section-md);
    }

    .fx-lab__part {
      display: grid;
      gap: var(--space-8);
    }

    .fx-lab__head {
      display: grid;
      gap: var(--space-3);
      max-inline-size: var(--measure);
    }

    .fx-lab__muted {
      color: var(--color-text-muted);
    }

    .fx-lab__switch {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
      align-items: center;
      margin: 0;
      padding: 0;
      border: 0;
    }

    .fx-lab__switch legend {
      float: inline-start;
      margin-inline-end: var(--space-2);
      color: var(--color-text-muted);
    }

    .fx-lab__option {
      display: inline-flex;
      gap: var(--space-1);
      align-items: center;
    }

    .fx-lab__option input {
      accent-color: var(--color-text);
    }

    .fx-lab__buttons {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .fx-lab__button {
      padding: var(--space-2) var(--space-4);
      border: var(--border-width) solid var(--color-text);
      border-radius: var(--radius-pill);
      font: inherit;
      font-size: var(--text-small);
      color: var(--color-text);
      background: none;
      cursor: pointer;
    }

    .fx-lab__button:hover {
      background-color: var(--color-bg-subtle);
    }

    .fx-lab__button:focus-visible {
      outline: calc(var(--border-width) * 2) solid var(--color-focus);
      outline-offset: var(--space-1);
    }

    .fx-lab__tiers {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
      gap: var(--space-8) var(--space-6);
      margin: 0;
      padding: 0;
    }

    .fx-lab__tier {
      display: grid;
      gap: var(--space-4);
      justify-items: start;
      padding: var(--space-6);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-lg);
    }

    .fx-lab__big {
      display: grid;
      place-items: center;
      inline-size: 100%;
      padding-block: var(--space-6);
    }

    .fx-lab__inline {
      display: inline-flex;
      gap: var(--space-2);
      align-items: center;
      font-size: var(--text-small);
      line-height: var(--leading-small);
    }

    .fx-lab__name {
      font-weight: var(--weight-semibold);
      color: var(--tier-text);
    }

    .fx-lab__name.rarity-label--common {
      --tier-text: var(--rarity-common-tile-text);
    }

    .fx-lab__name.rarity-label--uncommon {
      --tier-text: var(--rarity-uncommon-tile-text);
    }

    .fx-lab__name.rarity-label--rare {
      --tier-text: var(--rarity-rare-tile-text);
    }

    .fx-lab__name.rarity-label--epic {
      --tier-text: var(--rarity-epic-tile-text);
    }

    .fx-lab__name.rarity-label--legendary {
      --tier-text: var(--rarity-legendary-tile-text);
    }

    .fx-lab__name.rarity-label--mythic {
      --tier-text: var(--rarity-mythic-tile-text);
    }

    .fx-lab__cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
      gap: var(--space-12) var(--space-6);
      margin: 0;
      padding: 0;
    }

    .fx-card {
      position: relative;
      display: grid;
      gap: var(--space-3);
      justify-items: start;
    }

    /* The effects spill a little past the card, under it, and never catch the pointer. */
    .fx-card :global(.fx-card__layer) {
      z-index: 0;
    }

    .fx-card__face {
      position: relative;
      z-index: 1;
      grid-area: 1 / 1;
      inline-size: 100%;
      transition:
        opacity var(--duration-reveal) var(--ease-standard),
        scale var(--duration-reveal) var(--ease-out-expo);
    }

    .fx-card__face--locked {
      opacity: 0;
      pointer-events: none;
    }

    .fx-card--locked .fx-card__face--locked {
      opacity: 1;
    }

    .fx-card--locked .fx-card__face--open {
      opacity: 0;
      scale: 0.96;
    }

    .fx-card__play {
      position: relative;
      align-self: start;
      z-index: 1;
    }

    .fx-lab__frames {
      display: grid;
      gap: var(--space-section-sm) var(--space-12);
    }

    .fx-lab__column {
      display: grid;
      gap: var(--space-16);
      align-content: start;
    }

    .fx-lab__column-title {
      font-size: var(--text-h3);
      line-height: var(--leading-h3);
    }

    .fx-lab__frame {
      display: grid;
      gap: var(--space-6);
    }

    @media (width >= 80em) {
      .fx-lab__frames {
        grid-template-columns: 1fr 1fr;
      }
    }
  }
</style>
