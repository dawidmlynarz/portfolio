---
/**
 * Experiment: a rarity tile icon with an energy aura that grows with the tier. CSS only, no JS.
 *   Common: nothing · Uncommon: a soft glow that breathes · Rare: glow + two twinkles
 *   Epic: glow + three twinkles + a spark orbiting · Legendary: warm glow + twinkles + embers rising
 *   (the icon keeps its shine) · Mythic: a turning halo ring, four twinkles and embers.
 * Light mode paints the glow thinner and the sparkles in the tier colour, so they read on white.
 * Reduced motion keeps a still glow and drops the sparkles. Intensity comes from the parent:
 * [data-aura="off" | "subtle" | "lively"].
 */
import TileIcon from "@/components/grist/TileIcon.astro";
import type { RarityIconTier } from "@/components/grist/tile-icons";

interface Props {
  tier: RarityIconTier;
  size?: "sm" | "md" | "lg";
}

const { tier, size = "md" } = Astro.props;

// Where each twinkle sits around the icon (% of the icon box) and when it starts.
const SPARKS = [
  { x: 92, y: 8, d: 0 },
  { x: 4, y: 78, d: 1.1 },
  { x: 96, y: 70, d: 2 },
  { x: 10, y: 12, d: 0.6 },
];
const COUNT: Record<RarityIconTier, { sparks: number; embers: number; orbit: boolean }> = {
  common: { sparks: 0, embers: 0, orbit: false },
  uncommon: { sparks: 0, embers: 0, orbit: false },
  rare: { sparks: 1, embers: 0, orbit: false },
  epic: { sparks: 2, embers: 0, orbit: true },
  legendary: { sparks: 2, embers: 1, orbit: false },
  mythic: { sparks: 3, embers: 2, orbit: true },
};
const EMBERS = [
  { x: 30, d: 0 },
  { x: 68, d: 1.3 },
  { x: 50, d: 2.4 },
];
const { sparks, embers, orbit } = COUNT[tier];
---

<span
  class:list={["aura", `aura--${tier}`, `aura--${size}`]}
  style={`--tier: var(--rarity-${tier}-icon)`}
>
  <TileIcon tier={tier} size={size} />
  {orbit && <span class="aura__orbit" aria-hidden="true" />}
  {SPARKS.slice(0, sparks).map(({ x, y, d }) => (
    <span class="aura__spark" style={`--x: ${x}%; --y: ${y}%; --d: ${d}s`} aria-hidden="true" />
  ))}
  {EMBERS.slice(0, embers).map(({ x, d }) => (
    <span class="aura__ember" style={`--x: ${x}%; --d: ${d}s`} aria-hidden="true" />
  ))}
</span>

<style>
  @layer components {
    .aura {
      --glow: 0;
      --boost: 1;
      --tier-light: light-dark(
        var(--tier),
        color-mix(in oklab, var(--tier), var(--color-text) 55%)
      );

      position: relative;
      display: inline-grid;
      place-items: center;
      isolation: isolate;
    }

    :global([data-aura="lively"]) .aura {
      --boost: 1.3;
    }

    /* The glow: a soft disc of the tier colour behind the icon, thinner on a light page. */
    .aura::before {
      content: "";
      position: absolute;
      inset: -25%;
      z-index: -1;
      border-radius: 50%;
      background: radial-gradient(
        closest-side,
        light-dark(
          color-mix(in oklab, var(--tier) 28%, transparent),
          color-mix(in oklab, var(--tier) 55%, transparent)
        ),
        transparent
      );
      opacity: calc(var(--glow) * var(--boost));
    }

    .aura--uncommon {
      --glow: 0.3;
    }

    .aura--rare {
      --glow: 0.35;
    }

    .aura--epic {
      --glow: 0.4;
    }

    .aura--legendary {
      --glow: 0.45;
    }

    .aura--mythic {
      --glow: 0.5;
    }

    .aura__spark,
    .aura__ember,
    .aura__orbit {
      position: absolute;
      pointer-events: none;
    }

    /* A four-pointed star. */
    .aura__spark {
      inset-block-start: var(--y);
      inset-inline-start: var(--x);
      inline-size: 20%;
      aspect-ratio: 1;
      translate: -50% -50%;
      background-color: var(--tier-light);
      clip-path: polygon(50% 0, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0 50%, 40% 40%);
      scale: 0;
    }

    .aura__ember {
      inset-block-end: 30%;
      inset-inline-start: var(--x);
      inline-size: 7%;
      aspect-ratio: 1;
      border-radius: 50%;
      background-color: var(--tier-light);
      box-shadow: 0 0 0.15em var(--tier);
      opacity: 0;
    }

    /* Epic: one spark on a slow orbit. Mythic: a thin ring of the tier colour, turning. */
    .aura__orbit {
      inset: -12%;
      border-radius: 50%;
    }

    .aura--epic .aura__orbit::after {
      content: "";
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 50%;
      inline-size: 8%;
      aspect-ratio: 1;
      border-radius: 50%;
      translate: -50% -50%;
      background-color: var(--tier-light);
      box-shadow: 0 0 0.15em var(--tier);
    }

    .aura--mythic .aura__orbit {
      background: conic-gradient(
        var(--tier),
        transparent 35%,
        var(--tier-light) 55%,
        transparent 80%,
        var(--tier)
      );
      mask: radial-gradient(
        closest-side,
        transparent 86%,
        var(--color-text) 88%,
        var(--color-text) 96%,
        transparent 98%
      );
      opacity: calc(0.4 * var(--boost));
    }

    :global([data-aura="off"]) .aura::before,
    :global([data-aura="off"]) .aura__spark,
    :global([data-aura="off"]) .aura__ember,
    :global([data-aura="off"]) .aura__orbit {
      display: none;
    }

    @media (prefers-reduced-motion: no-preference) {
      .aura::before {
        animation: aura-breathe 3.2s ease-in-out infinite;
      }

      .aura__spark {
        animation: aura-twinkle 4s var(--d) ease-in-out infinite;
      }

      .aura__ember {
        animation: aura-rise 3.6s var(--d) ease-out infinite;
      }

      .aura__orbit {
        animation: aura-turn 6s linear infinite;
      }

      .aura--mythic .aura__orbit {
        animation-duration: 4s;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .aura__spark,
      .aura__ember {
        display: none;
      }
    }

    @keyframes aura-breathe {
      0%,
      100% {
        opacity: calc(var(--glow) * var(--boost) * 0.6);
        scale: 0.92;
      }

      50% {
        opacity: calc(var(--glow) * var(--boost));
        scale: 1.06;
      }
    }

    /* Each twinkle shows for a moment, then rests for most of the loop. */
    @keyframes aura-twinkle {
      0%,
      40%,
      100% {
        scale: 0;
        rotate: 0deg;
      }

      20% {
        scale: 1;
        rotate: 45deg;
      }
    }

    @keyframes aura-rise {
      0% {
        opacity: 0;
        translate: 0 0;
      }

      20% {
        opacity: 1;
      }

      100% {
        opacity: 0;
        translate: 20% -160%;
      }
    }

    @keyframes aura-turn {
      to {
        rotate: 1turn;
      }
    }
  }
</style>
