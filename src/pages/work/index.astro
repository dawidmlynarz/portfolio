---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Section from "@/components/layout/Section.astro";
import Container from "@/components/layout/Container.astro";
import WorkGrid from "@/components/blocks/WorkGrid.astro";
import HeroBackdrop from "@/components/blocks/HeroBackdrop.astro";
import { getListedWork, hasPage, workHref } from "@/lib/work";
import { breadcrumbs, personId, websiteId } from "@/lib/schema";

const work = await getListedWork();

const site = Astro.site!;
const url = new URL("/work", site).href;
// Only public case studies: locked ones are noindex, so they stay out of the list.
const listed = work.filter((entry) => hasPage(entry) && !entry.data.protected);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${url}#page`,
      url,
      name: "Case studies",
      isPartOf: { "@id": websiteId(site) },
      author: { "@id": personId(site) },
      mainEntity: {
        "@type": "ItemList",
        itemListElement: listed.map((entry, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: entry.data.title,
          url: new URL(workHref(entry), site).href,
        })),
      },
    },
    breadcrumbs(site, [["Work", "/work"]]),
  ],
};
---

<SiteLayout
  jsonLd={jsonLd}
  title="Case studies: design systems, AI and UX"
  description="Case studies by Dawid Młynarz: AI products, design systems, conversion optimisation and product design for Newsweek, NerdWallet, BeatStars, Google and more."
>
  <Section space="md" class="hero-backdrop-host" aria-labelledby="work-title">
    <HeroBackdrop />
    <Container class="work-page">
      <div class="work-page__head">
        <p class="text-caption work-page__muted">Selected work 2020 – 2025</p>
        <h1 id="work-title" data-reveal="lines">
          Case studies <span class="work-page__muted">told by their outcomes.</span>
        </h1>
      </div>
      <WorkGrid entries={work} layout="index" headingLevel={2} eager={2} />
    </Container>
  </Section>
</SiteLayout>

<style>
  @layer components {
    .work-page {
      display: grid;
      gap: var(--space-section-md);
    }

    .work-page__head {
      display: grid;
      gap: var(--space-4);
    }

    .work-page__muted {
      color: var(--color-text-muted);
    }
  }
</style>
