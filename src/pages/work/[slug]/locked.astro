---
/**
 * The locked state of a password-protected case study (protected: true). On build it replaces
 * /work/<slug>, and the full page moves into the Pages Function (tooling/protected-work.mjs).
 * It is the password panel, centred on the first screen over the hero grain. None of the case
 * study's content is in this page.
 */
import SiteLayout from "@/layouts/SiteLayout.astro";
import HeroBackdrop from "@/components/blocks/HeroBackdrop.astro";
import LockPanel from "@/components/blocks/LockPanel.astro";
import { getProtectedWork, workHref, type Work } from "@/lib/work";

export async function getStaticPaths() {
  return (await getProtectedWork()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: Work;
}

const { entry } = Astro.props;
const { data } = entry;
const href = workHref(entry);
---

<SiteLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  type="article"
  canonicalPath={href}
  noindex
>
  <div class="locked hero-backdrop-host">
    <HeroBackdrop />
    <LockPanel action={href} company={data.company} />
  </div>
</SiteLayout>

<style>
  @layer components {
    /* One screen with the panel in the middle; the footer follows. */
    .locked {
      display: grid;
      place-items: center;
      min-block-size: calc(100svh - var(--nav-clearance));
      padding: var(--space-section-sm) var(--space-4);
    }
  }
</style>
