---
import { getEntry, render } from "astro:content";
import CaseStudyLayout from "@/layouts/CaseStudyLayout.astro";
import Figure from "@/components/ui/Figure.astro";
import Video from "@/components/ui/Video.astro";
import BeforeAfter from "@/components/ui/BeforeAfter.astro";
import ImageGrid from "@/components/content/ImageGrid.astro";
import Metrics from "@/components/content/Metrics.astro";
import Callout from "@/components/content/Callout.astro";
import Quote from "@/components/content/Quote.astro";
import { getPagedWork, hasPage, type Work } from "@/lib/work";

export async function getStaticPaths() {
  const visible = await getPagedWork();
  return visible.map((entry, index) => ({
    params: { slug: entry.id },
    // The case studies after this one, in order (wrapping round), for "Next up".
    props: { entry, following: [...visible.slice(index + 1), ...visible.slice(0, index)] },
  }));
}

/** Case studies in "Next up". */
const NEXT_UP = 3;

interface Props {
  entry: Work;
  following: Work[];
}

const { entry, following } = Astro.props;
const { Content, headings } = await render(entry);

// The curated "next" leads when it has a page; the rest follow in order.
const curated = entry.data.next ? await getEntry(entry.data.next) : undefined;
const nextUp = [...(curated && hasPage(curated) ? [curated] : []), ...following]
  .filter((work, i, list) => work.id !== entry.id && list.findIndex((w) => w.id === work.id) === i)
  .slice(0, NEXT_UP);

// MDX files use these without importing them.
const components = { Figure, Video, BeforeAfter, ImageGrid, Metrics, Callout, Quote };
---

<CaseStudyLayout entry={entry} nextUp={nextUp} headings={headings}>
  <Content components={components} />
</CaseStudyLayout>
