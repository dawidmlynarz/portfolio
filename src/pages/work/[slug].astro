---
import { getEntry, render } from "astro:content";
import CaseStudyLayout from "@/layouts/CaseStudyLayout.astro";
import Figure from "@/components/ui/Figure.astro";
import ImageGrid from "@/components/content/ImageGrid.astro";
import Metrics from "@/components/content/Metrics.astro";
import Callout from "@/components/content/Callout.astro";
import Quote from "@/components/content/Quote.astro";
import { getPublishedWork, type Work } from "@/lib/work";

export async function getStaticPaths() {
  const published = await getPublishedWork();
  return published.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, fallbackNext: published[(index + 1) % published.length] },
  }));
}

interface Props {
  entry: Work;
  fallbackNext?: Work;
}

const { entry, fallbackNext } = Astro.props;
const { Content } = await render(entry);

// Prefer the curated "next" link; fall back to the next published case study.
const curated = entry.data.next ? await getEntry(entry.data.next) : undefined;
const nextCandidate = curated && !curated.data.draft ? curated : fallbackNext;
const next = nextCandidate && nextCandidate.id !== entry.id ? nextCandidate : undefined;

// MDX files use these without importing them.
const components = { Figure, ImageGrid, Metrics, Callout, Quote };
---

<CaseStudyLayout entry={entry} next={next}>
  <Content components={components} />
</CaseStudyLayout>
