---
import { getEntry, render } from "astro:content";
import CaseStudyLayout from "@/layouts/CaseStudyLayout.astro";
import Figure from "@/components/ui/Figure.astro";
import Video from "@/components/ui/Video.astro";
import VideoTabs from "@/components/content/VideoTabs.astro";
import BeforeAfter from "@/components/ui/BeforeAfter.astro";
import ImageGrid from "@/components/content/ImageGrid.astro";
import Metrics from "@/components/content/Metrics.astro";
import Callout from "@/components/content/Callout.astro";
import Quote from "@/components/content/Quote.astro";
import { getBuiltPages, getPagedWork, isLinked, type Work } from "@/lib/work";

export async function getStaticPaths() {
  const visible = await getPagedWork();
  return (await getBuiltPages()).map((entry) => {
    // The case studies after this one, in order (wrapping round), for "Next up". Unlisted ones
    // are never among them.
    const own = visible.findIndex((work) => work.id === entry.id);
    const after = visible.findIndex((work) => work.data.order > entry.data.order);
    const split = own !== -1 ? own + 1 : after === -1 ? visible.length : after;
    return {
      params: { slug: entry.id },
      props: { entry, following: [...visible.slice(split), ...visible.slice(0, split)] },
    };
  });
}

/** Case studies in "Next up". */
const NEXT_UP = 3;

interface Props {
  entry: Work;
  following: Work[];
}

const { entry, following } = Astro.props;
const { Content, headings } = await render(entry);

// The curated "next" leads when it has a page; the rest follow in order.
const curated = entry.data.next ? await getEntry(entry.data.next) : undefined;
const nextUp = [...(curated && isLinked(curated) ? [curated] : []), ...following]
  .filter((work, i, list) => work.id !== entry.id && list.findIndex((w) => w.id === work.id) === i)
  .slice(0, NEXT_UP);

// MDX files use these without importing them.
const components = { Figure, Video, VideoTabs, BeforeAfter, ImageGrid, Metrics, Callout, Quote };
---

<CaseStudyLayout entry={entry} nextUp={nextUp} headings={headings}>
  <Content components={components} />
</CaseStudyLayout>
