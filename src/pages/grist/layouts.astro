---
/**
 * Review page (previews only): six ways to lay out the front door's quest list, all built from the
 * same QuestCard so the tile reads the same here, on the front door and in See also. Production
 * redirects to /grist. Delete once a layout is picked.
 */
import GristLayout from "@/layouts/GristLayout.astro";
import Container from "@/components/layout/Container.astro";
import QuestCard from "@/components/grist/QuestCard.astro";
import VolumeHeader from "@/components/grist/VolumeHeader.astro";
import { RARITIES, RARITY_LABELS } from "@/lib/grist";
import { derive, getQuests, getVolumes } from "@/lib/quests";
import { isProduction } from "@/lib/site";

if (isProduction) return Astro.redirect("/grist");

const volumes = await getVolumes();
const quests = await getQuests();
const tier = (quest: (typeof quests)[number]) => RARITIES.indexOf(derive(quest).rarity);
const byRank = [...quests].sort(
  (a, b) => tier(b) - tier(a) || derive(b).updated.getTime() - derive(a).updated.getTime(),
);
const [featured, ...rest] = byRank;
const rarityGroups = [...RARITIES]
  .reverse()
  .map((rarity) => ({ rarity, quests: byRank.filter((q) => derive(q).rarity === rarity) }))
  .filter((group) => group.quests.length > 0);

const LAYOUTS = [
  { id: "list", name: "List", note: "Grouped by category, one wide tile per row." },
  { id: "two-up", name: "Two-up grid", note: "Grouped by category, two tiles per row." },
  {
    id: "three-up",
    name: "Three-up grid",
    note: "No groups: every quest in one grid, newest first, category on the tile.",
  },
  {
    id: "featured",
    name: "Featured and grid",
    note: "The rarest quest leads as a wide tile, the rest follow in three columns.",
  },
  {
    id: "columns",
    name: "Side by side",
    note: "One column per category, so both topics are visible at once on desktop.",
  },
  {
    id: "rarity",
    name: "By rarity",
    note: "Grouped by tier, Legendary first, so the most grown quests lead.",
  },
];
const head = (i: number) => LAYOUTS[i]!;
---

<GristLayout title="Grist layouts" noindex>
  <Container class="layouts">
    <header class="layouts__intro">
      <p class="text-caption layouts__muted">Review · previews only</p>
      <h1>Six front door layouts</h1>
      <p class="text-lead layouts__muted">
        Every layout uses the same quest tile. It reads its own width: wide, it is a row; narrow, it
        stacks. On a phone all six collapse to one column of stacked tiles.
      </p>
      <ol class="layouts__index text-small" role="list">
        {LAYOUTS.map((layout, i) => (
          <li>
            <a href={`#${layout.id}`}>
              {i + 1}. {layout.name}
            </a>
          </li>
        ))}
      </ol>
    </header>

    {/* 1. List */}
    <section class="layouts__option" aria-labelledby={head(0).id}>
      <div class="layouts__head">
        <h2 id={head(0).id}>1. {head(0).name}</h2>
        <p class="layouts__muted">{head(0).note}</p>
      </div>
      {volumes.map((volume) => (
        <div class="layouts__group">
          <VolumeHeader id={`list-${volume.id}`} title={volume.title} />
          <ul class="layouts__grid" role="list">
            {volume.quests.map((quest) => (
              <li>
                <QuestCard quest={quest} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    {/* 2. Two-up */}
    <section class="layouts__option" aria-labelledby={head(1).id}>
      <div class="layouts__head">
        <h2 id={head(1).id}>2. {head(1).name}</h2>
        <p class="layouts__muted">{head(1).note}</p>
      </div>
      {volumes.map((volume) => (
        <div class="layouts__group">
          <VolumeHeader id={`two-${volume.id}`} title={volume.title} />
          <ul class="layouts__grid layouts__grid--2" role="list">
            {volume.quests.map((quest) => (
              <li>
                <QuestCard quest={quest} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    {/* 3. Three-up */}
    <section class="layouts__option" aria-labelledby={head(2).id}>
      <div class="layouts__head">
        <h2 id={head(2).id}>3. {head(2).name}</h2>
        <p class="layouts__muted">{head(2).note}</p>
      </div>
      <ul class="layouts__grid layouts__grid--3" role="list">
        {[...quests]
          .sort((a, b) => derive(b).updated.getTime() - derive(a).updated.getTime())
          .map((quest) => (
            <li>
              <QuestCard quest={quest} category />
            </li>
          ))}
      </ul>
    </section>

    {/* 4. Featured */}
    <section class="layouts__option" aria-labelledby={head(3).id}>
      <div class="layouts__head">
        <h2 id={head(3).id}>4. {head(3).name}</h2>
        <p class="layouts__muted">{head(3).note}</p>
      </div>
      <ul class="layouts__grid layouts__grid--3" role="list">
        {featured && (
          <li class="layouts__wide">
            <QuestCard quest={featured} category featured />
          </li>
        )}
        {rest.map((quest) => (
          <li>
            <QuestCard quest={quest} category />
          </li>
        ))}
      </ul>
    </section>

    {/* 5. Side by side */}
    <section class="layouts__option" aria-labelledby={head(4).id}>
      <div class="layouts__head">
        <h2 id={head(4).id}>5. {head(4).name}</h2>
        <p class="layouts__muted">{head(4).note}</p>
      </div>
      <div class="layouts__columns">
        {volumes.map((volume) => (
          <div class="layouts__group">
            <VolumeHeader id={`cols-${volume.id}`} title={volume.title} />
            <ul class="layouts__grid" role="list">
              {volume.quests.map((quest) => (
                <li>
                  <QuestCard quest={quest} />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    {/* 6. By rarity */}
    <section class="layouts__option" aria-labelledby={head(5).id}>
      <div class="layouts__head">
        <h2 id={head(5).id}>6. {head(5).name}</h2>
        <p class="layouts__muted">{head(5).note}</p>
      </div>
      {rarityGroups.map((group) => (
        <div class="layouts__group">
          <VolumeHeader id={`rarity-${group.rarity}`} title={RARITY_LABELS[group.rarity]} />
          <ul class="layouts__grid layouts__grid--3" role="list">
            {group.quests.map((quest) => (
              <li>
                <QuestCard quest={quest} category />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </Container>
</GristLayout>

<style>
  @layer components {
    .layouts {
      display: grid;
      gap: var(--space-section-sm);
      padding-block: var(--space-section-sm) var(--space-section-md);
    }

    .layouts__intro {
      display: grid;
      gap: var(--space-4);
    }

    .layouts__muted {
      color: var(--color-text-muted);
    }

    .layouts__index {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-6);
      padding: 0;
    }

    .layouts__option {
      display: grid;
      gap: var(--space-8);
      padding-block-start: var(--space-12);
      border-block-start: calc(var(--border-width) * 2) solid var(--color-text);
    }

    .layouts__head {
      display: grid;
      gap: var(--space-2);
    }

    .layouts__group {
      display: grid;
      gap: var(--space-6);
      align-content: start;
    }

    .layouts__grid {
      display: grid;
      gap: var(--space-4);
      padding: 0;
    }

    .layouts__grid > li {
      display: grid;
    }

    .layouts__columns {
      display: grid;
      gap: var(--space-12);
    }

    @media (width >= 48em) {
      .layouts__grid--2,
      .layouts__grid--3 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .layouts__wide {
        grid-column: 1 / -1;
      }
    }

    @media (width >= 64em) {
      .layouts__grid--3 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .layouts__columns {
        grid-template-columns: 1fr 1fr;
        gap: var(--space-8);
      }
    }
  }
</style>
