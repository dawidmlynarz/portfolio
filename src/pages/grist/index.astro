---
import GristLayout from "@/layouts/GristLayout.astro";
import Container from "@/components/layout/Container.astro";
import HeroBackdrop from "@/components/blocks/HeroBackdrop.astro";
import DropCard from "@/components/grist/DropCard.astro";
import HumanStamp from "@/components/grist/HumanStamp.astro";
import SeasonHeader from "@/components/grist/SeasonHeader.astro";
import { getSeasons } from "@/lib/drops";

const seasons = await getSeasons();
---

<GristLayout
  title="Grist: human-curated loot for your AI tools"
  description="Rules, prompts, checklists, specs and skills from Dawid Młynarz's product work, written by a human for your AI tools. A new drop every other Friday."
>
  <link slot="head" rel="alternate" type="text/plain" href="/llms.txt" title="Grist for LLMs" />
  <section class="front-hero hero-backdrop-host" aria-labelledby="grist-title">
    <HeroBackdrop />
    <Container class="front-hero__head">
      <p class="text-caption front__muted">Grist for the AI grinders</p>
      <div class="front-hero__title">
        <span class="front-hero__spacer" aria-hidden="true"></span>
        <HumanStamp class="front-hero__stamp" words="Human curated for AI grinders" />
        <h1 id="grist-title">
          Your AI is only as good as what you feed it.{" "}
          <span class="front__muted">
            Here’s human-curated loot, a new drop every other Friday.
          </span>
        </h1>
      </div>
    </Container>
  </section>

  <Container class="front">
    {seasons.map((season) => (
      <section class="front__season" aria-labelledby={season.id}>
        <SeasonHeader season={season.id} unlocked={season.drops.length} />
        {season.open && (
          <ul class="front__grid" role="list">
            {season.slots.map((slot) => (
              <li>
                {slot.drop ? (
                  <DropCard drop={slot.drop} />
                ) : (
                  <DropCard
                    locked={{
                      type: slot.type,
                      rarity: slot.rarity,
                      date: slot.date,
                      next: slot.next,
                      late: slot.late,
                    }}
                  />
                )}
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </Container>
</GristLayout>

<style>
  @layer components {
    .front-hero {
      padding-block: var(--space-section-md);
    }

    .front-hero__head {
      display: grid;
      gap: var(--space-4);
    }

    /*
     * Phones: the headline runs full width and the badge sits under it, pinned to the right.
     * From 48em the badge floats at the lower right of the headline and the words wrap round it:
     * shape-outside makes the float a circle. A zero-width float above it (the spacer, sized in
     * headline lines) pushes it down, since a float can't sit at the bottom on its own. The title
     * box is a new formatting context, so the floats stay inside it.
     */
    .front-hero__title {
      display: flex;
      flex-direction: column;
    }

    .front-hero__spacer {
      display: none;
    }

    .front-hero__stamp {
      order: 1;
      align-self: end;
      margin-block-start: var(--space-4);
    }

    @media (width >= 48em) {
      .front-hero__title {
        display: flow-root;
      }

      .front-hero__spacer {
        display: block;
        float: right;
        inline-size: 0;
        block-size: calc(1.5 * 1lh);
        font: var(--weight-medium) var(--text-h1) / var(--leading-h1) var(--font-heading);
      }

      .front-hero__stamp {
        float: right;
        clear: right;
        margin: 0 0 0 var(--space-8);
        shape-outside: circle(50%);
        shape-margin: var(--space-8);
      }
    }

    .front__muted {
      color: var(--color-text-muted);
    }

    .front {
      display: grid;
      gap: var(--space-section-sm);
      padding-block-end: var(--space-section-md);
    }

    .front__season {
      display: grid;
      gap: var(--space-6);
    }

    .front__grid {
      display: grid;
      gap: var(--space-4);
      padding: 0;
    }

    .front__grid > li {
      display: grid;
    }

    @media (width >= 48em) {
      .front__grid {
        grid-template-columns: 1fr 1fr;
      }
    }
  }
</style>
