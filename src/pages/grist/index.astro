---
import GristLayout from "@/layouts/GristLayout.astro";
import Hero from "@/components/blocks/Hero.astro";
import Container from "@/components/layout/Container.astro";
import QuestCard from "@/components/grist/QuestCard.astro";
import VolumeHeader from "@/components/grist/VolumeHeader.astro";
import ReadmeButton from "@/components/grist/ReadmeButton.astro";
import ReadmePanel from "@/components/grist/ReadmePanel.astro";
import { getVolumes } from "@/lib/quests";

const volumes = await getVolumes();
---

<GristLayout
  title="Grist"
  description="Short, opinionated quests from real product work by Dawid Młynarz. They get rarer as they grow, and every one downloads as markdown."
>
  <Hero
    eyebrow="A side quest by Dawid Młynarz"
    title="Grist."
    titleMuted="Notes on agentic UX and AI-ready design systems."
    lead="Short, opinionated quests from real product work, written on the side of my day job. They get rarer as they grow, and every one downloads as markdown for your AI tools."
  >
    <Fragment slot="actions">
      <ReadmeButton panel="readme" />
    </Fragment>
  </Hero>
  <ReadmePanel id="readme" />

  <Container class="front">
    {volumes.map((volume) => (
      <section class="front__volume" aria-labelledby={volume.id}>
        <VolumeHeader id={volume.id} title={volume.title} />
        <ul class="front__list" role="list">
          {volume.quests.map((quest) => (
            <li>
              <QuestCard quest={quest} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </Container>
</GristLayout>

<style>
  @layer components {
    .front {
      display: grid;
      gap: var(--space-section-sm);
      padding-block-end: var(--space-section-md);
    }

    .front__volume {
      display: grid;
      gap: var(--space-6);
    }

    .front__list {
      display: grid;
      gap: var(--space-4);
      padding: 0;
    }
  }
</style>
