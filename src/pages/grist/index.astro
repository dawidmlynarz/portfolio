---
import GristLayout from "@/layouts/GristLayout.astro";
import Container from "@/components/layout/Container.astro";
import HeroBackdrop from "@/components/blocks/HeroBackdrop.astro";
import DropCard from "@/components/grist/DropCard.astro";
import HumanStamp from "@/components/grist/HumanStamp.astro";
import AuthorNote from "@/components/grist/AuthorNote.astro";
import SeasonHeader from "@/components/grist/SeasonHeader.astro";
import { getSeasons } from "@/lib/drops";

const seasons = await getSeasons();
---

<GristLayout
  title="Grist: human-curated loot for your AI tools"
  description="Rules, prompts, checklists and skills for your AI tools, from Dawid Młynarz's product design work. A new drop every Friday."
  image={{
    src: "/grist/og.png",
    width: 1200,
    height: 630,
    alt: "Grist. Your AI is only as good as what you feed it. Here’s human-curated loot, a new drop every Friday.",
  }}
>
  <link slot="head" rel="alternate" type="text/plain" href="/llms.txt" title="Grist for LLMs" />
  <section class="front-hero hero-backdrop-host" aria-labelledby="grist-title">
    <HeroBackdrop />
    <Container class="front-hero__head">
      <div class="front-hero__text">
        <p class="text-caption front__muted">Loot for AI grinders. Curated by Dawid Młynarz.</p>
        <h1 id="grist-title" class="front-hero__title">
          Your AI is only as good as what you feed it.{" "}
          <span class="front__muted">Here’s human-curated loot, a new drop every Friday.</span>
        </h1>
      </div>
      <HumanStamp class="front-hero__stamp" words="Human-curated loot for AI grinders" />
    </Container>
  </section>

  <Container class="front">
    {seasons.map((season) => (
      <section class="front__season" aria-labelledby={season.id}>
        <SeasonHeader season={season.id} unlocked={season.drops.length} />
        {season.open && (
          <ul class="front__grid" role="list">
            {season.slots.map((slot) => (
              <li>
                {slot.drop ? (
                  <DropCard drop={slot.drop} />
                ) : (
                  <DropCard
                    locked={{
                      type: slot.type,
                      rarity: slot.rarity,
                      date: slot.date,
                      next: slot.next,
                      late: slot.late,
                    }}
                  />
                )}
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
    <AuthorNote size="lg" class="front__author" />
  </Container>
</GristLayout>

<style>
  @layer components {
    .front-hero {
      padding-block: var(--space-section-md);
    }

    /*
     * Figma "hero" (157:6128): the caption and headline, with the badge in a column of its own at
     * the lower right. On phones the badge sits under the headline, pinned to the right.
     */
    .front-hero__head {
      display: grid;
      gap: var(--space-4) var(--space-8);
    }

    .front-hero__text {
      display: grid;
      gap: var(--space-4);
    }

    .front-hero__title {
      font-weight: var(--weight-semibold);
    }

    /* Under the head's selector so it beats the badge's own size. */
    .front-hero__head .front-hero__stamp {
      --stamp-size: clamp(var(--space-24) + var(--space-6), 16vw, var(--space-24) * 1.875);

      justify-self: end;
    }

    @media (width >= 48em) {
      .front-hero__head {
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
      }
    }

    .front__muted {
      color: var(--color-text-muted);
    }

    .front {
      display: grid;
      gap: var(--space-section-sm);
      padding-block-end: var(--space-section-md);
    }

    .front__author {
      padding-block-start: var(--space-section-sm);
      border-block-start: calc(var(--border-width) * 2) solid var(--color-text);
    }

    .front__season {
      display: grid;
      gap: var(--space-6);
    }

    .front__grid {
      display: grid;
      gap: var(--space-4);
      padding: 0;
    }

    .front__grid > li {
      display: grid;
    }

    @media (width >= 48em) {
      .front__grid {
        grid-template-columns: 1fr 1fr;
      }
    }
  }
</style>
