---
import GristLayout from "@/layouts/GristLayout.astro";
import FrontDoor from "@/components/grist/FrontDoor.astro";
import { getSeasons, nextDropDay } from "@/lib/drops";

// Started seasons, plus the one that holds the next drop, so the day the hero badge teases is a
// locked card marked next. Later seasons stay off the front door. Number order while the newest
// season shown has no drop out yet (Season 1 first until Season 2's first Friday), then newest
// first so the running season sits under the next drop badge. The sandbox keeps number order.
const next = nextDropDay()?.getTime();
const shown = (await getSeasons())
  .map((season) => ({
    ...season,
    open: season.open || season.slots.some((slot) => slot.date.getTime() === next),
  }))
  .filter((season) => season.open);
const newestStarted = (shown.at(-1)?.drops.length ?? 0) > 0;
const seasons = newestStarted ? shown.reverse() : shown;
---

<GristLayout
  title="Grist: human-curated loot for your AI tools"
  description="Rules, prompts, checklists and skills for your AI tools, from Dawid Młynarz's product design work. A new drop every Friday."
  image={{
    src: "/grist/og.png",
    width: 1200,
    height: 630,
    alt: "Grist. Your AI is only as good as what you feed it. Here’s human-curated loot, a new drop every Friday.",
  }}
>
  <link slot="head" rel="alternate" type="text/plain" href="/llms.txt" title="Grist for LLMs" />
  <FrontDoor seasons={seasons} />
</GristLayout>
