---
import GristLayout from "@/layouts/GristLayout.astro";
import Hero from "@/components/blocks/Hero.astro";
import Container from "@/components/layout/Container.astro";
import DropCard from "@/components/grist/DropCard.astro";
import HumanStamp from "@/components/grist/HumanStamp.astro";
import SeasonHeader from "@/components/grist/SeasonHeader.astro";
import ReadmeButton from "@/components/grist/ReadmeButton.astro";
import ReadmePanel from "@/components/grist/ReadmePanel.astro";
import { getSeasons } from "@/lib/drops";

const seasons = await getSeasons();
---

<GristLayout
  title="Grist: human-written loot for your AI tools"
  description="Rules, prompts, checklists, specs and skills from Dawid Młynarz's product work, written by a human for your AI tools. Copy or download each one as markdown."
>
  <link slot="head" rel="alternate" type="text/plain" href="/llms.txt" title="Grist for LLMs" />
  <Hero
    eyebrow="A side quest by Dawid Młynarz"
    title="Grist."
    titleMuted="Human-written loot for your AI tools."
    lead="Rules, prompts, checklists, specs and skills from my product work on agentic UX and design systems. I write them; your AI reads them. Every drop copies in one click and downloads as markdown."
  >
    <Fragment slot="actions">
      <ReadmeButton panel="readme" />
    </Fragment>
    <div slot="media" class="front__stamp">
      <HumanStamp />
    </div>
  </Hero>
  <ReadmePanel id="readme" />

  <Container class="front">
    {seasons.map((season) => (
      <section class="front__season" aria-labelledby={season.id}>
        <SeasonHeader season={season.id} />
        <ul class="front__grid" role="list">
          {season.drops.map((drop) => (
            <li>
              <DropCard drop={drop} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </Container>
</GristLayout>

<style>
  @layer components {
    .front {
      display: grid;
      gap: var(--space-section-sm);
      padding-block-end: var(--space-section-md);
    }

    .front__stamp {
      display: flex;
      justify-content: center;
    }

    .front__season {
      display: grid;
      gap: var(--space-6);
    }

    .front__grid {
      display: grid;
      gap: var(--space-4);
      padding: 0;
    }

    .front__grid > li {
      display: grid;
    }

    @media (width >= 48em) {
      .front__grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (width >= 62em) {
      .front__stamp {
        justify-content: end;
      }
    }
  }
</style>
