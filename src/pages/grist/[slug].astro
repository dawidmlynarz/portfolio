---
import { render } from "astro:content";
import GristLayout from "@/layouts/GristLayout.astro";
import Container from "@/components/layout/Container.astro";
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import HeroBackdrop from "@/components/blocks/HeroBackdrop.astro";
import Icon from "@/components/grist/Icon.astro";
import RarityLabel from "@/components/grist/RarityLabel.astro";
import DropCard from "@/components/grist/DropCard.astro";
import LootBox from "@/components/grist/LootBox.astro";
import PermalinkButton from "@/components/grist/PermalinkButton.astro";
import { SEASONS } from "@/lib/grist";
import { SITE } from "@/lib/site";
import {
  derive,
  dropHref,
  formatDate,
  getBuiltDrops,
  isoDate,
  lootOf,
  twinHref,
  type Drop,
} from "@/lib/drops";

export async function getStaticPaths() {
  const drops = await getBuiltDrops();
  return drops.map((drop) => ({
    params: { slug: drop.id },
    props: {
      drop,
      related: drop.data.related.flatMap((slug) => drops.find((d) => d.id === slug) ?? []),
    },
  }));
}

interface Props {
  drop: Drop;
  related: Drop[];
}

const { drop, related } = Astro.props;
const { data } = drop;
const { Content, headings } = await render(drop);
const { type, rarity, published } = derive(drop);
const season = SEASONS[data.season];
const url = new URL(dropHref(drop), Astro.site).href;
const toc = [
  { slug: "why", text: "Why" },
  ...headings.filter((heading) => heading.depth === 2),
  ...(data.steps.length ? [{ slug: "how-to-use-it", text: "How to use it" }] : []),
  { slug: "the-drop", text: "The drop" },
  ...(data.limits ? [{ slug: "limits", text: "When not to use it" }] : []),
  ...(related.length ? [{ slug: "see-also", text: "See also" }] : []),
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.summary,
  url,
  datePublished: isoDate(published),
  author: { "@type": "Person", name: SITE.name, url: Astro.site?.href },
  isAccessibleForFree: true,
  hasPart: {
    "@type": "CreativeWork",
    name: `${data.title}: ${type.label.toLowerCase()}`,
    encodingFormat: "text/markdown",
    text: lootOf(drop),
  },
};
---

<GristLayout title={`${data.title} · Grist`} description={data.summary} type="article" {jsonLd}>
  <link slot="head" rel="alternate" type="text/markdown" href={twinHref(drop)} />
  <div class="hero-backdrop-host">
    <HeroBackdrop />
    <Container class="drop">
      <header class="drop__header">
        <p class="drop__back text-small">
          <Icon name="arrow-left" />
          <Link href="/grist">All drops</Link>
        </p>
        <h1>{data.title}</h1>
        <div class="drop__meta">
          <div class="drop__tags">
            <RarityLabel rarity={rarity} type={data.drop} />
            <span class="drop__fact">
              Season {season.number}: {season.title}
            </span>
            <span class="drop__fact">
              <Icon name="calendar" />
              <time datetime={isoDate(published)}>{formatDate(published)}</time>
            </span>
          </div>
          <PermalinkButton url={url} />
        </div>
      </header>

      <div class="drop__layout">
        <article class="drop__main">
          <p class="text-caption drop__muted">tl;dr</p>
          <p class="text-lead drop__summary">{data.summary}</p>
          <dl class="drop__brief">
            <div>
              <dt class="text-caption drop__muted">Use it when</dt>
              <dd>{data.useWhen}</dd>
            </div>
            <div>
              <dt class="text-caption drop__muted">What you get</dt>
              <dd>{data.outcome}</dd>
            </div>
          </dl>
          <h2 class="drop__heading" id="why">
            Why
          </h2>
          <div class="drop__body">
            <Content />
          </div>
          {data.steps.length > 0 && (
            <section class="drop__section" aria-labelledby="how-to-use-it">
              <h2 class="drop__heading" id="how-to-use-it">
                How to use it
              </h2>
              <ol class="drop__steps">
                {data.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            </section>
          )}
          <div class="drop__loot">
            <LootBox drop={drop} />
          </div>
          {data.limits && (
            <section class="drop__section" aria-labelledby="limits">
              <h2 class="drop__heading" id="limits">
                When not to use it
              </h2>
              <p>{data.limits}</p>
            </section>
          )}
        </article>

        <aside class="drop__rail">
          <nav aria-labelledby="on-this-page">
            <h2 class="text-caption drop__label" id="on-this-page">
              On this page
            </h2>
            <ul class="drop__toc text-small" role="list">
              {toc.map((item) => (
                <li>
                  <Link href={`#${item.slug}`}>{item.text}</Link>
                </li>
              ))}
            </ul>
          </nav>
        </aside>

        <div class="drop__more">
          {related.length > 0 && (
            <section aria-labelledby="see-also">
              <h2 class="drop__heading" id="see-also">
                See also
              </h2>
              <ul class="drop__related" role="list">
                {related.map((other) => (
                  <li>
                    <DropCard drop={other} season={other.data.season !== data.season} />
                  </li>
                ))}
              </ul>
            </section>
          )}
          <section class="drop__touch">
            <p class="drop__muted">
              Grist is my side quest. If one of these hit close to something you’re working on, I’d
              like to hear about it.
            </p>
            <Button href="/contact" variant="secondary" icon="arrow">
              Get in touch
            </Button>
          </section>
        </div>
      </div>
    </Container>
  </div>
</GristLayout>

<style>
  @layer components {
    .drop {
      padding-block: var(--space-12) var(--space-section-md);
    }

    .drop__header {
      display: grid;
      gap: var(--space-6);
      padding-block-end: var(--space-8);
      border-block-end: calc(var(--border-width) * 2) solid var(--color-text);
    }

    .drop__back {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      justify-self: start;
    }

    .drop__meta,
    .drop__tags {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4) var(--space-6);
    }

    .drop__meta {
      justify-content: space-between;
    }

    .drop__fact {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--text-small);
      line-height: var(--leading-small);
      white-space: nowrap;
    }

    .drop__muted {
      color: var(--color-text-muted);
    }

    .drop__layout {
      display: grid;
      grid-template-areas: "main" "rail" "more";
      gap: var(--space-12);
      padding-block-start: var(--space-12);
    }

    .drop__main {
      grid-area: main;
      min-inline-size: 0;
    }

    .drop__rail {
      display: grid;
      grid-area: rail;
      align-content: start;
      gap: var(--space-10);
    }

    .drop__more {
      display: grid;
      grid-area: more;
      gap: var(--space-12);
      min-inline-size: 0;
    }

    .drop__label {
      padding-block-end: var(--space-3);
      border-block-end: var(--border-width) solid var(--color-text);
      color: var(--color-text-muted);
    }

    .drop__brief {
      display: grid;
      gap: var(--space-4) var(--space-8);
      max-inline-size: var(--measure);
      margin-block-end: var(--space-12);
      padding-block: var(--space-4);
      border-block: var(--border-width) solid var(--color-border-subtle);
    }

    .drop__brief dt {
      margin-block-end: var(--space-1);
    }

    .drop__steps {
      display: grid;
      gap: var(--space-2);
      padding-inline-start: var(--space-6);
    }

    .drop__summary {
      max-inline-size: var(--measure);
      margin-block: var(--space-3) var(--space-8);
      color: var(--color-text);
    }

    .drop__body,
    .drop__loot,
    .drop__section {
      max-inline-size: var(--measure);
    }

    /* Room above for the stamp, which sits half over the box's top edge. */
    .drop__loot {
      margin-block-start: calc(var(--space-12) + var(--space-12));
    }

    /* Section headings in the article use the h3 style, so the page title stays the only big one. */
    .drop__body :global(h2),
    .drop__heading {
      margin-block-end: var(--space-4);
      font: var(--weight-medium) var(--text-h3) / var(--leading-h3) var(--font-heading);
      letter-spacing: var(--tracking-h3);
    }

    .drop__body :global(* + h2) {
      margin-block-start: var(--space-12);
    }

    /* Examples: the same plain code panel as the loot box. */
    .drop__body :global(pre) {
      overflow-x: auto;
      margin-block-start: var(--space-4);
      padding: var(--space-4);
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
      font-size: var(--text-small);
      line-height: var(--leading-small);
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      background-color: var(--color-bg-subtle);
    }

    .drop__body :global(p + p) {
      margin-block-start: var(--space-4);
    }

    .drop__section {
      margin-block-start: var(--space-12);
    }

    .drop__toc {
      display: grid;
      gap: var(--space-2);
      padding: var(--space-3) 0 0;
    }

    .drop__related {
      display: grid;
      gap: var(--space-4);
      padding: 0;
    }

    .drop__related > li {
      display: grid;
    }

    .drop__touch {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
      max-inline-size: var(--measure);
      padding-block-start: var(--space-8);
      border-block-start: calc(var(--border-width) * 2) solid var(--color-text);
    }

    .drop__touch p {
      flex: 1 1 20rem;
    }

    @media (width >= 48em) {
      .drop__brief {
        grid-template-columns: 1fr 1fr;
      }

      .drop__related {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (width >= 64em) {
      .drop__layout {
        grid-template-areas: "main rail" "more rail";
        grid-template-columns: minmax(0, 1fr) 16rem;
        column-gap: var(--space-16);
      }

      .drop__rail {
        position: sticky;
        inset-block-start: var(--space-8);
        align-self: start;
      }
    }
  }
</style>
