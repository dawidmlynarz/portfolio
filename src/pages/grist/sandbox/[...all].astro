---
/**
 * Dawid's sandbox: a copy of the front door with every written drop unlocked, whatever its day or
 * draft state, so he can read and click through the seasons before they drop. Previews only:
 * production builds no page here (getStaticPaths returns nothing), and previews are noindex.
 */
import GristLayout from "@/layouts/GristLayout.astro";
import FrontDoor from "@/components/grist/FrontDoor.astro";
import { getSeasons } from "@/lib/drops";
import { isProduction } from "@/lib/site";

export function getStaticPaths() {
  return isProduction ? [] : [{ params: { all: undefined } }];
}

const seasons = await getSeasons({ all: true });
// Season packs are built from the drops that are out, so only those seasons offer one here.
const packs = new Set(
  (await getSeasons()).filter((season) => season.drops.length > 0).map((season) => season.id),
);
---

<GristLayout title="Grist sandbox" description="Every Grist drop, unlocked." noindex sandbox>
  <FrontDoor seasons={seasons} packs={packs} />
</GristLayout>
