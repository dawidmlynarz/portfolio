---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Section from "@/components/layout/Section.astro";
import Container from "@/components/layout/Container.astro";
import SectionIntro from "@/components/blocks/SectionIntro.astro";
import Services from "@/components/blocks/Services.astro";
import HeroBackdrop from "@/components/blocks/HeroBackdrop.astro";
import Process from "@/components/blocks/Process.astro";
import Beliefs from "@/components/blocks/Beliefs.astro";
import Plans from "@/components/blocks/Plans.astro";
import Testimonials from "@/components/blocks/Testimonials.astro";
import { SERVICES } from "@/lib/services";
import { PLANS } from "@/lib/plans";
import { STEPS, BELIEFS } from "@/lib/process";
import { TESTIMONIALS } from "@/lib/testimonials";
import { breadcrumbs, offerCatalog, service } from "@/lib/schema";

const site = Astro.site!;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    ...SERVICES.map((entry) => service(site, entry)),
    offerCatalog(site, PLANS),
    breadcrumbs(site, [["Services", "/services"]]),
  ],
};
---

<SiteLayout
  jsonLd={jsonLd}
  title="AI-ready design systems and agentic UX"
  description="Hire a Senior Product Designer for AI-ready design systems, agentic UX and product strategy: a fixed-price audit, an Embedded Design Lead, or a custom project."
>
  <Section space="md" class="hero-backdrop-host" aria-labelledby="services-title">
    <HeroBackdrop />
    <Container class="services-page services-page--hero">
      <div class="services-page__head">
        <p class="text-caption services-page__muted">Services</p>
        <h1 id="services-title" data-reveal="lines">
          Your team got fast with AI.{" "}
          <span class="services-page__muted">Let’s make sure it stays good.</span>
        </h1>
        <p class="text-lead services-page__muted" data-reveal="fade">
          I’m a Senior Product Designer for teams shipping with AI. I build the design systems,
          agent patterns and review habits that keep the product worth trusting as you speed up.
        </p>
      </div>
      <Services services={SERVICES} headingLevel={2} variant="detailed" />
    </Container>
  </Section>

  <Section space="lg" aria-labelledby="approach-title">
    <Container class="services-page">
      <SectionIntro
        id="approach-title"
        label="Approach"
        title="A few things"
        titleMuted="I’m pretty sure about."
      />
      <Beliefs beliefs={BELIEFS} />
    </Container>
  </Section>

  <Section space="lg" aria-labelledby="plans-title">
    <Container class="services-page">
      <SectionIntro
        id="plans-title"
        label="Engagements"
        title="A Senior Design Lead on your team,"
        titleMuted="without the hire."
      />
      <Plans plans={PLANS} headingLevel={3} id="plans" />
    </Container>
  </Section>

  <Section space="lg" aria-labelledby="testimonials-title">
    <Container class="services-page services-page--quotes">
      <h2 id="testimonials-title" class="text-caption services-page__muted">
        From people I’ve worked with
      </h2>
      <Testimonials testimonials={TESTIMONIALS} />
    </Container>
  </Section>
  <Section space="lg" aria-labelledby="working-title">
    <Container class="services-page">
      <SectionIntro
        id="working-title"
        label="Working together"
        title="What it’s like"
        titleMuted="to have me on the project."
        lead="You’ll know where we stand every week, and you’ll own everything when I leave. One person, start to finish. No account managers, no hand-offs."
      />
      <Process steps={STEPS} />
    </Container>
  </Section>
</SiteLayout>

<style>
  @layer components {
    .services-page {
      display: grid;
      gap: var(--space-section-sm);
    }

    /* As on Work: the page head, then its content. */
    .services-page--hero {
      gap: var(--space-section-md);
    }

    .services-page--quotes {
      gap: var(--space-8);
    }

    /* Same as the Work head, so the headline starts at the same height on both pages. */
    .services-page__head {
      display: grid;
      gap: var(--space-4);
    }

    .services-page__muted {
      color: var(--color-text-muted);
    }
  }
</style>
