---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Section from "@/components/layout/Section.astro";
import Container from "@/components/layout/Container.astro";
import SectionIntro from "@/components/blocks/SectionIntro.astro";
import Services from "@/components/blocks/Services.astro";
import HeroBackdrop from "@/components/blocks/HeroBackdrop.astro";
import Plans from "@/components/blocks/Plans.astro";
import Testimonials from "@/components/blocks/Testimonials.astro";
import { SERVICES } from "@/lib/services";
import { PLANS } from "@/lib/plans";
import { TESTIMONIALS } from "@/lib/testimonials";
import { breadcrumbs, offerCatalog, service } from "@/lib/schema";

const site = Astro.site!;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    ...SERVICES.map((entry) => service(site, entry)),
    offerCatalog(site, PLANS),
    breadcrumbs(site, [["Services", "/services"]]),
  ],
};
---

<SiteLayout
  jsonLd={jsonLd}
  title="AI-ready design systems and agentic UX"
  description="Hire a senior product designer for AI-ready design systems, agentic UX and product strategy: a fixed-price audit, an embedded lead, or a custom project."
>
  <Section space="md" class="hero-backdrop-host" aria-labelledby="services-title">
    <HeroBackdrop />
    <Container class="services-page">
      <div class="services-page__head">
        <p class="text-caption services-page__muted">Services</p>
        <h1 id="services-title" data-reveal="lines">
          Strategy, systems and agents, <span class="services-page__muted">designed to ship.</span>
        </h1>
        <p class="text-lead services-page__lead services-page__muted" data-reveal="fade">
          Three services, one way of working: close to the problem, close to engineering, and
          measured by what changes for the people using the product.
        </p>
      </div>
      <Services services={SERVICES} headingLevel={2} variant="detailed" />
    </Container>
  </Section>

  <Section space="lg" aria-labelledby="plans-title">
    <Container class="services-page">
      <SectionIntro
        id="plans-title"
        label="Plans"
        title="Three ways to work with me,"
        titleMuted="each priced upfront."
      />
      <div class="services-page__plans">
        <Plans plans={PLANS} headingLevel={3} id="plans" />
        <p class="text-lead services-page__lead" data-reveal="fade">
          Looking for a full-time senior or lead product designer?{" "}
          <span class="services-page__muted">
            I’m open to that too, with a team building AI-first products.
          </span>
        </p>
      </div>
    </Container>
  </Section>

  <Section space="lg" aria-labelledby="testimonials-title">
    <Container class="services-page">
      <SectionIntro
        id="testimonials-title"
        label="Kind words"
        title="What people say"
        titleMuted="about working with me."
      />
      <Testimonials testimonials={TESTIMONIALS} />
    </Container>
  </Section>
</SiteLayout>

<style>
  @layer components {
    .services-page {
      display: grid;
      gap: var(--space-section-md);
    }

    .services-page__head {
      display: grid;
      gap: var(--space-6);
    }

    .services-page__plans {
      display: grid;
      gap: var(--space-10);
    }

    .services-page__lead {
      max-inline-size: var(--measure);
    }

    .services-page__muted {
      color: var(--color-text-muted);
    }
  }
</style>
