---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Section from "@/components/layout/Section.astro";
import Container from "@/components/layout/Container.astro";
import HomeHero from "@/components/blocks/HomeHero.astro";
import StoryIntro from "@/components/blocks/StoryIntro.astro";
import SectionIntro from "@/components/blocks/SectionIntro.astro";
import Services from "@/components/blocks/Services.astro";
import ClientLogos from "@/components/blocks/ClientLogos.astro";
import WorkGrid from "@/components/blocks/WorkGrid.astro";
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import { SITE, SOCIAL_LINKS } from "@/lib/site";
import { SERVICES } from "@/lib/services";
import { getListedWork } from "@/lib/work";

/** Home shows the first four case studies; the rest are on /work. */
const work = (await getListedWork()).slice(0, 4);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: SITE.title,
      url: Astro.site?.href,
      inLanguage: SITE.locale,
    },
    {
      "@type": "Person",
      name: SITE.name,
      jobTitle: SITE.jobTitle,
      url: Astro.site?.href,
      email: `mailto:${SITE.email}`,
      image: new URL(SITE.ogImage.src, Astro.site).href,
      sameAs: SOCIAL_LINKS.map((link) => link.href),
      knowsAbout: ["Agentic UX", "AI-ready design systems", "Product strategy", "Product design"],
    },
  ],
};
---

<SiteLayout navOverlap jsonLd={jsonLd}>
  <HomeHero
    label="Agentic UX • AI-ready design systems • Product strategy"
    title="Transforming AI capability"
    titleMuted="into products people actually trust."
    lead="I bring 15 years of product experience to the AI era, helping you architect AI-ready design systems, safe agentic workflows, and impactful product strategies."
  >
    <Fragment slot="actions">
      {SOCIAL_LINKS.map(({ href, label }) => (
        <Link href={href}>{label}</Link>
      ))}
      <Link href={`mailto:${SITE.email}`}>Contact</Link>
    </Fragment>
  </HomeHero>

  <StoryIntro
    label="About"
    text="I'm Dawid Młynarz, a senior product designer with 15 years of turning complex problems into clear, useful products. I've shaped newsrooms, fintech and creator platforms, and built the design systems behind them. Today I help teams bring AI into their products in ways people understand, trust and actually use."
  />

  <Section id="work" space="lg" aria-labelledby="work-title">
    <Container class="home__stack">
      <SectionIntro
        id="work-title"
        label="Selected work"
        title="Products I've shaped,"
        titleMuted="told by their outcomes."
      />
      <WorkGrid entries={work} />
      <div class="home__cta">
        <Button href="/work">View all work</Button>
      </div>
    </Container>
  </Section>

  <Section space="lg" aria-labelledby="services-title">
    <Container class="home__stack">
      <SectionIntro
        id="services-title"
        label="What I do"
        title="Three ways I help teams"
        titleMuted="ship products that work."
        href="/services"
        hrefLabel="Services in detail"
      />
      <Services services={SERVICES} />
    </Container>
  </Section>

  <Section space="md" aria-labelledby="clients-title" class="home__clients">
    <Container>
      <p class="text-caption home__muted" id="clients-title">
        Trusted by teams at
      </p>
    </Container>
    <ClientLogos marquee />
  </Section>
</SiteLayout>

<style>
  @layer components {
    .home__stack {
      display: grid;
      gap: var(--space-section-sm);
    }

    .home__muted {
      color: var(--color-text-muted);
    }

    .home__clients {
      display: grid;
      gap: var(--space-section-sm);
    }

    .home__cta {
      display: flex;
      justify-content: center;
    }
  }
</style>
