---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Section from "@/components/layout/Section.astro";
import Container from "@/components/layout/Container.astro";
import HomeHero from "@/components/blocks/HomeHero.astro";
import StoryIntro from "@/components/blocks/StoryIntro.astro";
import SectionIntro from "@/components/blocks/SectionIntro.astro";
import Services from "@/components/blocks/Services.astro";
import ClientLogos from "@/components/blocks/ClientLogos.astro";
import WorkGrid from "@/components/blocks/WorkGrid.astro";
import Button from "@/components/ui/Button.astro";
import { SERVICES } from "@/lib/services";
import { getListedWork } from "@/lib/work";
import { HOME_STORY } from "@/lib/story";
import { person, website } from "@/lib/schema";

/** Home shows the first four case studies; the rest are on /work. */
const work = (await getListedWork()).slice(0, 4);

const site = Astro.site!;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [website(site), await person(site)],
};
---

<SiteLayout navOverlap jsonLd={jsonLd}>
  <HomeHero
    label="Agentic UX • AI-ready design systems • Product strategy"
    title="Transforming AI capability"
    titleMuted="into products people actually trust."
    lead="I bring 15 years of product experience to the AI era, helping you architect AI-ready design systems, safe agentic workflows, and impactful product strategies."
  >
    <Fragment slot="actions">
      <Button href="/about" icon="arrow">
        About me
      </Button>
      <Button href="/contact" variant="secondary" icon="arrow">
        Contact
      </Button>
    </Fragment>
  </HomeHero>

  <div class="home__clients">
    <ClientLogos marquee />
  </div>

  <StoryIntro label="About" paragraphs={HOME_STORY} />

  <Section id="work" space="lg" aria-labelledby="work-title">
    <Container class="home__stack">
      <SectionIntro
        id="work-title"
        label="Selected work"
        title="Products I've shaped,"
        titleMuted="told by their outcomes."
      />
      <WorkGrid entries={work} />
      <div class="home__cta">
        <Button href="/work">View all work</Button>
      </div>
    </Container>
  </Section>

  <Section space="lg" aria-labelledby="services-title">
    <Container class="home__stack">
      <SectionIntro
        id="services-title"
        label="What I do"
        title="Three ways I help teams"
        titleMuted="ship products that work."
        href="/services"
        hrefLabel="Services in detail"
      />
      <Services services={SERVICES} />
    </Container>
  </Section>
</SiteLayout>

<style>
  @layer components {
    .home__stack {
      display: grid;
      gap: var(--space-section-sm);
    }

    /* About brings its own space below the logos. */
    .home__clients {
      padding-block-start: var(--space-section-md);
    }

    .home__cta {
      display: flex;
      justify-content: center;
    }
  }
</style>
