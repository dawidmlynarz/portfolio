---
// Living styleguide: every token and component, in both themes (use the toggle in the nav).
// noindex and excluded from the sitemap. If a component exists, it should appear here.
import SiteLayout from "@/layouts/SiteLayout.astro";
import Container from "@/components/layout/Container.astro";
import Stack from "@/components/layout/Stack.astro";
import Grid from "@/components/layout/Grid.astro";
import Section from "@/components/layout/Section.astro";
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";
import Tag from "@/components/ui/Tag.astro";
import Figure from "@/components/ui/Figure.astro";
import Video from "@/components/ui/Video.astro";
import VideoTabs from "@/components/content/VideoTabs.astro";
import BeforeAfter from "@/components/ui/BeforeAfter.astro";
import Hero from "@/components/blocks/Hero.astro";
import PortraitReveal from "@/components/blocks/PortraitReveal.astro";
import WorkGrid from "@/components/blocks/WorkGrid.astro";
import Metrics from "@/components/content/Metrics.astro";
import SectionIntro from "@/components/blocks/SectionIntro.astro";
import Services from "@/components/blocks/Services.astro";
import Plans from "@/components/blocks/Plans.astro";
import Testimonials from "@/components/blocks/Testimonials.astro";
import Process from "@/components/blocks/Process.astro";
import Beliefs from "@/components/blocks/Beliefs.astro";
import Quote from "@/components/content/Quote.astro";
import StoryIntro from "@/components/blocks/StoryIntro.astro";
import CareerTimeline from "@/components/blocks/CareerTimeline.astro";
import InlineImage from "@/components/ui/InlineImage.astro";
import YouTube from "@/components/ui/YouTube.astro";
import { CAREER } from "@/lib/career";
import youtubeSample from "@/assets/about/video-css-peeper.jpg";
import portraitSample from "@/assets/about/tadzik.jpg";
import gifSample from "@/assets/about/gifs/gandalf.webp?url";
import gifSampleStill from "@/assets/about/gifs/gandalf-still.webp?url";
import ClientLogos from "@/components/blocks/ClientLogos.astro";
import WorkMarquee from "@/components/blocks/WorkMarquee.astro";
import ClientLogo from "@/components/ui/ClientLogo.astro";
import NextUp from "@/components/content/NextUp.astro";
import CaseStudyToc from "@/components/content/CaseStudyToc.astro";
import { getPagedWork } from "@/lib/work";
import LockPanel from "@/components/blocks/LockPanel.astro";
import { getEntry } from "astro:content";
import { COLOR_ROLES, SPACE } from "@/lib/tokens";
import { SERVICES } from "@/lib/services";
import { PLANS } from "@/lib/plans";
import { TESTIMONIALS } from "@/lib/testimonials";
import { STEPS, BELIEFS } from "@/lib/process";
import { PORTRAIT_LAYERS, portraitPhoto } from "@/lib/portrait";
import figureSample from "@/assets/placeholders/figure-sample.jpg";
import diagramSample from "@/content/work/zazmic-anvil-ui/anvil-levels.avif";
import videoSample from "@/assets/placeholders/video-sample.mp4";
import videoSamplePoster from "@/assets/placeholders/video-sample-poster.jpg";
import compareBefore from "@/content/work/csspeeper/csspeeper-before.avif";
import compareAfter from "@/content/work/csspeeper/csspeeper-after.avif";

// Contents mini map (right edge, from 62em) over this page's own sections, as on case studies.
const STYLEGUIDE_SECTIONS = [
  ["color-title", "Color"],
  ["type-title", "Typography"],
  ["space-title", "Spacing"],
  ["shape-title", "Shape & depth"],
  ["layout-title", "Layout"],
  ["components-title", "Components"],
  ["blocks-title", "Blocks"],
].map(([slug, text]) => ({ depth: 2, slug: slug!, text: text! }));
const nextUpSample = (await getPagedWork()).slice(0, 3);

const TYPE_ROLES = [
  { role: "display", className: "text-display", sample: "hello@mlynarz.com" },
  { role: "h1", tag: "h1", sample: "Designing calm products" },
  { role: "h2", tag: "h2", sample: "Research that changes the roadmap" },
  { role: "h3", tag: "h3", sample: "From insight to interface" },
  { role: "h4", tag: "h4", sample: "Measured outcomes" },
  {
    role: "lead",
    className: "text-lead",
    sample: "A lead paragraph introduces a page or case study in one or two sentences.",
  },
  {
    role: "body",
    tag: "p",
    sample:
      "Body copy sits at a comfortable measure. It is used for case-study writing, so it needs to stay readable over long stretches.",
  },
  {
    role: "small",
    className: "text-small",
    sample: "Small text for captions, metadata and footnotes.",
  },
  { role: "caption", className: "text-caption", sample: "Caption · eyebrow" },
] as const;

const sampleWork = (
  await Promise.all(
    ["newsweek-design-system", "nerdwallet", "xwp", "pantheon"].map((slug) =>
      getEntry("work", slug),
    ),
  )
).filter((entry) => entry !== undefined);
const sampleService = { ...SERVICES[0]!, title: "Services row" };

const RADII = ["sm", "md", "lg", "xl", "pill"] as const;

const SECTIONS = [
  ["color", "Color"],
  ["type", "Typography"],
  ["space", "Spacing"],
  ["shape", "Shape & depth"],
  ["layout", "Layout"],
  ["components", "Components"],
  ["blocks", "Blocks"],
] as const;
---

<SiteLayout title="Styleguide" description="Tokens and components of mlynarz.com." noindex>
  <Section space="md">
    <Container>
      <Stack gap="6">
        <p class="text-caption muted">Internal · not indexed</p>
        <h1>Styleguide</h1>
        <p class="text-lead muted measure">
          Every token and component on the site. Switch the theme with the button in the nav;
          everything here must look right in light and dark.
        </p>
        <nav aria-label="Styleguide sections">
          <ul class="toc" role="list">
            {SECTIONS.map(([id, label]) => (
              <li>
                <Link href={`#${id}`} variant="quiet">
                  {label}
                </Link>
              </li>
            ))}
          </ul>
        </nav>
      </Stack>
    </Container>
  </Section>

  <Section id="color" aria-labelledby="color-title" tone="subtle">
    <Container>
      <Stack gap="8">
        <h2 id="color-title">Color</h2>
        <p class="muted measure">
          Semantic roles only. Each one is a <code>light-dark()</code> pair over the primitives in
          <code>tokens.css</code>. Components never use primitives.
        </p>
        <Grid min="12rem" gap="6" as="ul" class="plain-list">
          {COLOR_ROLES.map((role) => (
            <li class="swatch">
              <span class="swatch__chip" style={`--swatch: var(--color-${role})`} />
              <code>--color-{role}</code>
            </li>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <Section id="type" aria-labelledby="type-title">
    <Container>
      <Stack gap="8">
        <h2 id="type-title">Typography</h2>
        <p class="muted measure">
          Roles, not sizes. Fluid from 375px to 1440px; resize the window to see it scale.
        </p>
        <Stack gap="10" as="ul" class="plain-list">
          {TYPE_ROLES.map((item) => {
            const Tag = "tag" in item ? item.tag : "p";
            return (
              <li class="type-row">
                <code class="type-row__name">--text-{item.role}</code>
                <Tag class:list={["className" in item && item.className, "measure-wide"]}>
                  {item.sample}
                </Tag>
              </li>
            );
          })}
        </Stack>
      </Stack>
    </Container>
  </Section>

  <Section id="space" aria-labelledby="space-title" tone="subtle">
    <Container>
      <Stack gap="8">
        <h2 id="space-title">Spacing</h2>
        <p class="muted measure">
          4px base, in rem. Section spacing and the gutter are fluid:{" "}
          <code>--space-section-sm</code>, <code>-md</code>, <code>-lg</code>, <code>--gutter</code>
          .
        </p>
        <Stack gap="3" as="ul" class="plain-list">
          {SPACE.map((key) => (
            <li class="space-row">
              <code>--space-{key}</code>
              <span class="space-row__bar" style={`--bar: var(--space-${key})`} />
            </li>
          ))}
          {(["sm", "md", "lg"] as const).map((key) => (
            <li class="space-row">
              <code>--space-section-{key}</code>
              <span class="space-row__bar" style={`--bar: var(--space-section-${key})`} />
            </li>
          ))}
        </Stack>
      </Stack>
    </Container>
  </Section>

  <Section id="shape" aria-labelledby="shape-title">
    <Container>
      <Stack gap="8">
        <h2 id="shape-title">Shape &amp; depth</h2>
        <Grid min="9rem" gap="6" as="ul" class="plain-list">
          {RADII.map((key) => (
            <li class="shape">
              <span class="shape__box" style={`--shape-radius: var(--radius-${key})`} />
              <code>--radius-{key}</code>
            </li>
          ))}
          <li class="shape">
            <span class="shape__box shape__box--shadow"></span>
            <code>--shadow-bar</code>
          </li>
        </Grid>
      </Stack>
    </Container>
  </Section>

  <Section id="layout" aria-labelledby="layout-title" tone="subtle">
    <Container>
      <Stack gap="8">
        <h2 id="layout-title">Layout</h2>
        <p class="muted measure">
          <code>Container</code> (default · narrow · full), <code>Stack</code> (vertical rhythm),
          <code>Grid</code> (auto-fill columns with a minimum width) and <code>Section</code> (fluid
          vertical padding, optional subtle tone).
        </p>
        <Stack gap="4">
          <h3 class="text-caption muted">Grid · min 14rem · gap 6</h3>
          <Grid min="14rem" gap="6">
            {[1, 2, 3, 4].map((n) => (
              <div class="demo-box">
                <Stack gap="2">
                  <strong>Card {n}</strong>
                  <span class="text-small muted">Stack gap 2 inside</span>
                </Stack>
              </div>
            ))}
          </Grid>
        </Stack>
      </Stack>
    </Container>
    <Container width="narrow" class="demo-narrow">
      <p class="text-small muted">Container width="narrow": the reading measure, used for prose.</p>
    </Container>
  </Section>

  <Section id="components" aria-labelledby="components-title">
    <Container>
      <Stack gap="12">
        <h2 id="components-title">Components</h2>

        <Stack gap="4">
          <h3>Link</h3>
          <p class="measure">
            Every plain <a href="#components">link in text</a> has a hairline underline and tears
            into three rows for a moment on hover. The{" "}
            <Link href="#components" variant="quiet">
              quiet variant
            </Link>{" "}
            shows it only on hover. External links get an arrow:{" "}
            <Link href="https://www.figma.com">Figma</Link>. A call to action can take a forward
            arrow:{" "}
            <Link href="#components" icon="arrow">
              Contact
            </Link>
            .
          </p>
        </Stack>

        <Stack gap="4">
          <h3>Button</h3>
          <div class="row">
            <Button>Primary</Button>
            <Button variant="secondary">Secondary</Button>
            <Button variant="ghost">Ghost</Button>
            <Button disabled>Disabled</Button>
          </div>
          <div class="row">
            <Button size="sm">Primary small</Button>
            <Button size="sm" variant="secondary">
              Secondary small
            </Button>
            <Button href="#components" variant="secondary">
              As a link
            </Button>
          </div>
          <div class="row">
            <Button href="#components" size="lg" icon="arrow">
              hello@mlynarz.com
            </Button>
            <Button href="#components" icon="arrow">
              With arrow
            </Button>
            <Button href="#components" variant="secondary" icon="arrow-up" label="Back to top" />
            <Button variant="secondary" icon="arrow-left" label="Previous" />
            <Button variant="ghost" icon="arrow" label="Ghost icon button" />
            <Button href="#components" icon="arrow" label="Next" />
          </div>
        </Stack>

        <Stack gap="4">
          <h3>Tag</h3>
          <ul class="row plain-list" role="list">
            <Tag as="li">Product design</Tag>
            <Tag as="li">Research</Tag>
            <Tag as="li" variant="solid">
              AI
            </Tag>
            <Tag as="li" variant="solid">
              2025
            </Tag>
          </ul>
        </Stack>

        <Stack gap="4">
          <h3>Figure</h3>
          <Figure
            src={figureSample}
            alt="Placeholder layout: a page with a heading, two text lines and three cards."
            caption="Figure with a caption. Images go through astro:assets and require alt text."
          />
          <Figure
            src={diagramSample}
            alt="The building blocks of Anvil UI as line icons: atoms, molecules, organisms, templates and the Agent Builder."
            width="content"
            variant="diagram"
            caption="Diagram variant: a transparent line drawing at the text width, no card. Inverted in the dark theme."
          />
          <Figure
            alt="Figma library structure: foundations feeding the marketing and product libraries."
            caption="Placeholder variant: leave out src while the image is being made. Previews only; production skips it."
          />
        </Stack>

        <Stack gap="4">
          <h3>Video</h3>
          <p class="muted measure">
            Muted looping clips for case studies. They load nothing until needed and play only while
            half of the video is on screen. The button in the corner pauses and plays. With reduced
            motion, or without JS, the native controls show and nothing autoplays. Pass an AV1 MP4
            as <code>av1</code> and an H.264 MP4 as <code>src</code>, plus a poster.
          </p>
          <Video
            src={videoSample}
            poster={videoSamplePoster}
            label="Sample clip: the Anvil UI Showroom assistant answering in a side panel."
            caption="Video with a poster and a caption."
          />
          <Video
            label="A screen recording of the booking flow."
            caption="Placeholder variant: leave out src while the recording is being made. Previews only; production skips it."
          />
        </Stack>

        <Stack gap="4">
          <h3>YouTube</h3>
          <p class="muted measure">
            A YouTube video that loads nothing from YouTube until it is played: a local poster and a
            play button, then the youtube-nocookie player on click. Without JS it links to the
            video.
          </p>
          <div class="measure">
            <YouTube
              id="Ibm2SO8XvA4"
              title="Getting started with CSS Peeper"
              poster={youtubeSample}
            />
          </div>
        </Stack>

        <Stack gap="4">
          <h3>InlineImage</h3>
          <p class="measure text-lead">
            A small picture inside a sentence, like this one{" "}
            <InlineImage src={youtubeSample} alt="CSS Peeper inspecting colours and fonts." />, a
            portrait one <InlineImage src={portraitSample} alt="Tadzik the dog." shape="portrait" />{" "}
            or a GIF{" "}
            <InlineImage src={gifSample} still={gifSampleStill} alt="GIF: Gandalf dancing." />,
            sized in em so it follows the text. Hover zooms it well past the line; with reduced
            motion a GIF shows a still frame.
          </p>
        </Stack>

        <Stack gap="4">
          <h3>VideoTabs</h3>
          <p class="muted measure">
            Several clips in one frame with a tab for each, so a case study can show a lot without
            getting longer. Only the chosen clip shows and loads; switching starts it from the
            beginning. Arrow keys move between tabs. Without JS every clip shows in turn, captioned
            with its tab name.
          </p>
          <VideoTabs
            label="Sample flows"
            items={[
              {
                tab: "First flow",
                src: videoSample,
                poster: videoSamplePoster,
                label: "Sample clip: the Anvil UI Showroom assistant answering in a side panel.",
                caption: "Each tab can have its own one-line caption.",
              },
              {
                tab: "Second flow",
                src: videoSample,
                poster: videoSamplePoster,
                label: "The same sample clip, as a second tab.",
              },
            ]}
          />
        </Stack>

        <Stack gap="4">
          <h3>BeforeAfter</h3>
          <p class="muted measure">
            Two images of the same size stacked on top of each other. Drag anywhere on it, or swipe
            sideways on a phone, to move the handle; the arrow keys work once the handle has focus.
            Vertical swipes still scroll the page. Labels default to Before and After.
          </p>
          <BeforeAfter
            before={compareBefore}
            after={compareAfter}
            beforeAlt="CSS Peeper in 2016: Colors, Inspector and Assets panels."
            afterAlt="CSS Peeper in 2025: the same panels redesigned."
            caption="BeforeAfter with the default labels."
          />
        </Stack>

        <Stack gap="4">
          <h3>LockPanel</h3>
          <p class="muted measure">
            The password panel on a locked case study (<code>protected: true</code>), over the
            blurred page. It posts to the case study's URL, where the Pages Function checks the
            password. A wrong one brings it back in the error state with one sideways jolt.
          </p>
          <div class="row">
            <LockPanel action="#components" company="Pantheon" headingLevel={3} />
            <LockPanel action="#components" company="Pantheon" headingLevel={3} error />
          </div>
        </Stack>
      </Stack>
    </Container>
  </Section>

  <Section id="blocks" aria-labelledby="blocks-title" tone="subtle" space="sm">
    <Container>
      <Stack gap="4">
        <h2 id="blocks-title">Blocks</h2>
        <p class="muted measure">
          Nav and Footer frame this page. Below: the split Hero with the PortraitReveal, on the hero
          grain (HeroBackdrop: fine noise that fades out over the first screen and stays put during
          page transitions; also on Home, About, Services, Work and case studies, one per page). At
          rest two tracking bands roll down the portrait like a mistracked tape; point at it (tap on
          touch) and the rows tear open around the cursor, harder the faster it moves. Each band
          reveals one of the layers under the photo (marble or iridescent; the two bands always show
          one of each), picked at random; marble switches variants with the theme. With reduced
          motion there is no rolling or tearing, only a clean band at the pointer.
        </p>
      </Stack>
    </Container>
  </Section>
  <Hero
    eyebrow="Product designer"
    title="Design that makes complex products feel simple."
    lead="Hero block, split layout. Content on the left, media slot on the right; stacks on small screens."
  >
    <Fragment slot="actions">
      <Button href="#blocks">See work</Button>
      <Button href="#blocks" variant="secondary">
        About me
      </Button>
    </Fragment>
    <PortraitReveal
      slot="media"
      top={portraitPhoto}
      layers={PORTRAIT_LAYERS}
      alt="Portrait of Dawid Młynarz"
      loading="lazy"
    />
  </Hero>
  <Section aria-label="Work grid">
    <Container>
      <Stack gap="6">
        <h3 class="text-caption muted">
          WorkGrid of WorkCards (Home) · titles and up to three tags · four-tile rhythm on desktop,
          staggered pairs on tablet, one column on mobile · a tile without a page (`page: false`)
          has no link
        </h3>
        <WorkGrid entries={sampleWork} />
        <h3 class="text-caption muted">
          WorkGrid layout="index" · ruled WorkCard rows (Work page): cover left, summary cut to four
          lines, first three tags and "+N more"
        </h3>
        <WorkGrid entries={sampleWork} layout="index" />
      </Stack>
    </Container>
  </Section>
  <Section aria-label="Section intro and services">
    <Container>
      <Stack gap="12">
        <SectionIntro
          label="SectionIntro · label, two-tone title, optional link"
          title="Three ways I help teams"
          titleMuted="ship products that work."
          href="#blocks"
          hrefLabel="Optional link"
        />
        <h3 class="text-caption muted">Services · summary (Home)</h3>
        <Services headingLevel={4} services={[sampleService]} />
        <h3 class="text-caption muted">Services · detailed (/services), adds deliverables</h3>
        <Services headingLevel={4} services={[sampleService]} variant="detailed" />
        <h3 class="text-caption muted">
          Plans · priced plans with a primary button, a quoted plan with a secondary one (/services)
        </h3>
        <Plans headingLevel={4} plans={PLANS} anchors={false} />
        <h3 class="text-caption muted">
          Testimonials · one quote at a time, ghost arrows (/services)
        </h3>
        <Testimonials testimonials={TESTIMONIALS} label="Testimonials sample" />
        <h3 class="text-caption muted">
          Quote · md (case studies) and lg (the /services carousel)
        </h3>
        <Quote author="Name" role="Role, Company">
          A short quote in the case-study size.
        </Quote>
        <Quote size="lg" author="Name" role="Role, Company">
          The same quote, carousel size.
        </Quote>
        <h3 class="text-caption muted">
          Process · steps on a line that draws itself as it scrolls (/services)
        </h3>
        <Process steps={STEPS.slice(0, 3)} headingLevel={4} />
        <h3 class="text-caption muted">Beliefs · numbered two-tone statements (/services)</h3>
        <Beliefs beliefs={BELIEFS.slice(0, 2)} />
        <h3 class="text-caption muted">SectionIntro · with a lead paragraph</h3>
        <SectionIntro
          label="Label"
          title="Two-tone title"
          titleMuted="with a lead."
          lead="An optional lead paragraph under the title, at most the reading measure wide."
        />
        <h3 class="text-caption muted">ClientLogos · row (About) and spread; marquee below</h3>
        <ClientLogos />
        <ClientLogos spread />
        <h3 class="text-caption muted">
          ClientLogo · one logo in the text colour (case-study header, sized by its parent)
        </h3>
        <p class="styleguide__client-logo">
          <ClientLogo client="pantheon" />
        </p>
        <h3 class="text-caption muted">
          Metrics · up to three numbers inside case studies, content width by default, top-aligned
        </h3>
        <Metrics
          items={[
            { value: "80%", label: "Higher click-through rate" },
            { value: "30%", label: "Lower bounce rate" },
            { value: "+60", label: "Team eNPS, with a label long enough to wrap onto two lines" },
          ]}
        />
      </Stack>
    </Container>
  </Section>
  <Section aria-label="Client logo marquee" space="sm">
    <ClientLogos marquee />
  </Section>
  <Section aria-label="Case-study cover marquee (Contact)" space="sm">
    <WorkMarquee />
  </Section>
  <StoryIntro
    label="StoryIntro · statement"
    text="The words light up as you scroll. Without the motion layer, or with reduced motion, the full statement simply shows."
  />
  <StoryIntro
    label="StoryIntro · paragraphs"
    paragraphs={[
      [
        "The longer variant, used on About: up to three paragraphs at reading size, with ",
        { text: "links", href: "#blocks" },
        " and small pictures ",
        { image: youtubeSample, alt: "CSS Peeper inspecting colours and fonts." },
        " that light up with the words around them.",
      ],
    ]}
  />
  <Section aria-label="Career timeline" space="sm">
    <Container>
      <CareerTimeline roles={CAREER.slice(0, 4)} />
    </Container>
  </Section>
  <NextUp entries={nextUpSample} />
  <CaseStudyToc headings={STYLEGUIDE_SECTIONS} body="main" />
</SiteLayout>

<style>
  @layer components {
    .muted {
      color: var(--color-text-muted);
    }

    .styleguide__client-logo :global(svg) {
      display: block;
      inline-size: auto;
      block-size: var(--space-12);
    }

    .measure {
      max-inline-size: var(--measure);
    }

    .measure-wide {
      max-inline-size: calc(var(--measure) * 1.4);
    }

    .plain-list {
      padding: 0;
      list-style: none;
    }

    .toc,
    .row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3) var(--space-6);
    }

    .row {
      gap: var(--space-3);
    }

    .toc {
      padding: 0;
    }

    code {
      font-family: var(--font-mono);
      font-size: var(--text-small);
    }

    .swatch {
      display: grid;
      gap: var(--space-2);
    }

    .swatch__chip {
      block-size: var(--space-16);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-md);
      background: var(--swatch);
    }

    .type-row {
      display: grid;
      gap: var(--space-2);
    }

    .type-row__name {
      color: var(--color-text-muted);
    }

    .space-row {
      display: grid;
      grid-template-columns: 12rem 1fr;
      align-items: center;
      gap: var(--space-4);
    }

    .space-row__bar {
      inline-size: var(--bar);
      block-size: var(--space-3);
      border-radius: var(--radius-sm);
      background-color: var(--color-brand);
    }

    .shape {
      display: grid;
      gap: var(--space-2);
    }

    .shape__box {
      aspect-ratio: 1;
      border: var(--border-width) solid var(--color-border-muted);
