---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Section from "@/components/layout/Section.astro";
import Container from "@/components/layout/Container.astro";
import Mindblown from "@/experiments/mindblown/Mindblown.astro";
import HeroBackdrop from "@/components/blocks/HeroBackdrop.astro";
import StoryIntro, { type StoryPart } from "@/components/blocks/StoryIntro.astro";
import SectionIntro from "@/components/blocks/SectionIntro.astro";
import CareerTimeline from "@/components/blocks/CareerTimeline.astro";
import YouTube from "@/components/ui/YouTube.astro";
import { CAREER } from "@/lib/career";
import { breadcrumbs, person, websiteId } from "@/lib/schema";
import portrait from "@/assets/portrait/portrait-photo.avif";
import horseMask from "@/assets/about/about-04.jpg";
import produktanci from "@/assets/about/about-02.jpg";
import newsweek from "@/content/work/newsweek-design-system/cover.avif";
import beatstars from "@/content/work/beatstars-product-design/cover.avif";
import csspeeper from "@/content/work/csspeeper/cover.avif";
import anvil from "@/content/work/zazmic-anvil-ui/cover.avif";
import maraudersPoster from "@/assets/about/video-marauders-map.jpg";
import cssPeeperPoster from "@/assets/about/video-css-peeper.jpg";

/** The story under the ribbon: three paragraphs, Dawid's voice. Pictures grow on hover. */
const story: StoryPart[][] = [
  [
    "I’m Dawid Młynarz ",
    { image: portrait, alt: "Black and white portrait of Dawid in glasses.", focus: "40% 40%" },
    ", a Lead Product Designer from Poznań with 15 years of turning complex problems into clear, useful products. I studied linguistics, not design, and learned the craft on the job. Since then I’ve shaped newsrooms ",
    { image: newsweek, alt: "The redesigned Newsweek homepage on a desktop and a phone." },
    ", fintech and creator platforms ",
    { image: beatstars, alt: "BeatStars app screens for music producers." },
    ", and built the design systems behind them.",
  ],
  [
    "In 2016 I co-founded ",
    { text: "CSS Peeper", href: "/work/csspeeper" },
    " ",
    { image: csspeeper, alt: "CSS Peeper panels inspecting colours, fonts and assets." },
    ", a Chrome extension that over half a million designers and developers have installed. Running my own product changed how I work with clients: I know what a feature really costs, because I’ve paid for plenty myself. Today I help teams bring AI into their products ",
    { image: anvil, alt: "Anvil UI components for AI agents: tool calls, sources and progress." },
    " in ways people understand, trust and actually use.",
  ],
  [
    "Outside work I’m a husband, a dad, and the owner of Tadzik, a black mixed breed who thinks he runs security. I collect classic LEGO Castle and Pirates sets, rewatch the extended Lord of the Rings far too often, and once the house goes quiet I drop into Arc Raiders. Now and then I make videos ",
    {
      image: produktanci,
      alt: "Dawid on a laptop screen next to the Produktanci design system page, a YouTube series he co-created.",
    },
    ", and I take the work seriously, myself a lot less ",
    { image: horseMask, alt: "Dawid in the office wearing a horse-head mask, holding a mug." },
    ".",
  ],
];

const videos = [
  {
    id: "9ITPaRkldDU",
    title: "What if the Marauder’s Map was a mobile app",
    poster: maraudersPoster,
    meta: "Nov 2021 · Figma prototype",
    text: "The Marauder’s Map from Harry Potter, reimagined as a phone app and built entirely as a Figma prototype. It’s from 2021 and the tools have moved on a lot since, but it’s still one of my favourite side projects.",
  },
  {
    id: "Ibm2SO8XvA4",
    title: "Getting started with CSS Peeper",
    poster: cssPeeperPoster,
    meta: "Aug 2025 · 5 min walkthrough",
    text: "A tour of CSS Peeper after the 2025 relaunch: how to pull colours, fonts and assets out of any website without opening DevTools.",
  },
];

const skills = [
  "Product design for B2C, B2B, enterprise and SaaS",
  "Lean UX, Agile and design thinking methodologies",
  "Human-centered (HCD) and customer-focused (CX) design solutions",
  "Establishing and scaling design systems",
  "Design team management and mentorship",
  "Native app design for iOS and Android",
  "Information architecture and interaction design",
  "Qualitative and quantitative UX research",
  "Usability testing and A/B testing",
  "Internal/external stakeholder management",
];

const site = Astro.site!;
// About is Dawid's profile page; the Person node lives here in full and is referenced elsewhere.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      url: new URL("/about", site).href,
      isPartOf: { "@id": websiteId(site) },
      mainEntity: await person(site),
    },
    breadcrumbs(site, [["About", "/about"]]),
  ],
};
---

<SiteLayout
  navOverlap
  title="About me: Product Designer based in Poland"
  jsonLd={jsonLd}
  description="I'm Dawid, a Lead Product Designer in Poland. For 15 years I've worked on products used by millions, from newsrooms to fintech and creator platforms."
>
  <div class="hero-backdrop-host">
    <HeroBackdrop flush />
    <Mindblown>
      <p class="text-caption muted">Get to know me</p>
      <h1 id="about-title">Hey! Thanks for stopping by.</h1>
    </Mindblown>
  </div>

  <StoryIntro label="About me" paragraphs={story} />

  <Section space="lg" aria-labelledby="career-title">
    <Container class="about__stack">
      <SectionIntro
        id="career-title"
        label="Career"
        title="Where I’ve been,"
        titleMuted="and what I did there."
      />
      <CareerTimeline roles={CAREER} />
    </Container>
  </Section>

  <Section space="lg" aria-labelledby="videos-title">
    <Container class="about__stack">
      <SectionIntro
        id="videos-title"
        label="On YouTube"
        title="Two videos"
        titleMuted="I’m still proud of."
      />
      <ul class="videos" role="list">
        {videos.map(({ id, title, poster, meta, text }) => (
          <li class="videos__item" data-reveal="fade">
            <YouTube id={id} title={title} poster={poster} />
            <div class="videos__copy">
              <p class="text-caption videos__meta">{meta}</p>
              <h3 class="videos__title">{title}</h3>
              <p class="videos__text">{text}</p>
            </div>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section aria-labelledby="skills-title">
    <Container>
      <div class="split">
        <div class="split__head">
          <p class="text-caption muted">What I’ve learned and practiced</p>
          <h2 id="skills-title">Skills &amp; expertise</h2>
        </div>
        <ul class="skills" role="list">
          {skills.map((skill) => (
            <li class="skills__item">{skill}</li>
          ))}
        </ul>
      </div>
    </Container>
  </Section>
</SiteLayout>

<style>
  @layer components {
    .muted {
      color: var(--color-text-muted);
    }

    .about__stack {
      display: grid;
      gap: var(--space-section-sm);
    }

    .videos {
      display: grid;
      gap: var(--space-12) var(--space-8);
      padding: 0;
    }

    .videos__item {
      display: grid;
      align-content: start;
      gap: var(--space-6);
    }

    .videos__copy {
      display: grid;
      gap: var(--space-2);
    }

    .videos__meta,
    .videos__text {
      color: var(--color-text-muted);
    }

    .videos__title {
      font: var(--weight-medium) var(--text-h4) / var(--leading-h4) var(--font-heading);
      letter-spacing: var(--tracking-h4);
    }

    .videos__text {
      max-inline-size: 34em;
      text-wrap: pretty;
    }

    .split {
      display: grid;
      gap: var(--space-8);
    }

    .split__head {
      display: grid;
      align-content: start;
      gap: var(--space-3);
    }

    .skills {
      display: grid;
      padding: 0;
      border-block-start: var(--border-width) solid var(--color-border-subtle);
    }

    .skills__item {
      padding-block: var(--space-4);
      border-block-end: var(--border-width) solid var(--color-border-subtle);
    }

    @media (width >= 62em) {
      .videos {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .split {
        grid-template-columns: 1fr 1.6fr;
        gap: var(--space-16);
      }
    }
  }
</style>
