---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  /** Required. Describe what the image shows; use "" only for purely decorative images. */
  alt: string;
  caption?: string;
  /** How wide the image renders, for responsive srcset. Defaults to the page container. */
  sizes?: string;
  loading?: "lazy" | "eager";
  /** Inside Prose: content (reading measure), wide (page width) or full (edge to edge). */
  width?: "content" | "wide" | "full";
  class?: string;
}

const {
  src,
  alt,
  caption,
  sizes,
  loading = "lazy",
  width = "wide",
  class: className,
} = Astro.props;

const widths = [480, 800, 1200, 1600, 2400].filter((w) => w <= src.width);
const defaultSizes = {
  content: "(min-width: 44rem) 40rem, calc(100vw - 2rem)",
  wide: "(min-width: 84rem) 80rem, calc(100vw - 2rem)",
  full: "100vw",
};
---

<figure class:list={["figure", `figure--${width}`, className]} data-width={width}>
  <Image
    class="figure__image"
    src={src}
    alt={alt}
    widths={widths.length ? widths : [src.width]}
    sizes={sizes ?? defaultSizes[width]}
    loading={loading}
  />
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>

<style>
  @layer components {
    .figure {
      display: grid;
      gap: var(--space-3);
    }

    .figure__image {
      inline-size: 100%;
      border-radius: var(--radius-md);
      background-color: var(--color-bg-subtle);
    }

    .figure--full .figure__image {
      border-radius: 0;
    }

    .figure--full .figure__caption {
      padding-inline: var(--gutter);
    }

    .figure__caption {
      max-inline-size: var(--measure);
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--color-text-muted);
    }
  }
</style>
