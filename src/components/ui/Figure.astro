---
import { Image } from "astro:assets";
import { isProduction } from "@/lib/site";

interface Props {
  /**
   * Leave out for a placeholder while the image is being made: a dashed box labelled with `alt`.
   * Placeholders render on previews only, never in production.
   */
  src?: ImageMetadata;
  /** Required. Describe what the image shows; use "" only for purely decorative images. */
  alt: string;
  caption?: string;
  /** How wide the image renders, for responsive srcset. Defaults to the page container. */
  sizes?: string;
  loading?: "lazy" | "eager";
  /** Inside Prose: content (reading measure), wide (page width) or full (edge to edge). */
  width?: "content" | "wide" | "full";
  class?: string;
}

const {
  src,
  alt,
  caption,
  sizes,
  loading = "lazy",
  width = "wide",
  class: className,
} = Astro.props;

const widths = src ? [480, 800, 1200, 1600, 2400].filter((w) => w <= src.width) : [];
const hidden = !src && isProduction;
const defaultSizes = {
  content: "(min-width: 44rem) 40rem, calc(100vw - 2rem)",
  wide: "(min-width: 84rem) 80rem, calc(100vw - 2rem)",
  full: "100vw",
};
---

{!hidden && (
  <figure
    class:list={["figure", `figure--${width}`, { "figure--placeholder": !src }, className]}
    data-width={width}
  >
    {src ? (
      <Image
        class="figure__image"
        src={src}
        alt={alt}
        widths={widths.length ? widths : [src.width]}
        sizes={sizes ?? defaultSizes[width]}
        loading={loading}
        format="avif"
      />
    ) : (
      <div
        class="figure__image figure__placeholder"
        role="img"
        aria-label={`Image to come: ${alt}`}
      >
        <span class="text-caption">Image to come</span>
        <span class="figure__placeholder-label">{alt}</span>
      </div>
    )}
    {caption && <figcaption class="figure__caption">{caption}</figcaption>}
  </figure>
)}

<style>
  @layer components {
    .figure {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }

    .figure__image {
      inline-size: 100%;
      border-radius: var(--radius-md);
      background-color: var(--color-bg-subtle);
    }

    .figure__placeholder {
      display: grid;
      place-content: center;
      justify-items: center;
      gap: var(--space-2);
      aspect-ratio: 16 / 9;
      padding: var(--space-6);
      border: var(--border-width) dashed var(--color-border-muted);
      color: var(--color-text-muted);
      text-align: center;
    }

    .figure__placeholder-label {
      max-inline-size: var(--measure);
      text-wrap: balance;
    }

    .figure--full .figure__image {
      border-radius: 0;
    }

    .figure--full .figure__caption {
      padding-inline: var(--gutter);
    }

    .figure__caption {
      max-inline-size: var(--measure);
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--color-text-muted);
    }
  }
</style>
