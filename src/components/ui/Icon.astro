---
/**
 * One line icon from the site's set (src/lib/icons.ts): 24px grid, 1.75 stroke, round caps and
 * joins, currentColor. Decorative unless a label is given. Sized in em, so it follows the text.
 * Components restyle it through `class` (size, stroke width, fill): its own rules sit in :where(),
 * so any class from the parent wins.
 */
import { ICONS, type IconName } from "@/lib/icons";

export type { IconName };

interface Props {
  name: IconName;
  /** Accessible name. Without it the icon is hidden from assistive tech. */
  label?: string;
  /** md: 1em, the text's size · lg: 1.25em, for meta rows (date, status) and the back arrow */
  size?: "md" | "lg";
  class?: string;
}

const { name, label, size = "md", class: className } = Astro.props;
---

<svg
  class:list={["icon", { "icon--lg": size === "lg" }, className]}
  viewBox="0 0 24 24"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  {ICONS[name].map((d) => (
    <path d={d} />
  ))}
</svg>

<style>
  @layer components {
    :where(.icon) {
      flex: none;
      inline-size: 1em;
      block-size: 1em;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    :where(.icon--lg) {
      inline-size: 1.25em;
      block-size: 1.25em;
    }
  }
</style>
