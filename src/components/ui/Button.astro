---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/ui/Icon.astro";

interface Props extends Omit<HTMLAttributes<"button">, "class" | "type"> {
  /** Renders an <a> when set, otherwise a <button>. */
  href?: string;
  /** Links only: download the target instead of opening it, under this file name. */
  download?: string;
  type?: "button" | "submit" | "reset";
  variant?: "primary" | "secondary" | "ghost";
  /** sm: menu contact · md: default · lg: footer email */
  size?: "sm" | "md" | "lg";
  /**
   * After the label: arrow (calls to action) · arrow-left (carousel back) · arrow-up (Back to top).
   * Before the label: arrow-down (downloads) · info · link · copy · sparkles (anything for AI tools).
   */
  icon?: "arrow" | "arrow-left" | "arrow-up" | "arrow-down" | "info" | "link" | "copy" | "sparkles";
  /** Text buttons only. tear: the row tear (default) · icon: no tear, the icon moves as on icon buttons. */
  hover?: "tear" | "icon";
  /** Makes an icon-only button: the icon is all that shows and this is its accessible name. */
  label?: string;
  class?: string;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  icon,
  hover = "tear",
  label,
  class: className,
  ...attrs
} = Astro.props;
const iconOnly = Boolean(label && icon);
const iconHover = iconOnly || hover === "icon";
const classes = [
  "button",
  `button--${variant}`,
  `button--${size}`,
  iconOnly && "button--icon",
  iconHover && "button--icon-hover",
  className,
];
const content = iconOnly ? "" : await Astro.slots.render("default");
// Arrows point onward, so they follow the label; the rest name the action, so they lead.
const leading = Boolean(icon && !["arrow", "arrow-left", "arrow-up"].includes(icon));
// The face is the button at rest. Text buttons add two copies in the hover colours for the row
// tear (top and bottom rows, middle row); icon-hover buttons animate the icon instead.
const layers = iconHover ? ["face"] : ["face", "outer", "middle"];
---

{(() => {
  const inner = layers.map((layer) => (
    <span
      class:list={[
        layer === "face" ? "button__face" : "button__tear",
        layer !== "face" && `button__tear--${layer}`,
      ]}
      aria-hidden={layer === "face" ? undefined : "true"}
    >
      {leading && icon && <Icon name={icon} class={`button__icon button__icon--${icon}`} />}
      {content && <span set:html={content} />}
      {!leading && icon && <Icon name={icon} class={`button__icon button__icon--${icon}`} />}
    </span>
  ));
  return href ? (
    <a
      class:list={classes}
      href={href}
      data-no-tear
      aria-label={iconOnly ? label : undefined}
      {...(attrs as HTMLAttributes<"a">)}
    >
      {inner}
    </a>
  ) : (
    <button class:list={classes} type={type} aria-label={iconOnly ? label : undefined} {...attrs}>
      {inner}
    </button>
  );
})()}

<style>
  @layer components {
    /*
     * One button family, black and white. The anchor or button is a one-cell grid: the face is the
     * button at rest, and text buttons stack two copies of it in the hover colours in the same cell.
     * Hover is the links' row tear, scaled up: the copies arrive as three rows that jolt sideways
     * for a few frames, then lock together as the inverted button. Icon buttons (and text buttons
     * with hover="icon") skip the tear and move their icon the way it points. Reduced motion (reset.css) keeps only the end state.
     */
    .button {
      --button-pad: var(--space-3) var(--space-6);
      --tear-shift: 2; /* the link tear, jolting twice as far */

      display: inline-grid;
      padding: 0;
      border: 0;
      border-radius: var(--radius-pill);
      font-weight: var(--weight-medium);
      line-height: var(--leading-tight);
      text-align: center;
      background: none; /* no link underline, no browser fill on <button> (the face paints it) */
      transition: scale var(--duration-fast) var(--ease-standard);
    }

    .button:focus-visible {
      outline-offset: var(--space-1);
    }

    .button:not(:disabled):active {
      scale: 0.97;
    }

    /* Rest and hover colours. Primary inverts to an outline. Secondary and ghost stay outlines:
       subtle (or none) at rest, black after the tear. */
    .button--primary {
      --rest-bg: var(--color-inverse-bg);
      --rest-fg: var(--color-on-inverse);
      --rest-ring: var(--color-inverse-bg);
      --hot-bg: var(--color-bg);
      --hot-fg: var(--color-text);
      --hot-ring: var(--color-text);
    }

    .button--secondary,
    .button--ghost {
      --rest-bg: transparent;
      --rest-fg: var(--color-text);
      --rest-ring: var(--color-border-muted);
      --hot-bg: transparent;
      --hot-fg: var(--color-text);
      --hot-ring: var(--color-text);
    }

    .button--ghost {
      --rest-ring: transparent;
    }

    .button--sm {
      --button-pad: var(--space-2) var(--space-4);

      font-size: var(--text-small);
    }

    .button--lg {
      --button-pad: var(--space-4) var(--space-6);

      font-size: var(--text-lead);
    }

    /* Icon buttons match the nav's theme and menu buttons: a 2.5rem circle, a 1.125em icon.
       Ghost ones also share their hover, a soft fill with no ring. */
    .button--icon {
      --button-pad: calc((var(--space-10) - 1.125em) / 2);
    }

    .button--ghost.button--icon {
      --hot-bg: var(--color-bg-subtle);
      --hot-ring: transparent;
    }

    .button__face,
    .button__tear {
      display: flex;
      grid-area: 1 / 1;
      gap: var(--space-2);
      align-items: center;
      justify-content: center;
      padding: var(--button-pad);
      border-radius: inherit;
      white-space: nowrap;
    }

    .button__face {
      overflow: clip;
      color: var(--rest-fg);
      background-color: var(--rest-bg);
      box-shadow: inset 0 0 0 var(--border-width) var(--rest-ring);
      transition:
        color var(--duration-fast) var(--ease-standard),
        background-color var(--duration-fast) var(--ease-standard),
        box-shadow var(--duration-fast) var(--ease-standard);
    }

    .button__tear {
      color: var(--hot-fg);
      background-color: var(--hot-bg);
      box-shadow: inset 0 0 0 var(--border-width) var(--hot-ring);
      pointer-events: none;
      opacity: 0;
    }

    .button__icon {
      flex-shrink: 0;
      inline-size: 1em;
      block-size: 1em;
      transition: translate var(--duration-link) var(--ease-out-expo);
    }

    .button--icon .button__icon {
      inline-size: 1.125em;
      block-size: 1.125em;
    }

    /* ---------- Text buttons: the row tear ----------
       The copies stand in for the face, as the link tear hides the real text while it runs.
       After the tear the top copy stays whole and the middle copy hides, so no seams show.
       The keyframes are the link tear's (base.css), at twice the shift. */
    .button:not(:disabled, .button--icon-hover):is(:hover, :focus-visible) .button__face {
      opacity: 0;
    }

    .button:not(:disabled):is(:hover, :focus-visible) .button__tear--outer {
      opacity: 1;
      animation: link-tear-outer var(--duration-tear) steps(1, end);
    }

    .button:not(:disabled):is(:hover, :focus-visible) .button__tear--middle {
      animation: link-tear-middle var(--duration-tear) steps(1, end);
    }

    .button:not(:disabled, .button--icon-hover):is(:hover, :focus-visible)
      :is(.button__icon--arrow, .button__icon--arrow-left, .button__icon--arrow-up) {
      translate: var(--space-1) 0;
    }

    /* ---------- Icon buttons: same colours, the icon goes where it points ----------
       The arrow leaves through the edge it points at and comes back in from the opposite one. */
    .button--icon-hover:not(:disabled):is(:hover, :focus-visible) .button__face {
      color: var(--hot-fg);
      background-color: var(--hot-bg);
      box-shadow: inset 0 0 0 var(--border-width) var(--hot-ring);
    }

    .button--icon-hover:not(:disabled):is(:hover, :focus-visible) .button__icon--arrow {
      animation: button-icon-right var(--duration-icon);
    }

    .button--icon-hover:not(:disabled):is(:hover, :focus-visible) .button__icon--arrow-left {
      animation: button-icon-left var(--duration-icon);
    }

    .button--icon-hover:not(:disabled):is(:hover, :focus-visible) .button__icon--arrow-up {
      animation: button-icon-up var(--duration-icon);
    }

    .button--icon-hover:not(:disabled):is(:hover, :focus-visible) .button__icon--arrow-down {
      animation: button-icon-down var(--duration-icon);
    }

    @keyframes button-icon-right {
      0% {
        translate: 0 0;
        animation-timing-function: var(--ease-standard);
      }

      40% {
        translate: 200% 0;
      }

      41% {
        translate: -200% 0;
        animation-timing-function: var(--ease-out-expo);
      }

      100% {
        translate: 0 0;
      }
    }

    @keyframes button-icon-left {
      0% {
        translate: 0 0;
        animation-timing-function: var(--ease-standard);
      }

      40% {
        translate: -200% 0;
      }

      41% {
        translate: 200% 0;
        animation-timing-function: var(--ease-out-expo);
      }

      100% {
        translate: 0 0;
      }
    }

    @keyframes button-icon-up {
      0% {
        translate: 0 0;
        animation-timing-function: var(--ease-standard);
      }

      40% {
        translate: 0 -200%;
      }

      41% {
        translate: 0 200%;
        animation-timing-function: var(--ease-out-expo);
      }

      100% {
        translate: 0 0;
      }
    }

    @keyframes button-icon-down {
      0% {
        translate: 0 0;
        animation-timing-function: var(--ease-standard);
      }

      40% {
        translate: 0 200%;
      }

      41% {
        translate: 0 -200%;
        animation-timing-function: var(--ease-out-expo);
      }

      100% {
        translate: 0 0;
      }
    }

    .button:disabled {
      cursor: not-allowed;
      opacity: var(--opacity-disabled);
    }
  }
</style>
