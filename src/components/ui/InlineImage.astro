---
/**
 * A small picture set inside a line of text, about as tall as the letters, that zooms well past
 * the line on hover so you can see what's in it. Sized in em, so it follows whatever text it sits
 * in. The zoom is a nicety: the picture already reads without it.
 *
 * `src` is an image (optimised by astro:assets) or, for a GIF, a short muted clip (`mp4` plus an
 * AV1 `webm`, a fraction of an animated WebP's size) and its `still` frame. The still is the
 * poster and nothing else loads up front; the motion layer starts the clip once the page has
 * loaded and plays it only while it is on screen, so GIFs never hold up the hero. With reduced
 * motion or no JS the still stays. `shape` follows the picture: wide, portrait or square.
 */
import { Image } from "astro:assets";

/** A GIF as video: H.264 for every browser, AV1 where supported. */
export interface Clip {
  mp4: string;
  webm: string;
}

interface Props {
  src: ImageMetadata | Clip;
  /** Still frame of an animated `src`, shown with reduced motion. */
  still?: string;
  /** Required. Describe the picture; it is read in the middle of the sentence. */
  alt: string;
  shape?: "wide" | "portrait" | "square";
  /** Framing inside the crop, as object-position (e.g. "50% 30%" for a face). */
  focus?: string;
  class?: string;
  [key: `data-${string}`]: unknown;
}

const {
  src,
  still,
  alt,
  shape = "wide",
  focus = "50% 50%",
  class: className,
  ...attrs
} = Astro.props;
const style = `object-position: ${focus}`;
---

<span
  class:list={["inline-image", `inline-image--${shape}`, className]}
  role={"mp4" in src ? "img" : undefined}
  aria-label={"mp4" in src ? alt : undefined}
  {...attrs}
>
  {"mp4" in src ? (
    <video
      class="inline-image__img"
      poster={still}
      muted
      loop
      playsinline
      disablepictureinpicture
      preload="none"
      aria-hidden="true"
      data-animated
      style={style}
    >
      <source src={src.webm} type='video/webm; codecs="av01.0.05M.08"' />
      <source src={src.mp4} type="video/mp4" />
    </video>
  ) : (
    <Image
      class="inline-image__img"
      src={src}
      alt={alt}
      widths={[240, 480]}
      sizes="14rem"
      fetchpriority="low"
      style={style}
    />
  )}
</span>

<style>
  @layer components {
    .inline-image {
      --inline-image-zoom: 3;

      display: inline-block;
      position: relative;
      inline-size: 1.5em;
      block-size: 1em;
      vertical-align: -0.12em;
      border-radius: var(--radius-sm);
      overflow: hidden;
      background: var(--color-bg-subtle);
      transition:
        transform var(--duration-zoom) var(--ease-out-expo),
        box-shadow var(--duration-zoom) var(--ease-out-expo);
    }

    .inline-image--portrait {
      inline-size: 0.72em;
    }

    .inline-image--square {
      inline-size: 1em;
    }

    .inline-image__img {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }

    .inline-image:hover {
      z-index: 2;
      transform: scale(var(--inline-image-zoom)) rotate(-2deg);
      box-shadow: var(--shadow-bar);
    }

    /* Portrait pictures are narrow, so they can grow further before covering the line. */
    .inline-image--portrait:hover {
      --inline-image-zoom: 4;
    }

    @media (width >= 48em) {
      .inline-image {
        --inline-image-zoom: 4;
      }

      .inline-image--portrait:hover {
        --inline-image-zoom: 5;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .inline-image {
        transition: none;
      }
    }
  }
</style>
