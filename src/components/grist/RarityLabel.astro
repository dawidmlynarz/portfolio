---
/**
 * The tier's icon plus a name, in the small text style and the tier's text colour. The icon is the
 * tile icon or the pixel gem (RARITY_ICON in src/lib/grist.ts); each has its own text colours.
 * Given a drop type it names the type only ("Checklist"), in semibold: icon and colour say the tier.
 * Hidden (locked slots): the [?] tile and the type in the muted colour, so the tier stays a surprise.
 */
import Gem from "./Gem.astro";
import TileIcon from "./TileIcon.astro";
import { DROP_TYPES, RARITY_ICON, RARITY_LABELS, type DropType, type Rarity } from "@/lib/grist";

interface Props {
  rarity: Rarity;
  type?: DropType;
  /** md: a larger icon (1.5em), for cards and the drop page, where the tier should stand out */
  size?: "sm" | "md";
  /** Keep the tier back: the [?] tile instead of the tier's icon and colour. */
  hidden?: boolean;
  class?: string;
}

const { rarity, type, size = "sm", hidden = false, class: className } = Astro.props;
---

<span
  class:list={[
    "rarity-label",
    hidden ? "rarity-label--hidden" : `rarity-label--${rarity}`,
    { "rarity-label--tile": !hidden && (RARITY_ICON === "tile" || rarity === "ultra") },
    className,
  ]}
>
  {hidden ? (
    <TileIcon tier="hidden" size={size} />
  ) : RARITY_ICON === "tile" || rarity === "ultra" ? (
    <TileIcon tier={rarity} size={size} />
  ) : (
    <Gem rarity={rarity} />
  )}
  <span class:list={["rarity-label__name", { "rarity-label__name--type": type }]}>
    {type ? DROP_TYPES[type].label : RARITY_LABELS[rarity]}
  </span>
</span>

<style>
  @layer components {
    .rarity-label {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--rarity-common-text);
    }

    .rarity-label--hidden {
      color: var(--color-text-muted);
    }

    .rarity-label__name--type {
      font-weight: var(--weight-semibold);
    }

    .rarity-label--uncommon {
      color: var(--rarity-uncommon-text);
    }

    .rarity-label--rare {
      color: var(--rarity-rare-text);
    }

    .rarity-label--epic {
      color: var(--rarity-epic-text);
    }

    .rarity-label--legendary {
      color: var(--rarity-legendary-text);
    }

    /* Tile icons: the tier name shares the icon's hue (tokens.css). */
    .rarity-label--tile {
      color: var(--rarity-common-tile-text);
    }

    .rarity-label--tile.rarity-label--uncommon {
      color: var(--rarity-uncommon-tile-text);
    }

    .rarity-label--tile.rarity-label--rare {
      color: var(--rarity-rare-tile-text);
    }

    .rarity-label--tile.rarity-label--epic {
      color: var(--rarity-epic-tile-text);
    }

    .rarity-label--tile.rarity-label--legendary {
      color: var(--rarity-legendary-tile-text);
    }

    .rarity-label--tile.rarity-label--ultra {
      color: var(--rarity-ultra-tile-text);
    }
  }
</style>
