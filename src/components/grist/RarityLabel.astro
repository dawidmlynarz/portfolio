---
/**
 * Gem plus a name, in the small text style and the tier's text colour. Given a drop type it names
 * the type only ("Checklist"), in semibold: the gem and colour already say the tier.
 */
import Gem from "./Gem.astro";
import { DROP_TYPES, RARITY_LABELS, type DropType, type Rarity } from "@/lib/grist";

interface Props {
  rarity: Rarity;
  type?: DropType;
  class?: string;
}

const { rarity, type, class: className } = Astro.props;
---

<span class:list={["rarity-label", `rarity-label--${rarity}`, className]}>
  <Gem rarity={rarity} />
  <span class:list={["rarity-label__name", { "rarity-label__name--type": type }]}>
    {type ? DROP_TYPES[type].label : RARITY_LABELS[rarity]}
  </span>
</span>

<style>
  @layer components {
    .rarity-label {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--rarity-common-text);
    }

    .rarity-label__name--type {
      font-weight: var(--weight-semibold);
    }

    .rarity-label--uncommon {
      color: var(--rarity-uncommon-text);
    }

    .rarity-label--rare {
      color: var(--rarity-rare-text);
    }

    .rarity-label--epic {
      color: var(--rarity-epic-text);
    }

    .rarity-label--legendary {
      color: var(--rarity-legendary-text);
    }
  }
</style>
