---
/**
 * A season's heading on the front door, after Dawid's Figma design (Foundations, "season header").
 * A top row with the season number (an hourglass while it runs, a crown once complete) and, on
 * the right, the count of drops so far plus a reveal strip: one tile per slot, in the tier's colour
 * once it has dropped and the hidden [?] tile until then. Below, the title and one line on the
 * theme, with the season pack on the right (stacked under it on narrow screens). The pack shows
 * locked, dashed and faded, until all eight drops are out, then downloads. Over a 2px rule.
 */
import DownloadButton from "./DownloadButton.astro";
import Icon from "@/components/ui/Icon.astro";
import TileIcon from "./TileIcon.astro";
import { RARITY_LABELS, SEASON_SLOTS, SEASONS, type Rarity, type Season } from "@/lib/grist";
import { dropDay, formatDate, isoDate, seasonPackHref } from "@/lib/drops";

interface Props {
  season: Season;
  /** Each slot's tier once its drop is out, null while it's locked. Empty: the season hasn't started. */
  tiers: readonly (Rarity | null)[];
  /** Offer the season pack once it's complete. Off on the sandbox for packs that aren't built. */
  pack?: boolean;
}

const { season, tiers, pack: hasPack = true } = Astro.props;
const { number, title, blurb } = SEASONS[season];
const slots = Array.from({ length: SEASON_SLOTS }, (_, i) => tiers[i] ?? null);
const unlocked = slots.filter(Boolean).length;
const complete = unlocked >= SEASON_SLOTS;
const href = seasonPackHref(season);
const file = href.split("/").at(-1)!;
const starts = dropDay(season, 1);
const unlocks = dropDay(season, SEASON_SLOTS);
const revealed = slots.map((tier) => (tier ? RARITY_LABELS[tier] : "hidden")).join(", ");
---

<header class="season-header">
  <div class="season-header__top">
    <p class="season-header__status text-caption">
      <Icon name={complete ? "crown" : "hourglass"} />
      <span>Season {number}</span>
    </p>
    <div class="season-header__progress">
      <p class="text-caption">
        {complete ? (
          "Complete"
        ) : unlocked ? (
          `${unlocked}/${SEASON_SLOTS} drops`
        ) : (
          <>
            Starts <time datetime={isoDate(starts)}>{formatDate(starts)}</time>
          </>
        )}
      </p>
      <span class="season-header__reveal" role="img" aria-label={`Drops so far: ${revealed}`}>
        {slots.map((tier) => (
          <TileIcon tier={tier ?? "hidden"} />
        ))}
      </span>
    </div>
  </div>
  <div class="season-header__main">
    <div class="season-header__text">
      <h2 class="season-header__title" id={season}>
        {title}
      </h2>
      <p class="season-header__blurb text-lead">{blurb}</p>
    </div>
    {complete && hasPack ? (
      <DownloadButton href={href} name={file} />
    ) : (
      <p class="season-header__pack">
        <Icon name="lock" />
        <span class="season-header__file">{file}</span>
        <span class="visually-hidden">
          , unlocks on <time datetime={isoDate(unlocks)}>{formatDate(unlocks)}</time>
        </span>
      </p>
    )}
  </div>
</header>

<style>
  @layer components {
    .season-header {
      display: grid;
      gap: var(--space-3);
      padding-block-end: var(--space-6);
      border-block-end: calc(var(--border-width) * 2) solid var(--color-text);
    }

    .season-header__top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2) var(--space-4);
      color: var(--color-text-muted);
    }

    .season-header__status {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
    }

    .season-header__status :global(.icon) {
      font-size: var(--text-body);
    }

    .season-header__progress {
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      margin-inline-start: auto;
    }

    .season-header__reveal {
      display: inline-flex;
      gap: var(--space-1);
      font-size: var(--text-small);
    }

    .season-header__reveal :global(.rarity-icon) {
      inline-size: 1.125em;
      block-size: 1.125em;
    }

    .season-header__main {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4) var(--space-3);
    }

    .season-header__text {
      display: grid;
      flex: 1 1 32rem;
      gap: var(--space-2);
    }

    .season-header__title {
      font-size: var(--text-h3);
      font-weight: var(--weight-heading);
      line-height: var(--leading-h3);
      letter-spacing: var(--tracking-h3);
    }

    .season-header__blurb {
      color: var(--color-text-muted);
    }

    /* The pack, locked: the download button's shape, dashed and in muted text like a locked card.
       Muted text, not opacity, so the file name keeps 4.5:1 against the page. */
    .season-header__pack {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      max-inline-size: 100%;
      padding: var(--space-3) var(--space-6);
      border: var(--border-width) dashed var(--color-border-subtle);
      border-radius: var(--radius-pill);
      color: var(--color-text-muted);
      font-weight: var(--weight-medium);
    }

    .season-header__file {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
