---
/**
 * One drop as a tile, used everywhere drops are listed (front door, See also, styleguide). It sizes
 * itself with a container query: narrow, it stacks (type, title, summary, then the date at the
 * bottom, so tiles in a grid line up); from 48rem wide it becomes a row with the date on the right.
 * The whole tile is the link's hit area.
 *
 * Locked variant (battle pass): a slot whose drop day hasn't come. Dashed border, the planned
 * gem faded, no title, and the day it unlocks. The next one to unlock says so.
 */
import NewBadge from "./NewBadge.astro";
import RarityLabel from "./RarityLabel.astro";
import StatusLabel from "./StatusLabel.astro";
import Icon from "./Icon.astro";
import { DROP_TYPES, SEASONS, type DropType, type Rarity } from "@/lib/grist";
import { derive, dropHref, formatDay, isoDate, type Drop } from "@/lib/drops";

interface Props {
  drop?: Drop;
  /** A locked slot instead of a drop. */
  locked?: { type: DropType; rarity: Rarity; date: Date; next?: boolean; late?: boolean };
  /** Heading level of the title in this page's outline. */
  level?: 2 | 3 | 4;
  /** Show the season (for lists that don't group by it). */
  season?: boolean;
  class?: string;
}

const { drop, locked, level = 3, season = false, class: className } = Astro.props;
const Heading = `h${level}` as "h2" | "h3" | "h4";
const shown = drop && derive(drop);
---

{drop && shown ? (
  <article
    class:list={["drop-card", "drop-card--drop", className]}
    style={`--tier: var(--rarity-${shown.rarity}-icon)`}
  >
    <div class="drop-card__inner">
      <div class="drop-card__main">
        <p class="drop-card__rank">
          <span class="drop-card__tags">
            <RarityLabel rarity={shown.rarity} type={drop.data.drop} size="md" />
            {season && <span class="drop-card__season">{SEASONS[drop.data.season].title}</span>}
          </span>
          {shown.isNew && <NewBadge class="drop-card__new" />}
        </p>
        <Heading class="drop-card__title">
          <a class="drop-card__link" href={dropHref(drop)} data-no-tear>
            {drop.data.title}
          </a>
        </Heading>
        <p class="drop-card__summary">{drop.data.summary}</p>
      </div>
      <ul class="drop-card__meta" role="list">
        <li class="drop-card__fact">
          <Icon name="calendar" size="lg" />
          <time datetime={isoDate(shown.published)}>{formatDay(shown.published)}</time>
        </li>
        <li class="drop-card__fact">
          <StatusLabel status={drop.data.status} />
        </li>
      </ul>
    </div>
  </article>
) : (
  locked && (
    <article
      class:list={["drop-card", "drop-card--locked", { "drop-card--next": locked.next }, className]}
    >
      <div class="drop-card__inner">
        <div class="drop-card__main">
          <p class="drop-card__rank">
            <RarityLabel rarity={locked.rarity} type={locked.type} size="md" />
            {locked.next && <span class="drop-card__next text-caption">Next drop</span>}
          </p>
          <Heading class="drop-card__title drop-card__title--locked">
            <Icon name="lock" />
            Locked
          </Heading>
          <p class="drop-card__summary">
            {locked.late
              ? "Running late. It drops as soon as it’s ready."
              : `A ${DROP_TYPES[locked.type].label.toLowerCase()} unlocks on drop day.`}
          </p>
        </div>
        <ul class="drop-card__meta" role="list">
          <li class="drop-card__fact">
            <Icon name="calendar" size="lg" />
            <time datetime={isoDate(locked.date)}>
              {locked.late ? "Was due" : "Drops"} {formatDay(locked.date)}
            </time>
          </li>
        </ul>
      </div>
    </article>
  )
)}

<style>
  @layer components {
    .drop-card {
      container-type: inline-size;
      position: relative;
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-lg);
      background-color: var(--color-bg);
      transition:
        border-color var(--duration-fast) var(--ease-standard),
        box-shadow var(--duration-fast) var(--ease-standard);
    }

    .drop-card:hover {
      border-color: var(--color-text);
    }

    /*
     * Hover (Dawid's Figma, "cards"): the outline takes the tier colour at 2px (an inset ring on the
     * 1px border, so nothing shifts), a faint tier wash rises to the bottom right, and a soft shadow
     * in the tier colour. On dark the wash and shadow are a little stronger, so the shadow reads as a
     * glow. --hover pins the state (the effects builder).
     */
    .drop-card--drop:is(:hover, .drop-card--hover) {
      border-color: var(--tier);
      background-image: linear-gradient(
        70deg,
        transparent,
        light-dark(
          color-mix(in srgb, var(--tier) 8%, transparent),
          color-mix(in srgb, var(--tier) 12%, transparent)
        )
      );
      box-shadow:
        inset 0 0 0 var(--border-width) var(--tier),
        0 var(--space-1) var(--space-2)
          light-dark(
            color-mix(in srgb, var(--tier) 25%, transparent),
            color-mix(in srgb, var(--tier) 40%, transparent)
          );
    }

    .drop-card:has(.drop-card__link:focus-visible) {
      outline: calc(var(--border-width) * 2) solid var(--color-focus);
      outline-offset: var(--space-1);
    }

    .drop-card__inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      block-size: 100%;
      padding: var(--space-6);
    }

    .drop-card__main {
      display: grid;
      gap: var(--space-2);
    }

    .drop-card__rank {
      display: flex;
      align-items: center;
      gap: var(--space-2) var(--space-3);
      margin-block-end: var(--space-2);
    }

    /* Rarity and season wrap on their own; New keeps the top right corner. */
    .drop-card__tags {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-3);
    }

    .drop-card__rank :global(.drop-card__new) {
      flex: none;
      margin-inline-start: auto;
    }

    .drop-card__season {
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--color-text-muted);
    }

    .drop-card__title {
      font-size: var(--text-h4);
      line-height: var(--leading-h4);
      letter-spacing: var(--tracking-h4);
    }

    .drop-card__link {
      --underline-size: 0%;
    }

    .drop-card:is(:hover, .drop-card--hover) .drop-card__link {
      --underline-size: 100%;
    }

    .drop-card__link:focus-visible {
      outline: none;
    }

    .drop-card__link::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
    }

    .drop-card__summary {
      max-inline-size: var(--measure);
      color: var(--color-text-muted);
    }

    .drop-card__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-6);
      margin-block-start: auto;
      padding: 0;
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--color-text-muted);
    }

    /* Locked: a dashed outline on no fill, the gem faded, nothing to click. */
    .drop-card--locked {
      border-style: dashed;
      border-color: var(--color-border-muted);
      background-color: transparent;
    }

    .drop-card--locked:hover {
      border-color: var(--color-border-muted);
    }

    .drop-card--locked :global(.gem) {
      opacity: 0.45;
    }

    .drop-card--next {
      border-style: solid;
      border-color: var(--color-text);
    }

    .drop-card--next:hover {
      border-color: var(--color-text);
    }

    .drop-card__title--locked {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-muted);
    }

    .drop-card__next {
      padding-inline: var(--space-1) calc(var(--space-1) - var(--tracking-caption));
      border: var(--border-width) solid currentcolor;
      border-radius: var(--radius-sm);
    }

    .drop-card__fact {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      white-space: nowrap;
    }

    /* Wide tile: a row, the meta flowing to the right edge. */
    @container (width >= 48rem) {
      .drop-card__inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--space-8);
      }

      .drop-card__meta {
        flex-wrap: nowrap;
        justify-content: flex-end;
        margin-block-start: 0;
      }
    }
  }
</style>
