---
/**
 * One drop as a tile, used everywhere drops are listed (front door, See also, styleguide). It sizes
 * itself with a container query: narrow, it stacks (rarity and type, title, summary, then date and
 * sightings at the bottom, so tiles in a grid line up); from 48rem wide it becomes a row with them
 * on the right. The whole tile is the link's hit area.
 */
import NewBadge from "./NewBadge.astro";
import RarityLabel from "./RarityLabel.astro";
import Icon from "./Icon.astro";
import { SEASONS } from "@/lib/grist";
import { derive, dropHref, formatDay, isoDate, type Drop } from "@/lib/drops";

interface Props {
  drop: Drop;
  /** Heading level of the title in this page's outline. */
  level?: 2 | 3 | 4;
  /** Show the season (for lists that don't group by it). */
  season?: boolean;
  class?: string;
}

const { drop, level = 3, season = false, class: className } = Astro.props;
const { data } = drop;
const { rarity, isNew } = derive(drop);
const seen = data.sightings.length;
const Heading = `h${level}` as "h2" | "h3" | "h4";
---

<article class:list={["drop-card", className]}>
  <div class="drop-card__inner">
    <div class="drop-card__main">
      <p class="drop-card__rank">
        <RarityLabel rarity={rarity} type={data.drop} />
        {season && <span class="drop-card__season">{SEASONS[data.season].title}</span>}
        {isNew && <NewBadge />}
      </p>
      <Heading class="drop-card__title">
        <a class="drop-card__link" href={dropHref(drop)} data-no-tear>
          {data.title}
        </a>
      </Heading>
      <p class="drop-card__summary">{data.summary}</p>
    </div>
    <ul class="drop-card__meta" role="list">
      <li class="drop-card__fact">
        <Icon name="calendar" />
        <time datetime={isoDate(data.published)}>{formatDay(data.published)}</time>
      </li>
      {seen > 0 && (
        <li class="drop-card__fact">
          <Icon name="eye" />
          Seen {seen}&times;
          <span class="visually-hidden"> in real products</span>
        </li>
      )}
    </ul>
  </div>
</article>

<style>
  @layer components {
    .drop-card {
      container-type: inline-size;
      position: relative;
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-lg);
      background-color: var(--color-bg);
      transition: border-color var(--duration-fast) var(--ease-standard);
    }

    .drop-card:hover {
      border-color: var(--color-text);
    }

    .drop-card:has(.drop-card__link:focus-visible) {
      outline: calc(var(--border-width) * 2) solid var(--color-focus);
      outline-offset: var(--space-1);
    }

    .drop-card__inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      block-size: 100%;
      padding: var(--space-6);
    }

    .drop-card__main {
      display: grid;
      gap: var(--space-2);
    }

    .drop-card__rank {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-3);
      margin-block-end: var(--space-2);
    }

    .drop-card__season {
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--color-text-muted);
    }

    .drop-card__title {
      font-size: var(--text-h4);
      line-height: var(--leading-h4);
      letter-spacing: var(--tracking-h4);
    }

    .drop-card__link {
      --underline-size: 0%;
    }

    .drop-card:hover .drop-card__link {
      --underline-size: 100%;
    }

    .drop-card__link:focus-visible {
      outline: none;
    }

    .drop-card__link::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
    }

    .drop-card__summary {
      max-inline-size: var(--measure);
      color: var(--color-text-muted);
    }

    .drop-card__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-6);
      margin-block-start: auto;
      padding: 0;
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--color-text-muted);
    }

    .drop-card__fact {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      white-space: nowrap;
    }

    /* Wide tile: a row, the meta flowing to the right edge. */
    @container (width >= 48rem) {
      .drop-card__inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--space-8);
      }

      .drop-card__meta {
        flex-wrap: nowrap;
        justify-content: flex-end;
        margin-block-start: 0;
      }
    }
  }
</style>
