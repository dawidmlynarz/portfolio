---
/**
 * The "human curated" stamp: HUMAN CURATED runs twice round a circle and turns slowly, around the
 * site's mark in a black circle (the nav's). It's Grist's signature for the pitch, so it sits in
 * two places only: the front door hero (lg) and the corner of each drop (sm). Plain SVG and a CSS
 * turn; it pauses on hover and stands still under reduced motion. The words are for sighted
 * readers only, so it carries an accessible name instead.
 */
import { MARK_PATH } from "@/lib/site";

interface Props {
  size?: "sm" | "lg";
  class?: string;
}

const { size = "lg", class: className } = Astro.props;
const WORDS = "Human curated • Human curated • ";
// The text circle's radius in the 120-unit viewBox; textLength fits the words to its whole length.
const R = 47;
const ring = `M60 ${60 - R}a${R} ${R} 0 1 1 0 ${2 * R}a${R} ${R} 0 1 1 0 -${2 * R}`;
const pathId = `stamp-ring-${crypto.randomUUID().slice(0, 8)}`;
---

<span
  class:list={["human-stamp", `human-stamp--${size}`, className]}
  role="img"
  aria-label="Human curated"
>
  <svg class="human-stamp__ring" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <defs>
      <path id={pathId} d={ring} />
    </defs>
    <text class="human-stamp__words" font-size="11">
      <textPath
        href={`#${pathId}`}
        textLength={(2 * Math.PI * R).toFixed(1)}
        lengthAdjust="spacing"
      >
        {WORDS}
      </textPath>
    </text>
  </svg>
  <span class="human-stamp__mark" aria-hidden="true">
    <svg viewBox="0 0 32 24" focusable="false">
      <path d={MARK_PATH} />
    </svg>
  </span>
</span>

<style>
  @layer components {
    .human-stamp {
      --stamp-size: calc(var(--space-24) * 2);

      position: relative;
      display: inline-grid;
      flex: none;
      place-items: center;
      inline-size: var(--stamp-size);
      aspect-ratio: 1;
      border: var(--border-width) solid var(--color-text);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background-color: var(--color-bg);
    }

    .human-stamp--sm {
      --stamp-size: var(--space-24);
    }

    .human-stamp__ring,
    .human-stamp__mark {
      grid-area: 1 / 1;
    }

    .human-stamp__ring {
      inline-size: 100%;
      block-size: 100%;
      overflow: visible;
    }

    .human-stamp__words {
      font-family: var(--font-body);
      font-weight: var(--weight-medium);
      text-transform: uppercase;
      fill: currentcolor;
    }

    /* The nav's mark: a black disc (white in dark mode) with the M in the page colour. */
    .human-stamp__mark {
      display: grid;
      place-items: center;
      inline-size: 58%;
      aspect-ratio: 1;
      border-radius: var(--radius-pill);
      background-color: var(--color-text);
    }

    .human-stamp__mark svg {
      inline-size: 50%;
      block-size: auto;
      fill: var(--color-bg);
    }

    @media (prefers-reduced-motion: no-preference) {
      .human-stamp__ring {
        animation: human-stamp-turn var(--duration-stamp) linear infinite;
      }

      .human-stamp:hover .human-stamp__ring {
        animation-play-state: paused;
      }
    }

    @keyframes human-stamp-turn {
      to {
        rotate: 1turn;
      }
    }
  }
</style>
