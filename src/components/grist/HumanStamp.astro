---
/**
 * The "human curated" stamp: the words run round a circle and turn slowly, with a gem in the
 * middle. It's Grist's signature for the pitch (human-written loot for AI tools), so it sits in two
 * places only: the front door hero (lg) and the corner of each drop (sm). Plain SVG and a CSS turn;
 * it pauses on hover and stands still under reduced motion. The words are for sighted readers
 * only, so it carries an accessible name instead.
 */
import Gem from "./Gem.astro";
import type { Rarity } from "@/lib/grist";

interface Props {
  size?: "sm" | "lg";
  rarity?: Rarity;
  class?: string;
}

const { size = "lg", rarity = "legendary", class: className } = Astro.props;
const WORDS = "Human curated · Human written · ";
// The text circle's radius in the 120-unit viewBox; textLength fits the words to its whole length.
const R = 47;
const ring = `M60 ${60 - R}a${R} ${R} 0 1 1 0 ${2 * R}a${R} ${R} 0 1 1 0 -${2 * R}`;
const pathId = `stamp-ring-${crypto.randomUUID().slice(0, 8)}`;
---

<span
  class:list={["human-stamp", `human-stamp--${size}`, className]}
  role="img"
  aria-label="Human curated, human written"
>
  <svg class="human-stamp__ring" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <defs>
      <path id={pathId} d={ring} />
    </defs>
    <circle class="human-stamp__rule" cx="60" cy="60" r="35" />
    <text class="human-stamp__words" font-size="10.5">
      <textPath
        href={`#${pathId}`}
        textLength={(2 * Math.PI * R).toFixed(1)}
        lengthAdjust="spacing"
      >
        {WORDS}
      </textPath>
    </text>
  </svg>
  <span class="human-stamp__gem" aria-hidden="true">
    <Gem rarity={rarity} />
  </span>
</span>

<style>
  @layer components {
    .human-stamp {
      --stamp-size: calc(var(--space-24) * 2);

      position: relative;
      display: inline-grid;
      flex: none;
      place-items: center;
      inline-size: var(--stamp-size);
      aspect-ratio: 1;
      border: var(--border-width) solid var(--color-text);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background-color: var(--color-bg);
    }

    .human-stamp--sm {
      --stamp-size: var(--space-24);
    }

    .human-stamp__ring,
    .human-stamp__gem {
      grid-area: 1 / 1;
    }

    .human-stamp__ring {
      inline-size: 100%;
      block-size: 100%;
      overflow: visible;
    }

    .human-stamp__rule {
      fill: none;
      stroke: currentcolor;
      stroke-width: 0.75;
    }

    .human-stamp__words {
      font-family: var(--font-body);
      font-weight: var(--weight-medium);
      text-transform: uppercase;
      fill: currentcolor;
    }

    /* The gem scales with the stamp, a quarter of its height. */
    .human-stamp__gem :global(.gem) {
      inline-size: auto;
      block-size: 25%;
    }

    .human-stamp__gem {
      display: grid;
      place-items: center;
      inline-size: 100%;
      block-size: 100%;
    }

    @media (prefers-reduced-motion: no-preference) {
      .human-stamp__ring {
        animation: human-stamp-turn var(--duration-stamp) linear infinite;
      }

      .human-stamp:hover .human-stamp__ring {
        animation-play-state: paused;
      }
    }

    @keyframes human-stamp-turn {
      to {
        rotate: 1turn;
      }
    }
  }
</style>
