---
/**
 * One quest as a tile, used everywhere quests are listed (front door, See also). It sizes itself
 * with a container query: narrow, it stacks (rarity, title, summary, then status and date at the
 * bottom, so tiles in a grid line up); from 48rem wide it becomes a row with them on the right.
 * The whole tile is the link's hit area.
 */
import NewBadge from "./NewBadge.astro";
import QuestTag from "./QuestTag.astro";
import RarityLabel from "./RarityLabel.astro";
import Icon from "./Icon.astro";
import { VOLUMES } from "@/lib/grist";
import { derive, isoDate, questHref, type Quest } from "@/lib/quests";

interface Props {
  quest: Quest;
  /** Heading level of the title in this page's outline. */
  level?: 2 | 3 | 4;
  /** Show the category (for lists that don't group by it). */
  category?: boolean;
  /** Larger title and the full definition instead of the summary. */
  featured?: boolean;
  class?: string;
}

const { quest, level = 3, category = false, featured = false, class: className } = Astro.props;
const { data } = quest;
const { rarity, dateLabel, updated, isNew } = derive(quest);
const Heading = `h${level}` as "h2" | "h3" | "h4";
---

<article class:list={["quest-card", { "quest-card--featured": featured }, className]}>
  <div class="quest-card__inner">
    <div class="quest-card__main">
      <p class="quest-card__rank">
        <RarityLabel rarity={rarity} />
        {category && <span class="quest-card__category">{VOLUMES[data.volume].title}</span>}
        {isNew && <NewBadge />}
      </p>
      <Heading class="quest-card__title">
        <a class="quest-card__link" href={questHref(quest)} data-no-tear>
          {data.title}
        </a>
      </Heading>
      <p class="quest-card__summary">
        {featured ? data.definition : (data.summary ?? data.definition)}
      </p>
    </div>
    <ul class="quest-card__meta" role="list">
      <li>
        <QuestTag status={data.status} />
      </li>
      <li class="quest-card__date">
        <Icon name="calendar" />
        <time datetime={isoDate(updated)}>{dateLabel}</time>
      </li>
    </ul>
  </div>
</article>

<style>
  @layer components {
    .quest-card {
      container-type: inline-size;
      position: relative;
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-lg);
      background-color: var(--color-bg);
      transition: border-color var(--duration-fast) var(--ease-standard);
    }

    .quest-card:hover {
      border-color: var(--color-text);
    }

    .quest-card:has(.quest-card__link:focus-visible) {
      outline: calc(var(--border-width) * 2) solid var(--color-focus);
      outline-offset: var(--space-1);
    }

    .quest-card__inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      block-size: 100%;
      padding: var(--space-6);
    }

    .quest-card__main {
      display: grid;
      gap: var(--space-2);
    }

    .quest-card__rank {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-3);
      margin-block-end: var(--space-2);
    }

    .quest-card__category {
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--color-text-muted);
    }

    .quest-card__title {
      font-size: var(--text-h4);
      line-height: var(--leading-h4);
      letter-spacing: var(--tracking-h4);
    }

    .quest-card--featured .quest-card__title {
      font-size: var(--text-h3);
      line-height: var(--leading-h3);
      letter-spacing: var(--tracking-h3);
    }

    .quest-card__link {
      --underline-size: 0%;
    }

    .quest-card:hover .quest-card__link {
      --underline-size: 100%;
    }

    .quest-card__link:focus-visible {
      outline: none;
    }

    .quest-card__link::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
    }

    .quest-card__summary {
      max-inline-size: var(--measure);
      color: var(--color-text-muted);
    }

    .quest-card__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-6);
      margin-block-start: auto;
      padding: 0;
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--color-text-muted);
    }

    .quest-card__date {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      white-space: nowrap;
    }

    /* Wide tile: a row, the meta flowing to the right edge. */
    @container (width >= 48rem) {
      .quest-card__inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--space-8);
      }

      .quest-card__meta {
        flex-wrap: nowrap;
        justify-content: flex-end;
        margin-block-start: 0;
      }
    }
  }
</style>
