---
/**
 * Preview only (GristLayout leaves it out of production): switches the drop pages' hero grain
 * between the rarity colour and the neutral grey, so the two can be compared. The choice sits on
 * <html data-grain="neutral"> and is remembered in this browser. HeroBackdrop reads it.
 */
---

<button class="grain-toggle" type="button" aria-pressed="true" data-grain-toggle>
  Colour grain
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    let neutral = false;
    try {
      neutral = localStorage.getItem("grain") === "neutral";
    } catch {}
    const sync = () => {
      if (neutral) root.dataset.grain = "neutral";
      else delete root.dataset.grain;
      document.querySelectorAll("[data-grain-toggle]").forEach((button) => {
        button.setAttribute("aria-pressed", String(!neutral));
        button.textContent = neutral ? "Grey grain" : "Colour grain";
      });
    };
    sync();
    document.addEventListener("click", (event) => {
      if (!event.target.closest?.("[data-grain-toggle]")) return;
      neutral = !neutral;
      try {
        localStorage.setItem("grain", neutral ? "neutral" : "colour");
      } catch {}
      sync();
    });
  })();
</script>

<style>
  @layer components {
    /* Drawn like the Readme link next to it. */
    .grain-toggle {
      padding: 0;
      border: 0;
      font: inherit;
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: inherit;
      background: linear-gradient(currentcolor, currentcolor) no-repeat left bottom / 100%
        var(--border-width);
      cursor: pointer;
    }

    .grain-toggle:hover {
      color: var(--color-text-muted);
    }
  }
</style>
