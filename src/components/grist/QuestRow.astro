---
/**
 * One quest on the front door. Desktop: gem, title and New over the summary on the left; status,
 * type and date in fixed columns on the right. Mobile: the meta wraps under the summary.
 */
import Gem from "./Gem.astro";
import NewBadge from "./NewBadge.astro";
import QuestTag from "./QuestTag.astro";
import { RARITY_LABELS } from "@/lib/grist";
import { derive, isoDate, questHref, type Quest } from "@/lib/quests";

interface Props {
  quest: Quest;
}

const { quest } = Astro.props;
const { data } = quest;
const { rarity, dateLabel, updated, isNew } = derive(quest);
---

<article class="quest-row">
  <div class="quest-row__main">
    <h3 class="quest-row__title">
      <Gem rarity={rarity} class="quest-row__gem" />
      <a class="quest-row__link" href={questHref(quest)} data-no-tear>
        {data.title}
        <span class="visually-hidden">, {RARITY_LABELS[rarity]}</span>
      </a>
      {isNew && <NewBadge />}
    </h3>
    <p class="quest-row__summary">{data.summary ?? data.definition}</p>
  </div>
  <div class="quest-row__meta">
    <QuestTag status={data.status} />
    <QuestTag type={data.type} />
    <time class="quest-row__date" datetime={isoDate(updated)}>
      {dateLabel}
    </time>
  </div>
</article>

<style>
  @layer components {
    .quest-row {
      position: relative;
      display: grid;
      gap: var(--space-3) var(--space-8);
      padding-block: var(--space-6);
      border-block-end: var(--border-width) solid var(--color-border-subtle);
    }

    .quest-row__title {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-3);
      font-size: var(--text-h4);
      line-height: var(--leading-h4);
      letter-spacing: var(--tracking-h4);
    }

    .quest-row__link {
      --underline-size: 0%;
    }

    /* The whole row is the link's hit area. */
    .quest-row__link::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    .quest-row__link:focus-visible {
      outline: none;
    }

    .quest-row:has(.quest-row__link:focus-visible) {
      outline: calc(var(--border-width) * 2) solid var(--color-focus);
      outline-offset: var(--space-1);
    }

    .quest-row:hover .quest-row__link {
      --underline-size: 100%;
    }

    .quest-row__summary {
      margin-block-start: var(--space-1);
      padding-inline-start: calc(var(--space-6) + var(--space-3));
      color: var(--color-text-muted);
    }

    .quest-row__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-6);
      padding-inline-start: calc(var(--space-6) + var(--space-3));
      font: var(--weight-regular) var(--text-caption) / var(--leading-caption) var(--font-mono);
      color: var(--color-text-muted);
    }

    @media (width >= 64em) {
      .quest-row {
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
      }

      /* Fixed columns, so rows line up and counts arriving later shift nothing. */
      .quest-row__meta {
        display: grid;
        grid-template-columns: 9rem 8rem 9rem;
        padding-inline-start: 0;
      }

      .quest-row__date {
        text-align: end;
      }
    }
  }
</style>
