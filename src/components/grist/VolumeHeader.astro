---
/** A volume's title over a 2px rule. */
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<h2 class="volume-header" id={id}>
  {title}
</h2>

<style>
  @layer components {
    .volume-header {
      max-inline-size: none;
      padding-block-end: var(--space-3);
      border-block-end: calc(var(--border-width) * 2) solid var(--color-text);
      font-size: var(--text-h3);
      line-height: var(--leading-h3);
      letter-spacing: var(--tracking-h3);
    }
  }
</style>
