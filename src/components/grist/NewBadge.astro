---
/** "New" for drops published in the last two weeks: inverse surface, caption face, a light sweep. */
---

<span class="new-badge text-caption">New</span>

<style>
  @layer components {
    .new-badge {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      overflow: clip;

      /* The caption's tracking also follows the last letter; the end padding gives it back, so the
         word sits dead centre. */
      padding-block: 0;
      padding-inline: var(--space-1) calc(var(--space-1) - var(--tracking-caption));
      border-radius: var(--radius-sm);
      vertical-align: middle;
      color: var(--color-on-inverse);
      background-color: var(--color-inverse-bg);
    }

    /* The Legendary gem's sweep: a pale band crosses the badge every 2.4s. */
    @media (prefers-reduced-motion: no-preference) {
      .new-badge::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          100deg,
          transparent 35%,
          color-mix(in srgb, var(--color-on-inverse) 45%, transparent) 50%,
          transparent 65%
        );
        translate: -100% 0;
        animation: new-badge-sweep 2.4s var(--ease-standard) infinite;
      }
    }

    @keyframes new-badge-sweep {
      60%,
      100% {
        translate: 100% 0;
      }
    }
  }
</style>
