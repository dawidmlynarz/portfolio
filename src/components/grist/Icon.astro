---
/**
 * Grist's line icons, drawn in the site's icon style (24px grid, 1.75 stroke, round caps and
 * joins, currentColor), like the ones in Button. Shapes follow Lucide (ISC). Decorative unless a
 * label is given. The gems are the only pixel art on Grist.
 */
const ICONS = {
  lightbulb: [
    "M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5",
    "M9 18h6",
    "M10 22h4",
  ],
  lock: [
    "M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2Z",
    "M7 11V7a5 5 0 0 1 10 0v4",
  ],
  calendar: [
    "M8 2v4",
    "M16 2v4",
    "M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z",
    "M3 10h18",
  ],
  "arrow-left": ["M19 12H5", "M11 6l-6 6 6 6"],
  close: ["M18 6 6 18", "M6 6l12 12"],
  "circle-check": ["M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20Z", "m9 12 2 2 4-4"],
  flask: [
    "M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2",
    "M6.453 15h11.094",
    "M8.5 2h7",
  ],
};
export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  /** Accessible name. Without it the icon is hidden from assistive tech. */
  label?: string;
  /** md: 1em, the text's size · lg: 1.25em, for meta rows (date, status) and the back arrow */
  size?: "md" | "lg";
  class?: string;
}

const { name, label, size = "md", class: className } = Astro.props;
---

<svg
  class:list={["icon", { "icon--lg": size === "lg" }, className]}
  viewBox="0 0 24 24"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  {ICONS[name].map((d) => (
    <path d={d} />
  ))}
</svg>

<style>
  @layer components {
    .icon {
      flex: none;
      inline-size: 1em;
      block-size: 1em;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .icon--lg {
      inline-size: 1.25em;
      block-size: 1.25em;
    }
  }
</style>
