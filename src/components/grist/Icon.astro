---
/**
 * Pixelarticons (MIT, Gerrit Halfmann), inlined so they take currentColor. 16px by default, kept
 * on whole pixels with crispEdges. Decorative unless a label is given.
 */
import arrowLeft from "pixelarticons/svg/arrow-left.svg?raw";
import arrowRight from "pixelarticons/svg/arrow-right.svg?raw";
import bookOpen from "pixelarticons/svg/book-open.svg?raw";
import braces from "pixelarticons/svg/braces.svg?raw";
import close from "pixelarticons/svg/close.svg?raw";
import download from "pixelarticons/svg/download.svg?raw";
import feather from "pixelarticons/svg/feather.svg?raw";
import infoBox from "pixelarticons/svg/info-box.svg?raw";
import leaf from "pixelarticons/svg/leaf.svg?raw";
import link from "pixelarticons/svg/link.svg?raw";
import menu from "pixelarticons/svg/menu.svg?raw";
import play from "pixelarticons/svg/play.svg?raw";
import pointer from "pixelarticons/svg/pointer.svg?raw";
import shield from "pixelarticons/svg/shield.svg?raw";

const ICONS = {
  "arrow-left": arrowLeft,
  "arrow-right": arrowRight,
  "book-open": bookOpen,
  braces,
  close,
  download,
  feather,
  "info-box": infoBox,
  leaf,
  link,
  menu,
  play,
  pointer,
  shield,
};
export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  /** Accessible name. Without it the icon is hidden from assistive tech. */
  label?: string;
  class?: string;
}

const { name, label, class: className } = Astro.props;
// Keep only the drawing; the wrapper below sets size, colour and accessibility.
const paths = ICONS[name].replace(/^[\s\S]*?<svg[^>]*>|<\/svg>\s*$/g, "");
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 24 24"
  fill="currentColor"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={paths}
/>

<style>
  @layer components {
    .icon {
      flex: none;
      inline-size: 1em;
      block-size: 1em;
      shape-rendering: crispedges;
    }
  }
</style>
