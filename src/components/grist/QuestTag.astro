---
/** Status: a line icon and its label, in the small text style (as RarityLabel). */
import Icon from "./Icon.astro";
import { STATUSES, type Status } from "@/lib/grist";

interface Props {
  status: Status;
}

const { status } = Astro.props;
const { label, icon } = STATUSES[status];
---

<span class="quest-tag">
  <Icon name={icon} />
  {label}
</span>

<style>
  @layer components {
    .quest-tag {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--text-small);
      line-height: var(--leading-small);
      white-space: nowrap;
    }
  }
</style>
