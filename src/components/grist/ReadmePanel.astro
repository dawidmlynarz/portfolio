---
/**
 * The README: what Grist is, who curates it, and what each rarity
 * means. A native popover (Escape and light dismiss close it, focus returns to the button), drawn as
 * a 2px box with a hard ink shadow.
 */
import Icon from "./Icon.astro";
import RarityLabel from "./RarityLabel.astro";
import { RARITIES, RARITY_INFO } from "@/lib/grist";

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="readme" id={id} popover aria-labelledby={`${id}-title`}>
  <div class="readme__head">
    <h2 class="readme__title" id={`${id}-title`}>
      Readme
    </h2>
    <button
      class="readme__close"
      type="button"
      popovertarget={id}
      popovertargetaction="hide"
      aria-label="Close"
    >
      <Icon name="close" />
    </button>
  </div>
  <div class="readme__body">
    <section>
      <h3 class="readme__label text-caption">What this is</h3>
      <div class="readme__prose">
        <p>
          Stuff I use with AI on real design work: rules, prompts, checklists, specs and skills.
          Each drop has a short why and the file you paste into Claude, Cursor or a CLAUDE.md.
        </p>
        <p>
          Eight drops a season, one every Friday. Tested means I've used it on real work, Trying
          means I'm still testing it. The ideas are mine; Claude helps format the files. Add
          <code>.md</code> to any address for plain markdown.
        </p>
      </div>
    </section>
    <section>
      <h3 class="readme__label text-caption">Rarity</h3>
      <p class="readme__note">
        Rarity is how deep a drop goes. Higher tiers take more setup and give you more.
      </p>
      <dl class="readme__tiers">
        {RARITIES.map((rarity) => (
          <div class="readme__tier">
            <dt>
              <RarityLabel rarity={rarity} />
            </dt>
            <dd>{RARITY_INFO[rarity].note}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</div>

<style>
  @layer components {
    .readme {
      inline-size: min(100% - 2 * var(--gutter), 45rem);
      max-block-size: calc(100svh - 2 * var(--space-8));
      margin: auto;
      padding: var(--space-6);
      border: calc(var(--border-width) * 2) solid var(--color-text);
      color: var(--color-text);
      background-color: var(--color-bg);
      box-shadow: var(--space-2) var(--space-2) 0 var(--color-text);
    }

    .readme::backdrop {
      background-color: var(--color-scrim);
    }

    .readme__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-block-end: var(--space-4);
      border-block-end: var(--border-width) solid var(--color-text);
    }

    .readme__title {
      font-size: var(--text-h4);
      line-height: var(--leading-h4);
      letter-spacing: var(--tracking-h4);
    }

    .readme__close {
      display: grid;
      place-items: center;
      inline-size: var(--space-10);
      block-size: var(--space-10);
      margin: calc(var(--space-2) * -1);
      padding: 0;
      border: 0;
      border-radius: var(--radius-pill);
      font-size: var(--text-lead);
      color: inherit;
      background: none;
      cursor: pointer;
    }

    .readme__close:hover {
      background-color: var(--color-bg-subtle);
    }

    .readme__body {
      display: grid;
      gap: var(--space-8);
      padding-block-start: var(--space-6);
    }

    .readme__label {
      margin-block-end: var(--space-4);
      color: var(--color-text-muted);
    }

    .readme__prose {
      display: grid;
      gap: var(--space-3);
      font-size: var(--text-small);
      line-height: var(--leading-small);
    }

    .readme__note {
      margin-block-end: var(--space-4);
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--color-text-muted);
    }

    .readme__tiers {
      display: grid;
      gap: var(--space-4);
    }

    .readme__tier {
      display: grid;
      gap: var(--space-1);
      font-size: var(--text-small);
      line-height: var(--leading-small);
    }

    .readme__tier dd {
      color: var(--color-text-muted);
    }

    @media (width >= 48em) {
      .readme {
        padding: var(--space-8);
      }

      .readme__body {
        grid-template-columns: 1fr 1fr;
        gap: var(--space-12);
      }
    }
  }
</style>
