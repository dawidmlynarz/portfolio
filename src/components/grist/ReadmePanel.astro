---
/**
 * The README: what the statuses and rarity tiers mean. A native popover (Escape and light dismiss
 * close it, focus returns to the button), drawn as a 2px box with a hard ink shadow.
 */
import Icon from "./Icon.astro";
import RarityLabel from "./RarityLabel.astro";
import { RARITIES, STATUSES, type Status } from "@/lib/grist";

interface Props {
  id: string;
}

const { id } = Astro.props;
const STATUS_NOTES: Record<Status, string> = {
  fresh: "a new idea, still growing",
  "battle-tested": "used on real projects and held up",
};
const TIER_NOTES = ["Just planted", "1 level-up", "2 level-ups", "3 level-ups", "4 level-ups"];
---

<div class="readme" id={id} popover aria-labelledby={`${id}-title`}>
  <div class="readme__head">
    <h2 class="readme__title" id={`${id}-title`}>
      Readme
    </h2>
    <button
      class="readme__close"
      type="button"
      popovertarget={id}
      popovertargetaction="hide"
      aria-label="Close"
    >
      <Icon name="close" />
    </button>
  </div>
  <div class="readme__body">
    <section>
      <h3 class="readme__label text-caption">Status</h3>
      <dl class="readme__statuses">
        {(Object.keys(STATUSES) as Status[]).map((status) => (
          <div class="readme__status">
            <Icon name={STATUSES[status].icon} />
            <dt>{STATUSES[status].label}</dt>
            <dd>{STATUS_NOTES[status]}</dd>
          </div>
        ))}
      </dl>
    </section>
    <section>
      <h3 class="readme__label text-caption">Rarity</h3>
      <p class="readme__note">
        Quests get rarer as they grow: a runnable demo, real examples, known issues, a change of
        mind. Small edits don’t count.
      </p>
      <dl class="readme__tiers">
        {RARITIES.map((rarity, i) => (
          <div class="readme__tier">
            <dt>
              <RarityLabel rarity={rarity} />
            </dt>
            <dd>{TIER_NOTES[i]}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</div>

<style>
  @layer components {
    .readme {
      inline-size: min(100% - 2 * var(--gutter), 45rem);
      max-block-size: calc(100svh - 2 * var(--space-8));
      margin: auto;
      padding: var(--space-6);
      border: calc(var(--border-width) * 2) solid var(--color-text);
      color: var(--color-text);
      background-color: var(--color-bg);
      box-shadow: var(--space-2) var(--space-2) 0 var(--color-text);
    }

    .readme::backdrop {
      background-color: var(--color-scrim);
    }

    .readme__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-block-end: var(--space-4);
      border-block-end: var(--border-width) solid var(--color-text);
    }

    .readme__title {
      font-size: var(--text-h4);
      line-height: var(--leading-h4);
      letter-spacing: var(--tracking-h4);
    }

    .readme__close {
      display: grid;
      place-items: center;
      inline-size: var(--space-10);
      block-size: var(--space-10);
      margin: calc(var(--space-2) * -1);
      padding: 0;
      border: 0;
      border-radius: var(--radius-pill);
      font-size: var(--text-lead);
      color: inherit;
      background: none;
      cursor: pointer;
    }

    .readme__close:hover {
      background-color: var(--color-bg-subtle);
    }

    .readme__body {
      display: grid;
      gap: var(--space-8);
      padding-block-start: var(--space-6);
    }

    .readme__label {
      margin-block-end: var(--space-4);
      color: var(--color-text-muted);
    }

    .readme__statuses {
      display: grid;
      gap: var(--space-4);
    }

    .readme__status {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: var(--space-3);
      align-items: center;
    }

    .readme__status dt {
      font-weight: var(--weight-medium);
    }

    .readme__status dd {
      grid-column: 2;
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--color-text-muted);
    }

    .readme__note {
      margin-block-end: var(--space-4);
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--color-text-muted);
    }

    .readme__tiers {
      display: grid;
      gap: var(--space-3);
    }

    .readme__tier {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      font-size: var(--text-small);
    }

    .readme__tier dd {
      color: var(--color-text-muted);
    }

    @media (width >= 48em) {
      .readme {
        padding: var(--space-8);
      }

      .readme__body {
        grid-template-columns: 1fr 1fr;
        gap: var(--space-12);
      }
    }
  }
</style>
