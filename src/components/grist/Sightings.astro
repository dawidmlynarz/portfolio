---
/** Where the pattern turned up in real products, newest first: date, product (linked when there's a source) and one line. */
import Link from "@/components/ui/Link.astro";
import { derive, formatDate, isoDate, type Drop } from "@/lib/drops";

interface Props {
  drop: Drop;
  id?: string;
}

const { drop, id = "sightings" } = Astro.props;
const { sightings } = derive(drop);
---

<section class="sightings" aria-labelledby={id}>
  <h2 class="sightings__title" id={id}>
    Sightings
  </h2>
  {sightings.length > 0 ? (
    <ol class="sightings__list" role="list">
      {sightings.map((sighting) => (
        <li class="sightings__item">
          <p class="sightings__what">
            <span class="sightings__product">
              {sighting.url ? (
                <Link href={sighting.url}>{sighting.product}</Link>
              ) : (
                sighting.product
              )}
            </span>
            {sighting.note}
          </p>
          <time class="sightings__date" datetime={isoDate(sighting.date)}>
            {formatDate(sighting.date)}
          </time>
        </li>
      ))}
    </ol>
  ) : (
    <p class="sightings__empty">
      Not spotted in the wild yet. I log it here when I see it in a real product.
    </p>
  )}
</section>

<style>
  @layer components {
    .sightings__title {
      margin-block-end: var(--space-4);
      font-size: var(--text-h3);
      line-height: var(--leading-h3);
      letter-spacing: var(--tracking-h3);
    }

    .sightings__list {
      padding: 0;
      border-block-start: var(--border-width) solid var(--color-border-subtle);
    }

    .sightings__item {
      display: grid;
      gap: var(--space-1) var(--space-4);
      align-items: center;
      padding-block: var(--space-3);
      border-block-end: var(--border-width) solid var(--color-border-subtle);
      font-size: var(--text-small);
      line-height: var(--leading-small);
    }

    .sightings__product {
      margin-inline-end: var(--space-2);
      font-weight: var(--weight-medium);
    }

    .sightings__date,
    .sightings__empty {
      color: var(--color-text-muted);
    }

    .sightings__empty {
      font-size: var(--text-small);
      line-height: var(--leading-small);
    }

    @media (width >= 48em) {
      .sightings__item {
        grid-template-columns: 1fr auto;
      }
    }
  }
</style>
