---
/**
 * Home hero (layout from the original site): copy on the left, aligned to the page container;
 * the liquid portrait fills the right column to the viewport edge and the full hero height.
 * Tablet: 44/56 split. Mobile: copy, then a tall full-bleed portrait. Client logos sit below.
 */
import Container from "@/components/layout/Container.astro";
import LiquidReveal from "@/components/blocks/LiquidReveal.astro";
import portraitPhoto from "@/assets/portrait/portrait-photo.png";
import portraitClay from "@/assets/portrait/portrait-clay.png";

interface Props {
  title: string;
  lead: string;
}

const { title, lead } = Astro.props;
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__grid">
    <div class="home-hero__copy">
      <h1 id="home-hero-title">{title}</h1>
      <p class="text-lead home-hero__lead">{lead}</p>
      <div class="home-hero__actions">
        <slot name="actions" />
      </div>
    </div>
    <div class="home-hero__media">
      <LiquidReveal
        photo={portraitPhoto}
        clay={portraitClay}
        alt="Portrait of Dawid Młynarz as a white clay sculpture"
        fit="fill"
        sizes="(min-width: 62em) 60vw, (min-width: 48em) 56vw, 100vw"
      />
    </div>
  </div>
  <Container class="home-hero__after">
    <slot name="after" />
  </Container>
</section>

<style>
  @layer components {
    .home-hero__grid {
      display: grid;
    }

    .home-hero__copy {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: var(--space-6);
      padding: var(--space-8) var(--gutter) var(--space-6);
    }

    .home-hero__copy > * {
      max-inline-size: 35rem;
    }

    .home-hero__lead {
      color: var(--color-text-muted);
    }

    .home-hero__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3) var(--space-6);
      padding-block-start: var(--space-2);
    }

    /* Mobile: a tall, full-bleed portrait under the copy. */
    .home-hero__media {
      block-size: max(62svh, 27.5rem);
    }

    .home-hero__after {
      padding-block: var(--space-6);
    }

    @media (width >= 48em) {
      .home-hero__grid {
        grid-template-columns: 44fr 56fr;
        min-block-size: 70svh;
      }

      .home-hero__copy {
        padding-block: var(--space-12);
      }

      .home-hero__media {
        block-size: auto;
      }
    }

    /* Desktop: the copy column ends 30rem right of the container's left edge (at least 40%). */
    @media (width >= 62em) {
      .home-hero__grid {
        grid-template-columns: max(40%, calc((100vw - var(--container-max)) / 2 + 30rem)) 1fr;
        min-block-size: 85svh;
      }

      .home-hero__copy {
        padding-inline: max(var(--gutter), calc((100vw - var(--container-max)) / 2)) var(--space-10);
      }
    }
  }
</style>
