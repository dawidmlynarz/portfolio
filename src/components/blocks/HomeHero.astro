---
/**
 * Home hero: a two-tone headline at the bottom of the first screen, the liquid portrait filling
 * the right half to the viewport edges (the floating nav runs over it).
 * Tablet: 44/56 split. Mobile: copy under the nav, then a tall full-bleed portrait.
 * The motion layer reveals the headline line by line and eases the hero back as the story
 * section scrolls over it (data-hero).
 */
import LiquidReveal from "@/components/blocks/LiquidReveal.astro";
import HeroBackdrop from "@/components/blocks/HeroBackdrop.astro";
import RevealPicker from "@/components/blocks/RevealPicker.astro";
import { PORTRAIT_LAYERS, portraitPhoto } from "@/lib/portrait";
import { isProduction } from "@/lib/site";

interface Props {
  /** Small mono line above the headline. */
  label?: string;
  /** Headline, first phrase (full ink). */
  title: string;
  /** Headline, second phrase (muted). */
  titleMuted?: string;
  lead: string;
}

const { label, title, titleMuted, lead } = Astro.props;

// The portrait covers its box, so it is drawn at the wider of the box width and the box height
// times the image ratio (≈1.34). Box heights below: mobile max(62svh, 27.5rem), wider screens at
// least max(100svh, 40rem). Asking for the drawn width keeps the static image sharp and lets the
// canvas reuse the same file instead of downloading a second one.
const SIZES =
  "(min-width: 62em) max(50vw, 134vh, 54rem), (min-width: 48em) max(56vw, 134vh, 54rem), max(100vw, 83vh, 37rem)";
---

<section class="home-hero hero-backdrop-host" aria-labelledby="home-hero-title" data-hero>
  <HeroBackdrop flush />
  <div class="home-hero__copy">
    {label && <p class="text-caption home-hero__label">{label}</p>}
    <h1 id="home-hero-title" data-reveal="lines">
      {title}
      {titleMuted && " "}
      {titleMuted && <span class="home-hero__muted">{titleMuted}</span>}
    </h1>
    <p class="text-lead home-hero__lead" data-reveal="fade">
      {lead}
    </p>
    <div class="home-hero__actions" data-reveal="fade">
      <slot name="actions" />
    </div>
  </div>
  <div class="home-hero__media">
    <LiquidReveal
      top={portraitPhoto}
      layers={PORTRAIT_LAYERS}
      alt="Portrait of Dawid Młynarz"
      fit="fill"
      sizes={SIZES}
    />
  </div>
  {!isProduction && <RevealPicker />}
</section>

<style>
  @layer components {
    .home-hero {
      display: grid;
    }

    .home-hero__copy {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: flex-start;
      gap: var(--space-6);
      padding: calc(var(--space-16) + var(--space-12)) var(--gutter) var(--space-8);
    }

    .home-hero__label,
    .home-hero__lead {
      color: var(--color-text-muted);
    }

    .home-hero__muted {
      color: var(--color-text-muted);
    }

    .home-hero__lead {
      max-inline-size: 34rem;
    }

    .home-hero__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
    }

    /* Mobile: a tall, full-bleed portrait under the copy. */
    .home-hero__media {
      block-size: max(62svh, 27.5rem);
    }

    @media (width >= 48em) {
      .home-hero {
        grid-template-columns: 44fr 56fr;
        min-block-size: max(100svh, 40rem);
      }

      .home-hero__copy {
        padding-block-end: var(--space-12);
      }

      .home-hero__media {
        block-size: auto;
      }
    }

    /* Desktop: the copy starts on the container's left edge and takes half the screen. */
    @media (width >= 62em) {
      .home-hero {
        grid-template-columns: 1fr 1fr;
      }

      .home-hero__copy {
        padding-inline: max(var(--gutter), calc((100vw - var(--container-max)) / 2)) 0;
        padding-block-end: var(--space-16);
      }

      .home-hero h1 {
        inline-size: calc(100% + var(--space-24));
        position: relative;
        z-index: 1;
      }
    }
  }
</style>
