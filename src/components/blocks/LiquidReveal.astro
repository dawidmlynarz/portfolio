---
/**
 * LiquidReveal: the portrait hero. The top image (the clay sculpture by default) is a real
 * responsive <img>; once JS runs, a canvas fades in over it and a liquid mask follows the pointer
 * to reveal the bottom image (the photo). At rest the liquid orbits the face on its own.
 *
 * Both images must be transparent cutouts with identical framing. They stay transparent, so
 * whatever is behind (the hero's dotted backdrop) shows around the figure in light and dark. Behaviour lives in
 * src/scripts/liquid-reveal.ts (ported from the original Webflow embed).
 *
 * Reduced motion: no orbit, wobble or droplets; the liquid appears only while pointing.
 * No JS: the top image alone.
 */
import { Image, getImage } from "astro:assets";

interface Props {
  photo: ImageMetadata;
  clay: ImageMetadata;
  /** Optional clay variant for the dark theme (same framing), so it blends into a black page. */
  clayDark?: ImageMetadata;
  /** Describes the top image (what shows before and without the reveal). */
  alt: string;
  top?: "photo" | "clay";
  /** Blob size, 6–60. */
  size?: number;
  /** Edge softness, 0–100. */
  soft?: number;
  /** Magnet pull towards the pointer, 0–100. */
  pull?: number;
  /** Edge wobble, 0–100. */
  wobble?: number;
  /** Trail heal time in seconds. */
  fade?: number;
  /** Resting orbit speed, 0–100. */
  orbit?: number;
  /** Part of the image always kept in frame: [x0, x1, y0, y1], 0–1. */
  face?: [number, number, number, number];
  /** image: the box takes the image's aspect ratio · fill: fills its parent (full-bleed heroes). */
  fit?: "image" | "fill";
  loading?: "eager" | "lazy";
  sizes?: string;
  class?: string;
}

const {
  photo,
  clay,
  clayDark,
  alt,
  top = "clay",
  size = 22,
  soft = 30,
  pull = 55,
  wobble = 55,
  fade = 1.8,
  orbit = 40,
  face = [0.27, 0.71, 0.04, 0.86],
  fit = "image",
  loading = "eager",
  sizes = "(min-width: 62em) 50vw, 100vw",
  class: className,
} = Astro.props;

const WIDTHS = [480, 800, 1200, 1600, 2400];
const widthsFor = (img: ImageMetadata) => {
  const fits = WIDTHS.filter((w) => w < img.width);
  return [...fits, img.width];
};

// Same widths and format for both layers, so the canvas can pick a matching pair.
const sourcesFor = async (img: ImageMetadata) =>
  Promise.all(
    widthsFor(img).map(async (w) => ({
      url: (await getImage({ src: img, width: w, format: "avif", quality: 70 })).src,
      w,
    })),
  );

const [photoSources, claySources, clayDarkSources] = await Promise.all([
  sourcesFor(photo),
  sourcesFor(clay),
  clayDark ? sourcesFor(clayDark) : undefined,
]);
const topImage = top === "clay" ? clay : photo;
// With a dark clay on top, two static images are rendered and CSS shows the one for the resolved
// theme. Both are lazy so the hidden one (display: none) is never fetched.
const topImageDark = top === "clay" ? clayDark : undefined;
const imageLoading = topImageDark ? "lazy" : loading;
const config = { top, size, soft, pull, wobble, fade, orbit, face };

// The static <img> and the canvas share this crop: cover, positioned on the face centre.
const objectPosition = `${((face[0] + face[1]) / 2) * 100}% ${((face[2] + face[3]) / 2) * 100}%`;
---

<liquid-reveal
  class:list={["liquid", `liquid--${fit}`, className]}
  data-config={JSON.stringify(config)}
  data-photo={JSON.stringify(photoSources)}
  data-clay={JSON.stringify(claySources)}
  data-clay-dark={clayDarkSources && JSON.stringify(clayDarkSources)}
  data-ratio={photo.width / photo.height}
  style={`--liquid-ratio: ${photo.width} / ${photo.height}`}
>
  <Image
    class:list={["liquid__image", { "liquid__image--light": topImageDark }]}
    src={topImage}
    alt={alt}
    widths={widthsFor(topImage)}
    sizes={sizes}
    format="avif"
    quality={70}
    loading={imageLoading}
    fetchpriority={loading === "eager" ? "high" : undefined}
    style={`object-position: ${objectPosition}`}
  />
  {topImageDark && (
    <Image
      class="liquid__image liquid__image--dark"
      src={topImageDark}
      alt={alt}
      widths={widthsFor(topImageDark)}
      sizes={sizes}
      format="avif"
      quality={70}
      loading="lazy"
      fetchpriority={loading === "eager" ? "high" : undefined}
      style={`object-position: ${objectPosition}`}
    />
  )}
  <canvas class="liquid__canvas" aria-hidden="true"></canvas>
</liquid-reveal>

<script>
  import "@/scripts/liquid-reveal";
</script>

<style>
  @layer components {
    .liquid {
      position: relative;
      display: block;
      overflow: hidden;
    }

    .liquid--image {
      aspect-ratio: var(--liquid-ratio);
    }

    /* Narrow screens: a square box crops the cutout's empty sides so the face reads larger.
       The canvas framing keeps the face in frame at any aspect ratio. */
    @media (width < 48em) {
      .liquid--image {
        aspect-ratio: 1;
      }
    }

    .liquid--fill {
      inline-size: 100%;
      block-size: 100%;
    }

    .liquid__image,
    .liquid__canvas {
      position: absolute;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
    }

    .liquid__image {
      object-fit: cover;
    }

    /* Light/dark pair: show the image for the theme the visitor picked. */
    .liquid__image--dark {
      display: none;
    }

    :global(:root[data-theme="dark"]) .liquid__image--dark {
      display: block;
    }

    :global(:root[data-theme="dark"]) .liquid__image--light {
      display: none;
    }

    .liquid__canvas {
      /* Read by the script: the resolved page background, which picks the light or dark clay. */
      color: var(--color-bg);
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--duration-reveal) var(--ease-standard);
    }

    [data-ready] > .liquid__canvas {
      opacity: 1;
    }

    /* Motion layer: the portrait fades in from 0 to 100% once its image has decoded
       (data-shown, set by liquid-reveal.ts). Failsafe: visible after 3s regardless. */
    :global(.motion) .liquid {
      transition: opacity var(--duration-fade) var(--ease-standard);
    }

    :global(.motion) .liquid:not([data-shown]) {
      opacity: 0;
      animation: liquid-failsafe 0s 3s forwards;
    }

    @keyframes liquid-failsafe {
      to {
        opacity: 1;
      }
    }
  }
</style>
