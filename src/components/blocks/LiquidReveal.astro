---
/**
 * LiquidReveal: the portrait hero. The top image (the photo) is a real responsive <img>; once JS
 * runs, a canvas fades in over it and a liquid mask follows the pointer to reveal up to four layers
 * below it, picked at random (each layer can be weighted, so one can be rare). At rest the liquid
 * roams the face on its own.
 *
 * All images must be transparent cutouts with identical framing. They stay transparent, so
 * whatever is behind (the hero's dotted backdrop) shows around the figure in light and dark. A
 * layer can have a dark-theme variant. Behaviour lives in src/scripts/liquid-reveal.ts.
 *
 * Reduced motion: no orbit, lobes or wobble; the liquid appears only while pointing.
 * No JS or no WebGL: the top image alone.
 */
import { Image, getImage } from "astro:assets";

interface Layer {
  light: ImageMetadata;
  /** Variant for the dark theme (same framing). */
  dark?: ImageMetadata;
  /** Relative chance of being picked (default 1). */
  weight?: number;
}

interface Props {
  /** What shows before and without the reveal. */
  top: ImageMetadata;
  /** Revealed under the top, 1–4. The first loads with the canvas, the rest once it is idle. */
  layers: Layer[];
  /** Describes the top image. */
  alt: string;
  /** Blob size, 6–60. */
  size?: number;
  /** Edge softness, 0–100. */
  soft?: number;
  /** Magnet pull towards the pointer, 0–100. */
  pull?: number;
  /** Edge wobble, 0–100. */
  wobble?: number;
  /** Trail heal time in seconds. */
  fade?: number;
  /** Resting orbit speed, 0–100. */
  orbit?: number;
  /** Part of the image always kept in frame: [x0, x1, y0, y1], 0–1. */
  face?: [number, number, number, number];
  /** image: the box takes the image's aspect ratio · fill: fills its parent (full-bleed heroes). */
  fit?: "image" | "fill";
  loading?: "eager" | "lazy";
  sizes?: string;
  class?: string;
}

const {
  top,
  layers,
  alt,
  size = 22,
  soft = 30,
  pull = 55,
  wobble = 55,
  fade = 1.8,
  orbit = 40,
  face = [0.27, 0.71, 0.04, 0.86],
  fit = "image",
  loading = "eager",
  sizes = "(min-width: 62em) 50vw, 100vw",
  class: className,
} = Astro.props;

const WIDTHS = [480, 800, 1200, 1600, 2400];
const widthsFor = (img: ImageMetadata) => {
  const fits = WIDTHS.filter((w) => w < img.width);
  return [...fits, img.width];
};

// The top is the LCP and stays sharp; the layers only show through moving liquid, so they take a
// lower quality (about half the bytes, no visible difference at 100%).
const TOP_QUALITY = 65;
const LAYER_QUALITY = 55;

// Same widths for every layer, so the canvas can pick a matching set.
const sourcesFor = async (img: ImageMetadata, quality: number) =>
  Promise.all(
    widthsFor(img).map(async (w) => ({
      url: (await getImage({ src: img, width: w, format: "avif", quality })).src,
      w,
    })),
  );

const [topSources, layerSources] = await Promise.all([
  sourcesFor(top, TOP_QUALITY),
  Promise.all(
    layers.slice(0, 4).map(async (layer) => ({
      light: await sourcesFor(layer.light, LAYER_QUALITY),
      dark: layer.dark && (await sourcesFor(layer.dark, LAYER_QUALITY)),
      weight: layer.weight ?? 1,
    })),
  ),
]);
const config = { size, soft, pull, wobble, fade, orbit, face };

// Page-load fade: the image marks the portrait as shown as soon as it has loaded, without waiting
// for the module scripts (which would push LCP back). liquid-reveal.ts does the same as a fallback.
const markShown = "this.parentNode.dataset.shown=''";

// The static <img> and the canvas share this crop: cover, positioned on the face centre.
const objectPosition = `${((face[0] + face[1]) / 2) * 100}% ${((face[2] + face[3]) / 2) * 100}%`;
---

<liquid-reveal
  class:list={["liquid", `liquid--${fit}`, className]}
  data-config={JSON.stringify(config)}
  data-top={JSON.stringify(topSources)}
  data-layers={JSON.stringify(layerSources)}
  data-ratio={top.width / top.height}
  style={`--liquid-ratio: ${top.width} / ${top.height}`}
>
  <Image
    class="liquid__image"
    src={top}
    alt={alt}
    widths={widthsFor(top)}
    sizes={sizes}
    format="avif"
    quality={TOP_QUALITY}
    loading={loading}
    fetchpriority={loading === "eager" ? "high" : undefined}
    style={`object-position: ${objectPosition}`}
    onload={markShown}
  />
  <canvas class="liquid__canvas" aria-hidden="true"></canvas>
</liquid-reveal>

<script>
  import "@/scripts/liquid-reveal";
</script>

<style>
  @layer components {
    .liquid {
      position: relative;
      display: block;
      overflow: hidden;
    }

    .liquid--image {
      aspect-ratio: var(--liquid-ratio);
    }

    /* Narrow screens: a square box crops the cutout's empty sides so the face reads larger.
       The canvas framing keeps the face in frame at any aspect ratio. */
    @media (width < 48em) {
      .liquid--image {
        aspect-ratio: 1;
      }
    }

    .liquid--fill {
      inline-size: 100%;
      block-size: 100%;
    }

    .liquid__image,
    .liquid__canvas {
      position: absolute;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
    }

    .liquid__image {
      object-fit: cover;
    }

    .liquid__canvas {
      /* Read by the script: the resolved page background, which picks light or dark layers. */
      color: var(--color-bg);
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--duration-reveal) var(--ease-standard);
    }

    [data-ready] > .liquid__canvas {
      opacity: 1;
    }

    /* The canvas paints both layers itself, so once it has faded in the static image is hidden.
       Left underneath, it would show through the layers' soft, semi-transparent edges (the hair). */
    [data-ready] > .liquid__image {
      visibility: hidden;
      transition: visibility 0s var(--duration-reveal);
    }

    /* Motion layer: the portrait fades in from 0 to 100% once its image has decoded
       (data-shown, set by the image's onload or liquid-reveal.ts). Failsafe: visible after 3s regardless. */
    :global(.motion) .liquid {
      transition: opacity var(--duration-fade) var(--ease-standard);
    }

    :global(.motion) .liquid:not([data-shown]) {
      opacity: 0;
      animation: liquid-failsafe 0s 3s forwards;
    }

    @keyframes liquid-failsafe {
      to {
        opacity: 1;
      }
    }
  }
</style>
