---
/**
 * The hand-off after the home hero: a large about-me statement that lights up word by word as you
 * scroll (the motion layer, data-story). Without the motion layer (no JS, reduced motion) the
 * full statement is visible.
 *
 * PREVIEW: html[data-about] picks how it meets the hero (AboutPicker, src/lib/about-variants.ts):
 *   flow     same surface as the hero, a rule draws in, words light up in place
 *   split    desktop: the portrait stays put while the statement replaces the hero copy;
 *            mobile: the statement rises over the portrait as it fades out
 * No attribute (production until one is picked): an inverse panel grows over the held hero.
 */

interface Props {
  label: string;
  text: string;
  /** Optional link under the statement. */
  href?: string;
  hrefLabel?: string;
}

const { label, text, href, hrefLabel } = Astro.props;
const words = text.split(/\s+/);
---

<section class="story" aria-labelledby="story-label" data-story>
  <div class="story__sticky">
    <div class="story__panel" data-story-panel>
      <div class="story__inner">
        <span class="story__rule" aria-hidden="true" data-story-rule></span>
        <h2 class="text-caption story__label" id="story-label">
          {label}
        </h2>
        <p class="story__text">
          {words.map((word) => (
            <span class="story__word" data-story-word>
              {word}{" "}
            </span>
          ))}
        </p>
        {href && (
          <a class="story__link" href={href}>
            {hrefLabel}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  @layer components {
    .story {
      position: relative;
      z-index: 1; /* slides over the held hero */
    }

    .story__panel {
      display: grid;
      align-items: center;
      min-block-size: 100svh;
      color: var(--color-on-inverse);
      background-color: var(--color-inverse-bg);
    }

    .story__inner {
      display: grid;
      justify-items: start;
      gap: var(--space-8);
      inline-size: 100%;
      max-inline-size: calc(var(--container-max) + 2 * var(--gutter));
      margin-inline: auto;
      padding: var(--space-section-lg) var(--gutter);
    }

    .story__label {
      color: var(--color-on-inverse-muted);
    }

    .story__text {
      max-inline-size: 22em;
      font: var(--weight-medium) var(--text-h2) / var(--leading-h2) var(--font-heading);
      letter-spacing: var(--tracking-h2);
      text-wrap: pretty;
    }

    .story__link {
      color: var(--color-on-inverse);
    }

    /* Flow only. */
    .story__rule {
      display: none;
    }

    /* Motion on: a tall track with the panel pinned while the words light up (current). */
    :global(.motion:not([data-about])) .story {
      block-size: 260svh;
    }

    :global(.motion:not([data-about])) .story__sticky {
      position: sticky;
      inset-block-start: 0;
      block-size: 100svh;
      overflow: hidden;
    }

    :global(.motion:not([data-about])) .story__panel {
      block-size: 100%;
    }

    /* ---------- PREVIEW variants ---------- */

    /* Both sit on the page itself; the next section brings its own space above it. */
    :global(:root:is([data-about="flow"], [data-about="split"])) .story__panel {
      min-block-size: 0;
      color: var(--color-text);
      background-color: transparent;
    }

    :global(:root:is([data-about="flow"], [data-about="split"])) .story__inner {
      padding-block-end: 0;
    }

    :global(:root:is([data-about="flow"], [data-about="split"])) .story__label {
      color: var(--color-text-muted);
    }

    :global(:root:is([data-about="flow"], [data-about="split"])) .story__link {
      color: var(--color-text);
    }

    /* Flow: a hairline across the container opens the section, right under the hero. */
    :global(:root[data-about="flow"]) .story__inner {
      padding-block-start: var(--space-section-sm);
    }

    :global(:root[data-about="flow"]) .story__rule {
      display: block;
      inline-size: 100%;
      block-size: var(--border-width);
      background-color: var(--color-border-muted);
      transform-origin: left center;
    }

    /* Split, mobile: the statement rises over the portrait as it fades out (HomeHero masks
       the portrait). */
    :global(:root[data-about="split"]) .story {
      margin-block-start: -16svh;
    }

    :global(:root[data-about="split"]) .story__inner {
      padding-block-start: var(--space-4);
    }

    /* Split, wider: the statement takes the hero copy's column while the portrait stays put. */
    @media (width >= 48em) {
      :global(:root[data-about="split"]) .story {
        margin-block-start: 0;
      }

      :global(:root[data-about="split"]) .story__panel {
        min-block-size: 100svh;
      }

      :global(:root[data-about="split"]) .story__inner {
        inline-size: 44%;
        margin-inline: 0;
        padding-block: var(--space-section-lg);
      }

      :global(:root[data-about="split"]) .story__text {
        font-size: var(--text-h3);
        line-height: var(--leading-h3);
        letter-spacing: var(--tracking-h3);
      }
    }

    @media (width >= 62em) {
      :global(:root[data-about="split"]) .story__inner {
        inline-size: 50%;
        padding-inline: max(var(--gutter), calc((100vw - var(--container-max)) / 2)) var(--space-16);
      }

      :global(:root[data-about="split"]) .story__text {
        font-size: var(--text-h2);
        line-height: var(--leading-h2);
        letter-spacing: var(--tracking-h2);
      }
    }
  }
</style>
