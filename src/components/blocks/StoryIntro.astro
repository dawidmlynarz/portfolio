---
/**
 * The hand-off after the home hero: a cobalt panel grows to fill the screen and a large
 * about-me statement lights up word by word as you scroll (the motion layer, data-story).
 * Without the motion layer (no JS, reduced motion) it is a plain cobalt section with the full
 * statement visible.
 */
interface Props {
  label: string;
  text: string;
  /** Optional link under the statement. */
  href?: string;
  hrefLabel?: string;
}

const { label, text, href, hrefLabel } = Astro.props;
const words = text.split(/\s+/);
---

<section class="story" aria-labelledby="story-label" data-story>
  <div class="story__sticky">
    <div class="story__panel" data-story-panel>
      <div class="story__inner">
        <h2 class="text-caption story__label" id="story-label">
          {label}
        </h2>
        <p class="story__text">
          {words.map((word) => (
            <span class="story__word" data-story-word>
              {word}{" "}
            </span>
          ))}
        </p>
        {href && (
          <a class="story__link" href={href}>
            {hrefLabel}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  @layer components {
    .story {
      position: relative;
      z-index: 1; /* slides over the held hero */
    }

    .story__panel {
      display: grid;
      align-items: center;
      min-block-size: 100svh;
      color: var(--color-on-brand);
      background-color: var(--color-brand-bg);
    }

    .story__inner {
      display: grid;
      justify-items: start;
      gap: var(--space-8);
      inline-size: 100%;
      max-inline-size: calc(var(--container-max) + 2 * var(--gutter));
      margin-inline: auto;
      padding: var(--space-section-lg) var(--gutter);
    }

    .story__label {
      color: var(--color-on-brand-muted);
    }

    .story__text {
      max-inline-size: 22em;
      font: var(--weight-medium) var(--text-h2) / var(--leading-h2) var(--font-heading);
      letter-spacing: var(--tracking-h2);
      text-wrap: pretty;
    }

    .story__link {
      color: var(--color-on-brand);
    }

    /* Motion on: a tall track with the panel pinned while the words light up. */
    :global(.motion) .story {
      block-size: 260svh;
    }

    :global(.motion) .story__sticky {
      position: sticky;
      inset-block-start: 0;
      block-size: 100svh;
      overflow: hidden;
    }

    :global(.motion) .story__panel {
      block-size: 100%;
    }
  }
</style>
