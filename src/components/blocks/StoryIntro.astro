---
/**
 * The hand-off after the home hero: a large about-me statement on the same surface as the hero,
 * lighting up word by word as it scrolls through the screen (the motion layer, data-story).
 * Nothing is pinned. Without the motion layer (no JS, reduced motion) the full statement is
 * visible.
 */

interface Props {
  label: string;
  text: string;
  /** Optional link under the statement. */
  href?: string;
  hrefLabel?: string;
}

const { label, text, href, hrefLabel } = Astro.props;
const words = text.split(/\s+/);
---

<section class="story" aria-labelledby="story-label" data-story>
  <h2 class="text-caption story__label" id="story-label">
    {label}
  </h2>
  <p class="story__text" data-story-text>
    {words.map((word) => (
      <span class="story__word" data-story-word>
        {word}{" "}
      </span>
    ))}
  </p>
  {href && (
    <a class="story__link" href={href}>
      {hrefLabel}
    </a>
  )}
</section>

<style>
  @layer components {
    /* No bottom padding: the next section brings its own space above it. */
    .story {
      display: grid;
      justify-items: start;
      gap: var(--space-8);
      inline-size: 100%;
      max-inline-size: calc(var(--container-max) + 2 * var(--gutter));
      margin-inline: auto;
      padding: var(--space-section-sm) var(--gutter) 0;
    }

    .story__label {
      color: var(--color-text-muted);
    }

    .story__text {
      max-inline-size: 22em;
      font: var(--weight-medium) var(--text-h2) / var(--leading-h2) var(--font-heading);
      letter-spacing: var(--tracking-h2);
      text-wrap: pretty;
    }
  }
</style>
