---
import Container from "@/components/layout/Container.astro";
import ThemeToggle from "@/components/blocks/ThemeToggle.astro";
import { NAV_LINKS, SITE } from "@/lib/site";

const path = Astro.url.pathname.replace(/\.html$/, "");
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="nav">
  <Container class="nav__inner">
    <a class="nav__home" href="/">
      <svg class="nav__mark" viewBox="0 0 32 24" aria-hidden="true">
        <path d="M23.84 0 15.99 7.94 8.15 0 0 17.69h9.1l1.01-2.21L16 24l5.87-8.52 1.06 2.21H32z" />
      </svg>
      {SITE.name}
    </a>
    <button class="nav__toggle" type="button" popovertarget="nav-menu" aria-label="Menu">
      <svg class="nav__toggle-icon nav__toggle-icon--open" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="nav__toggle-icon nav__toggle-icon--close" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
    <nav class="nav__menu" id="nav-menu" popover aria-label="Primary">
      <ul class="nav__links" role="list">
        {NAV_LINKS.map(({ href, label }) => (
          <li>
            <a class="nav__link" href={href} aria-current={isCurrent(href) ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))}
        <li>
          <a class="nav__link nav__contact" href={`mailto:${SITE.email}`}>
            <span class="nav__contact-short">Contact</span>
            <span class="nav__contact-full">{SITE.email}</span>
          </a>
        </li>
      </ul>
      <ThemeToggle />
    </nav>
  </Container>
</header>

<style>
  @layer components {
    .nav {
      /* Fixed bar height: the mobile menu sheet opens right below it. */
      --nav-block-size: var(--space-16);

      position: sticky;
      inset-block-start: 0;
      z-index: var(--z-nav);
      border-block-end: var(--border-width) solid var(--color-border-subtle);
      background-color: var(--color-overlay);
      backdrop-filter: blur(var(--blur-nav));
    }

    /* Flat at the top of the page, elevated once scrolled. No JS: a scroll-driven animation. */
    @supports (animation-timeline: scroll()) {
      .nav {
        border-block-end-color: transparent;
        animation-name: nav-elevate;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-range: 0 var(--space-16);
      }

      /* Separate rule on purpose: the CSS minifier would otherwise fold the longhands into an
         `animation` shorthand containing scroll(), which browsers reject wholesale. */
      .nav:where(header) {
        animation-timeline: scroll(root);
      }
    }

    @keyframes nav-elevate {
      to {
        border-block-end-color: var(--color-border-subtle);
        box-shadow: var(--shadow-bar);
      }
    }

    .nav__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      min-block-size: var(--nav-block-size);
    }

    .nav__home {
      --underline-size: 0%;

      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-weight: var(--weight-semibold);
      letter-spacing: var(--tracking-h4);
      white-space: nowrap;
    }

    .nav__mark {
      inline-size: 1.25em;
      block-size: auto;
      fill: currentcolor;
    }

    .nav__contact-full {
      display: none;
    }

    @media (width >= 62em) {
      .nav__link.nav__contact {
        --underline-size: 0%;

        padding: var(--space-2) var(--space-4);
        border: var(--border-width) solid var(--color-border-muted);
        border-radius: var(--radius-pill);
        color: var(--color-text);
        transition: background-color var(--duration-fast) var(--ease-standard);
      }

      .nav__link.nav__contact:hover {
        --underline-size: 0%;

        background-color: var(--color-bg-subtle);
      }

      .nav__contact-short {
        display: none;
      }

      .nav__contact-full {
        display: inline;
      }
    }

    /* The menu is a native popover (no JS: Esc and outside clicks close it). From 48em it is a
       plain inline menu, so the popover UA styles are reset here. */
    .nav__menu {
      position: static;
      display: flex;
      align-items: center;
      gap: var(--space-2);
      inline-size: auto;
      block-size: auto;
      margin: 0;
      padding: 0;
      overflow: visible;
      border: 0;
      color: inherit;
      background: none;
    }

    .nav__toggle {
      flex-shrink: 0;
      display: inline-grid;
      place-items: center;
      padding: var(--space-2);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background: transparent;
      transition: background-color var(--duration-fast) var(--ease-standard);
    }

    .nav__toggle:hover {
      background-color: var(--color-bg-subtle);
    }

    .nav__toggle-icon {
      inline-size: 1.125em;
      block-size: 1.125em;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.75;
      stroke-linecap: round;
    }

    .nav__toggle-icon--close,
    .nav:has(.nav__menu:popover-open) .nav__toggle-icon--open {
      display: none;
    }

    .nav:has(.nav__menu:popover-open) .nav__toggle-icon--close {
      display: block;
    }

    /* Mobile: the whole menu folds into a sheet below the bar. */
    @media (width < 48em) {
      .nav__menu:not(:popover-open) {
        display: none;
      }

      .nav__menu:popover-open {
        position: fixed;
        inset: var(--nav-block-size) 0 0;
        flex-direction: column;
        align-items: stretch;
        gap: var(--space-8);
        padding: var(--space-8) var(--gutter);
        overflow-y: auto;
        border-block-start: var(--border-width) solid var(--color-border-subtle);
        background-color: var(--color-bg);
      }

      .nav__menu:popover-open .nav__links {
        flex-direction: column;
        gap: var(--space-6);
        font: var(--weight-semibold) var(--text-h3) / var(--leading-h3) var(--font-heading);
        letter-spacing: var(--tracking-h3);
      }

      .nav__menu:popover-open .nav__link {
        color: var(--color-text);
      }

      .nav__menu:popover-open :global(.theme-toggle) {
        align-self: start;
      }

      :global(html):has(.nav__menu:popover-open) {
        overflow: hidden;
      }
    }

    @media (width < 48em) and (prefers-reduced-motion: no-preference) {
      .nav__menu:popover-open {
        transition: opacity var(--duration-fast) var(--ease-standard);

        @starting-style {
          opacity: 0;
        }
      }
    }

    @media (width >= 48em) {
      .nav__toggle {
        display: none;
      }
    }

    /* No popover support: no toggle; the menu stays inline and wraps under the name. */
    @supports not selector(:popover-open) {
      .nav__toggle {
        display: none;
      }

      .nav__inner {
        flex-wrap: wrap;
      }
    }

    .nav__links {
      display: flex;
      gap: var(--space-3);
      padding: 0;
    }

    .nav__link {
      --underline-size: 0%;
      --underline-origin: right;

      color: var(--color-text-muted);
    }

    .nav__link:hover,
    .nav__link[aria-current="page"] {
      --underline-size: 100%;
      --underline-origin: left;

      color: var(--color-text);
    }

    @media (width >= 48em) {
      .nav__menu,
      .nav__links {
        gap: var(--space-8);
      }
    }
  }
</style>
