---
/**
 * Floating top pill: the M mark (home), Work, Services, About and the theme toggle.
 * The name is not repeated here; it lives in the page storytelling. Contact is not in the nav:
 * the hero, the footer and the mobile menu carry the email.
 * Below 48em the pill becomes a full-width bar: the mark on the left, a menu button on the right.
 * The menu is a full-screen inverse sheet (a native popover, so it works without JS; Esc and
 * outside clicks close it). With JS it opens with the same circle "ink spread" as the theme
 * switch and closes by shrinking back into the button. The sheet repeats the bar, so its close
 * button sits exactly where the menu button was.
 */
import ThemeToggle from "@/components/blocks/ThemeToggle.astro";
import { NAV_LINKS, SITE, SOCIAL_LINKS } from "@/lib/site";

const path = Astro.url.pathname.replace(/\.html$/, "");
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="nav">
  <nav class="nav__pill" aria-label="Primary">
    <a
      class="nav__home"
      href="/"
      aria-current={path === "/" || path === "/index" ? "page" : undefined}
    >
      {[0, 1].map(() => (
        <svg class="nav__mark" viewBox="0 0 32 24" aria-hidden="true">
          <path d="M23.84 0 15.99 7.94 8.15 0 0 17.69h9.1l1.01-2.21L16 24l5.87-8.52 1.06 2.21H32z" />
        </svg>
      ))}
      <span class="visually-hidden">{SITE.name}, home</span>
    </a>
    <ul class="nav__links" role="list">
      {NAV_LINKS.map(({ href, label }) => (
        <li>
          <a class="nav__link" href={href} aria-current={isCurrent(href) ? "page" : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
    <ThemeToggle />
    <button
      class="nav__toggle"
      type="button"
      popovertarget="nav-sheet"
      aria-label="Open menu"
      data-nav-menu
    >
      <svg class="nav__toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 9h16M4 15h16"></path>
      </svg>
    </button>
  </nav>

  <div class="nav__sheet" id="nav-sheet" popover>
    <div class="nav__sheet-bar">
      <a class="nav__home nav__home--inverse" href="/">
        <svg class="nav__mark" viewBox="0 0 32 24" aria-hidden="true">
          <path d="M23.84 0 15.99 7.94 8.15 0 0 17.69h9.1l1.01-2.21L16 24l5.87-8.52 1.06 2.21H32z" />
        </svg>
        <span class="visually-hidden">{SITE.name}, home</span>
      </a>
      <button
        class="nav__toggle nav__close"
        type="button"
        popovertarget="nav-sheet"
        popovertargetaction="hide"
        aria-label="Close menu"
        data-nav-menu
      >
        <svg class="nav__toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
    <nav class="nav__sheet-body" aria-label="Menu">
      <ul class="nav__sheet-links" role="list">
        <li style={`--i: 0`}>
          <a href="/">Home</a>
        </li>
        {NAV_LINKS.map(({ href, label }, i) => (
          <li style={`--i: ${i + 1}`}>
            <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav__sheet-meta">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        {SOCIAL_LINKS.map(({ href, label }) => (
          <a href={href}>{label}</a>
        ))}
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<script>
  import { spread } from "@/scripts/spread";

  // Open with the ink spread from the menu button; close by shrinking back into it.
  const sheet = document.getElementById("nav-sheet");
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-nav-menu]")) {
    button.addEventListener("click", (event) => {
      if (!sheet || !("togglePopover" in sheet)) return;
      event.preventDefault(); // replace the native popover toggle with the animated one
      const open = sheet.matches(":popover-open");
      spread(button, () => sheet.togglePopover(!open), open ? "out" : "in");
    });
  }
</script>

<style>
  @layer components {
    .nav {
      /* Every item in the pill is this tall; the pill adds an even --space-1 all round. */
      --nav-item-size: var(--space-10);

      position: fixed;
      inset-block-start: var(--space-4);
      inset-inline: 0;
      z-index: var(--z-nav);
      display: flex;
      justify-content: center;
      padding-inline: var(--gutter);
      pointer-events: none;
    }

    /* Stays put during page transitions; named only while one runs (see SiteNav). */
    :global(:root[data-vt]) .nav {
      view-transition-name: nav;
    }

    /* The wrapper spans the width but only its pill and the open sheet take pointer input. */
    .nav__pill,
    .nav__sheet {
      pointer-events: auto;
    }

    .nav__pill {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      padding: var(--space-1);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-pill);
      background-color: var(--color-overlay);
      backdrop-filter: blur(var(--blur-nav));
      box-shadow: var(--shadow-bar);
    }

    .nav__home {
      --underline-size: 0%;

      display: grid;
      place-items: center;
      inline-size: var(--nav-item-size);
      block-size: var(--nav-item-size);
      overflow: clip;
      border-radius: var(--radius-pill);
      background-color: var(--color-text);
    }

    .nav__home:hover {
      --underline-size: 0%;
    }

    /* Two stacked marks: on hover the M rolls up and out while its twin rolls in from below. */
    .nav__mark {
      grid-area: 1 / 1;
      inline-size: 1.25rem;
      block-size: auto;
      fill: var(--color-bg);
      transition: translate var(--duration-link) var(--ease-out-expo);
    }

    .nav__mark + .nav__mark {
      translate: 0 var(--nav-item-size);
    }

    .nav__home:hover .nav__mark,
    .nav__home:focus-visible .nav__mark {
      translate: 0 calc(-1 * var(--nav-item-size));
    }

    .nav__home:hover .nav__mark + .nav__mark,
    .nav__home:focus-visible .nav__mark + .nav__mark {
      translate: 0 0;
    }

    .nav__links {
      display: flex;
      gap: var(--space-1);
      padding: 0;
    }

    .nav__link {
      --underline-size: 0%;

      display: flex;
      align-items: center;
      block-size: var(--nav-item-size);
      padding-inline: var(--space-4);
      border-radius: var(--radius-pill);
      color: var(--color-text-muted);
      transition:
        color var(--duration-fast) var(--ease-standard),
        background-color var(--duration-fast) var(--ease-standard);
    }

    .nav__link:hover,
    .nav__link[aria-current="page"] {
      --underline-size: 0%;

      color: var(--color-text);
      background-color: var(--color-bg-subtle);
    }

    /* The theme switch matches the M circle: same size, round, no border. */
    .nav__pill :global(.theme-toggle) {
      inline-size: var(--nav-item-size);
      block-size: var(--nav-item-size);
      padding: 0;
      border-color: transparent;
    }

    .nav__toggle {
      display: none;
      place-items: center;
      inline-size: var(--nav-item-size);
      block-size: var(--nav-item-size);
      padding: 0;
      border: 0;
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background: transparent;
    }

    .nav__toggle-icon {
      inline-size: 1.5rem;
      block-size: 1.5rem;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.75;
      stroke-linecap: round;
    }

    /* Mobile: a full-width bar with the mark and the menu button; the rest moves into the sheet. */
    @media (width < 48em) {
      .nav {
        inset-block-start: 0;
        padding-inline: 0;
      }

      .nav__pill {
        justify-content: space-between;
        inline-size: 100%;
        padding: var(--space-2) var(--gutter);
        border-width: 0 0 var(--border-width);
        border-radius: 0;
        box-shadow: none;
      }

      .nav__links,
      .nav__pill :global(.theme-toggle) {
        display: none;
      }

      .nav__toggle {
        display: grid;
      }

      @supports not selector(:popover-open) {
        .nav__pill .nav__toggle {
          display: none;
        }

        .nav__links {
          display: flex;
        }
      }
    }

    /* The sheet: hidden until opened (UA popover style), never shown from 48em up. */
    .nav__sheet {
      inset: 0;
      inline-size: auto;
      block-size: auto;
      margin: 0;
      padding: 0;
      overflow-y: auto;
      border: 0;
      color: var(--color-on-inverse);
      background-color: var(--color-inverse-bg);
    }

    .nav__sheet:popover-open {
      display: grid;
      grid-template-rows: auto 1fr;
    }

    @media (width >= 48em) {
      .nav__sheet:popover-open {
        display: none;
      }
    }

    /* The sheet's own bar: same box as the page bar, so the close button replaces the menu button. */
    .nav__sheet-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-2) var(--gutter);
      border-block-end: var(--border-width) solid var(--color-on-inverse-muted);
    }

    .nav__home--inverse {
      background-color: var(--color-on-inverse);
    }

    .nav__home--inverse .nav__mark {
      fill: var(--color-inverse-bg);
    }

    .nav__close {
      display: grid;
      color: var(--color-on-inverse);
    }

    .nav__sheet-body {
      display: grid;
      align-content: end;
      gap: var(--space-8);
      padding: var(--space-8) var(--gutter);
    }

    .nav__sheet-links {
      display: grid;
      gap: var(--space-1);
      padding: 0;
      font: var(--weight-medium) var(--text-h1) / var(--leading-h1) var(--font-heading);
      letter-spacing: var(--tracking-h1);
    }

    .nav__sheet-links a {
      --underline-size: 0%;

      color: var(--color-on-inverse);
    }

    .nav__sheet-links a[aria-current="page"] {
      --underline-size: 100%;
    }

    .nav__sheet-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3) var(--space-6);
      font: var(--weight-medium) var(--text-caption) / var(--leading-caption) var(--font-mono);
      letter-spacing: var(--tracking-caption);
      text-transform: uppercase;
    }

    .nav__sheet-meta a {
      color: var(--color-on-inverse);
    }

    .nav__sheet-meta :global(.theme-toggle) {
      color: var(--color-on-inverse);
      border-color: var(--color-on-inverse-muted);
    }

    :global(html):has(.nav__sheet:popover-open) {
      overflow: hidden;
    }

    @media (prefers-reduced-motion: no-preference) {
      .nav__sheet:popover-open .nav__sheet-links li {
        transition:
          translate var(--duration-page) var(--ease-out-expo),
          opacity var(--duration-page) var(--ease-out-expo);
        transition-delay: calc(150ms + var(--i) * 50ms);

        @starting-style {
          translate: 0 40%;
          opacity: 0;
        }
      }
    }
  }
</style>
