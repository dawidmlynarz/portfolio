---
/**
 * Floating top pill: the M mark (home), Work, Services, About and the theme toggle.
 * The name is not repeated here; it lives in the page storytelling. Contact is not in the nav:
 * the hero, the footer and the mobile menu carry the email.
 * Below 48em the pill holds the mark and a Menu button that opens a full-screen inverse sheet
 * (a native popover: no JS, Esc and outside clicks close it). The sheet's Close button sits
 * exactly where Menu was.
 */
import ThemeToggle from "@/components/blocks/ThemeToggle.astro";
import { NAV_LINKS, SITE, SOCIAL_LINKS } from "@/lib/site";

const path = Astro.url.pathname.replace(/\.html$/, "");
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="nav">
  <nav class="nav__pill" aria-label="Primary">
    <a
      class="nav__home"
      href="/"
      aria-current={path === "/" || path === "/index" ? "page" : undefined}
    >
      <svg class="nav__mark" viewBox="0 0 32 24" aria-hidden="true">
        <path d="M23.84 0 15.99 7.94 8.15 0 0 17.69h9.1l1.01-2.21L16 24l5.87-8.52 1.06 2.21H32z" />
      </svg>
      <span class="visually-hidden">{SITE.name}, home</span>
    </a>
    <ul class="nav__links" role="list">
      {NAV_LINKS.map(({ href, label }) => (
        <li>
          <a class="nav__link" href={href} aria-current={isCurrent(href) ? "page" : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
    <ThemeToggle />
    <button class="nav__toggle" type="button" popovertarget="nav-sheet">
      Menu
    </button>
  </nav>

  <div class="nav__sheet" id="nav-sheet" popover>
    <button
      class="nav__toggle nav__close"
      type="button"
      popovertarget="nav-sheet"
      popovertargetaction="hide"
    >
      Close
    </button>
    <nav class="nav__sheet-body" aria-label="Menu">
      <ul class="nav__sheet-links" role="list">
        <li style={`--i: 0`}>
          <a href="/">Home</a>
        </li>
        {NAV_LINKS.map(({ href, label }, i) => (
          <li style={`--i: ${i + 1}`}>
            <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav__sheet-meta">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        {SOCIAL_LINKS.map(({ href, label }) => (
          <a href={href}>{label}</a>
        ))}
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<style>
  @layer components {
    .nav {
      /* Space the page keeps clear above its first content (see SiteLayout). */
      --nav-pill-size: var(--space-12);

      position: fixed;
      inset-block-start: var(--space-4);
      inset-inline: 0;
      z-index: var(--z-nav);
      display: flex;
      justify-content: center;
      padding-inline: var(--gutter);
      pointer-events: none;
      view-transition-name: nav; /* stays put during page transitions */
    }

    .nav__pill,
    .nav__close {
      pointer-events: auto;
    }

    .nav__pill {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      min-block-size: var(--nav-pill-size);
      padding: var(--space-1);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-pill);
      background-color: var(--color-overlay);
      backdrop-filter: blur(var(--blur-nav));
      box-shadow: var(--shadow-bar);
    }

    .nav__home {
      --underline-size: 0%;

      display: grid;
      place-items: center;
      inline-size: calc(var(--nav-pill-size) - 2 * var(--space-1));
      block-size: calc(var(--nav-pill-size) - 2 * var(--space-1));
      border-radius: var(--radius-pill);
      color: var(--color-on-inverse);
      background-color: var(--color-text);
      transition: scale var(--duration-link) var(--ease-out-expo);
    }

    .nav__home:hover {
      --underline-size: 0%;

      scale: 1.08;
    }

    .nav__mark {
      inline-size: 1.25rem;
      block-size: auto;
      fill: var(--color-bg);
    }

    .nav__links {
      display: flex;
      gap: var(--space-1);
      padding: 0;
    }

    .nav__link {
      --underline-size: 0%;

      display: block;
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-pill);
      color: var(--color-text-muted);
      transition:
        color var(--duration-fast) var(--ease-standard),
        background-color var(--duration-fast) var(--ease-standard);
    }

    .nav__link:hover,
    .nav__link[aria-current="page"] {
      --underline-size: 0%;

      color: var(--color-text);
      background-color: var(--color-bg-subtle);
    }

    .nav__pill :global(.theme-toggle) {
      border-color: transparent;
    }

    .nav__toggle {
      display: none;
      min-inline-size: var(--space-24);
      padding: var(--space-2) var(--space-4);
      border: 0;
      border-radius: var(--radius-pill);
      font: inherit;
      color: var(--color-bg);
      background-color: var(--color-text);
    }

    /* Mobile: the pill is just the mark and Menu; everything else moves into the sheet. */
    @media (width < 48em) {
      .nav__links,
      .nav__pill :global(.theme-toggle) {
        display: none;
      }

      .nav__toggle {
        display: block;
      }

      @supports not selector(:popover-open) {
        .nav__toggle {
          display: none;
        }

        .nav__links {
          display: flex;
        }
      }
    }

    /* The sheet: hidden until opened (UA popover style), never shown from 48em up. */
    .nav__sheet {
      inset: 0;
      inline-size: auto;
      block-size: auto;
      margin: 0;
      padding: 0;
      overflow-y: auto;
      border: 0;
      color: var(--color-on-inverse);
      background-color: var(--color-inverse-bg);
    }

    .nav__sheet:popover-open {
      display: grid;
      grid-template-rows: auto 1fr;
      justify-items: center;
      padding: var(--space-4) var(--gutter) var(--space-8);
    }

    @media (width >= 48em) {
      .nav__sheet:popover-open {
        display: none;
      }
    }

    .nav__close {
      display: block;
      color: var(--color-inverse-bg);
      background-color: var(--color-on-inverse);

      /* Same box as the Menu button: pill padding + border offset. */
      margin-block-start: calc(var(--space-1) + var(--border-width));
      margin-inline-start: calc(var(--nav-pill-size) - var(--space-1));
    }

    .nav__sheet-body {
      display: grid;
      align-content: end;
      gap: var(--space-8);
      justify-self: stretch;
    }

    .nav__sheet-links {
      display: grid;
      gap: var(--space-1);
      padding: 0;
      font: var(--weight-medium) var(--text-h1) / var(--leading-h1) var(--font-heading);
      letter-spacing: var(--tracking-h1);
    }

    .nav__sheet-links a {
      --underline-size: 0%;

      color: var(--color-on-inverse);
    }

    .nav__sheet-links a[aria-current="page"] {
      --underline-size: 100%;
    }

    .nav__sheet-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3) var(--space-6);
      font: var(--weight-medium) var(--text-caption) / var(--leading-caption) var(--font-mono);
      letter-spacing: var(--tracking-caption);
      text-transform: uppercase;
    }

    .nav__sheet-meta a {
      color: var(--color-on-inverse);
    }

    .nav__sheet-meta :global(.theme-toggle) {
      color: var(--color-on-inverse);
      border-color: var(--color-on-inverse-muted);
    }

    :global(html):has(.nav__sheet:popover-open) {
      overflow: hidden;
    }

    @media (prefers-reduced-motion: no-preference) {
      .nav__sheet:popover-open {
        transition: clip-path var(--duration-page) var(--ease-out-expo);

        @starting-style {
          clip-path: inset(0 0 100% 0 round 0 0 var(--radius-xl) var(--radius-xl));
        }
      }

      .nav__sheet:popover-open .nav__sheet-links li {
        transition:
          translate var(--duration-page) var(--ease-out-expo),
          opacity var(--duration-page) var(--ease-out-expo);
        transition-delay: calc(150ms + var(--i) * 50ms);

        @starting-style {
          translate: 0 40%;
          opacity: 0;
        }
      }
    }
  }
</style>
