---
/**
 * Case-study lists in two layouts. `grid` (Home, 4 tiles) is the creative grid below; `index`
 * (Work, all) is a ruled list of WorkCard rows, cover on the left.
 *
 * Creative grid:
 * All covers are 4:3 (WorkCard); the grid only varies tile width and offset.
 * Desktop repeats a four-tile rhythm on 12 columns: wide, narrow set lower, narrow indented,
 * wide set lower. Tablet: two staggered columns. Mobile: one column.
 */
import WorkCard from "@/components/blocks/WorkCard.astro";
import type { Work } from "@/lib/work";

interface Props {
  entries: Work[];
  /** grid: staggered tiles (Home) · index: ruled rows (Work) */
  layout?: "grid" | "index";
  headingLevel?: 2 | 3;
  /** How many leading tiles load eagerly. */
  eager?: number;
}

const { entries, layout = "grid", headingLevel = 3, eager = 0 } = Astro.props;
---

<ul class:list={["work-grid", `work-grid--${layout}`]} role="list">
  {entries.map((entry, index) => (
    <li class="work-grid__item">
      <WorkCard
        entry={entry}
        layout={layout === "index" ? "row" : "tile"}
        headingLevel={headingLevel}
        eager={index < eager}
      />
    </li>
  ))}
</ul>

<style>
  @layer components {
    .work-grid {
      display: grid;
      gap: var(--space-16) var(--space-8);
      padding: 0;
    }

    .work-grid--index {
      gap: 0;
      border-block-end: var(--border-width) solid var(--color-border-subtle);
    }

    @media (width >= 48em) {
      .work-grid--grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .work-grid--grid .work-grid__item:nth-child(even) {
        margin-block-start: var(--space-section-lg);
      }
    }

    @media (width >= 62em) {
      .work-grid--grid {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        row-gap: var(--space-section-md);
      }

      .work-grid--grid .work-grid__item:nth-child(even) {
        margin-block-start: 0;
      }

      .work-grid--grid .work-grid__item:nth-child(4n + 1) {
        grid-column: 1 / span 7;
      }

      .work-grid--grid .work-grid__item:nth-child(4n + 2) {
        grid-column: 9 / span 4;
        margin-block-start: var(--space-section-lg);
      }

      .work-grid--grid .work-grid__item:nth-child(4n + 3) {
        grid-column: 2 / span 4;
      }

      .work-grid--grid .work-grid__item:nth-child(4n + 4) {
        grid-column: 7 / span 6;
        margin-block-start: var(--space-section-lg);
      }
    }
  }
</style>
