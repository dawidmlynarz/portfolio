---
/**
 * What I do: numbered rows, each with the service, a one-line promise, a short description and
 * links to the case studies that prove it. On hover the row's number and title turn cobalt.
 */
import { getEntry } from "astro:content";
import { hasPage, workHref } from "@/lib/work";

interface Service {
  title: string;
  promise: string;
  description: string;
  /** Case-study slugs that prove it (entries without a page are skipped). */
  proof: string[];
}

interface Props {
  services: Service[];
  headingLevel?: 3 | 4;
}

const { services, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;

const rows = await Promise.all(
  services.map(async (service) => {
    const entries = await Promise.all(service.proof.map((slug) => getEntry("work", slug)));
    const proof = entries
      .filter((entry) => entry && hasPage(entry))
      .map((entry) => ({ href: workHref(entry!), label: entry!.data.company }));
    return { ...service, proof };
  }),
);
---

<ol class="services" role="list">
  {rows.map(({ title, promise, description, proof }, index) => (
    <li class="services__row" data-reveal="fade">
      <span class="text-caption services__index" aria-hidden="true">
        {String(index + 1).padStart(2, "0")}
      </span>
      <Heading class="services__title">{title}</Heading>
      <div class="services__body">
        <p class="text-lead services__promise">{promise}</p>
        <p class="services__description">{description}</p>
        {proof.length > 0 && (
          <p class="text-small services__proof">
            <span class="text-caption">See it in</span>
            {proof.map(({ href, label }) => (
              <a href={href}>{label}</a>
            ))}
          </p>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  @layer components {
    .services {
      display: grid;
      padding: 0;
      border-block-end: var(--border-width) solid var(--color-border-subtle);
    }

    .services__row {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--space-4) var(--space-6);
      padding-block: var(--space-10);
      border-block-start: var(--border-width) solid var(--color-border-subtle);
    }

    .services__index {
      padding-block-start: var(--space-2);
      color: var(--color-text-muted);
      transition: color var(--duration-fast) var(--ease-standard);
    }

    .services__title {
      font: var(--weight-medium) var(--text-h2) / var(--leading-h2) var(--font-heading);
      letter-spacing: var(--tracking-h2);
      transition: color var(--duration-fast) var(--ease-standard);
    }

    .services__body {
      display: grid;
      gap: var(--space-3);
      grid-column: 2;
      max-inline-size: var(--measure);
    }

    .services__description {
      color: var(--color-text-muted);
    }

    .services__proof {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-2) var(--space-4);
      padding-block-start: var(--space-2);
    }

    .services__proof .text-caption {
      color: var(--color-text-muted);
    }

    .services__row:hover .services__index,
    .services__row:hover .services__title {
      color: var(--color-brand);
    }

    @media (width >= 62em) {
      .services__row {
        grid-template-columns: var(--space-16) 5fr 6fr;
        column-gap: var(--space-8);
      }

      .services__body {
        grid-column: auto;
        padding-block-start: var(--space-2);
      }
    }
  }
</style>
