---
/**
 * Cookie notice: a small card in the bottom-left corner with Decline and Accept, shown until the
 * visitor picks one, on every page. The choice is kept in localStorage as `analytics-consent`
 * ("granted" or "denied"). When the build has CF_WEB_ANALYTICS_TOKEN, BaseLayout loads the
 * Cloudflare beacon only after Accept. Cloudflare's automatic setup ignores the choice.
 *
 * Any element with `data-consent-open` (the button on /privacy) shows the card again, so a visitor
 * can change their mind. Declining after accepting reloads the page, so the beacon stops.
 *
 * Without JS the card never shows.
 * `preview` renders a static copy in place, for /styleguide.
 */
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";

interface Props {
  preview?: boolean;
}

const { preview = false } = Astro.props;
---

<section
  class:list={["consent", { "consent--preview": preview }]}
  aria-label="Cookie notice"
  data-consent-banner={preview ? undefined : ""}
>
  <p class="consent__text">
    I use analytics to measure and improve the website, only if you agree.{" "}
    <Link href="/privacy">Privacy policy</Link>
  </p>
  <div class="consent__actions">
    <Button size="sm" variant="secondary" hover="icon" data-consent-choice="denied">
      Decline
    </Button>
    <Button size="sm" hover="icon" data-consent-choice="granted">
      Accept
    </Button>
  </div>
</section>

<script>
  const KEY = "analytics-consent";
  const root = document.documentElement;
  /** Set in the head by BaseLayout on builds with an analytics token. */
  const loadAnalytics = (window as Window & { loadAnalytics?: () => void }).loadAnalytics;

  const save = (value: string) => {
    try {
      localStorage.setItem(KEY, value);
    } catch {
      // Storage blocked: the choice still holds for this page view.
    }
  };

  document
    .querySelectorAll<HTMLButtonElement>("[data-consent-banner] [data-consent-choice]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const choice = button.dataset.consentChoice!;
        const wasGranted = root.dataset.consent === "granted";
        save(choice);
        root.dataset.consent = choice;
        if (choice === "granted") loadAnalytics?.();
        // A running beacon can't be stopped in place, so a withdrawal reloads without it.
        else if (wasGranted) location.reload();
      });
    });

  document.querySelectorAll<HTMLElement>("[data-consent-open]").forEach((opener) => {
    opener.hidden = !loadAnalytics;
    opener.addEventListener("click", () => {
      root.dataset.consentOpen = "";
      document.querySelector<HTMLElement>("[data-consent-banner] [data-consent-choice]")?.focus();
    });
  });

  // Picking an option closes a card that was opened again.
  document.addEventListener("click", (event) => {
    if ((event.target as Element).closest("[data-consent-choice]")) delete root.dataset.consentOpen;
  });
</script>

<style>
  @layer components {
    .consent {
      position: fixed;
      inset-block-end: var(--space-8);
      inset-inline-start: var(--space-8);
      z-index: calc(var(--z-nav) + 1);
      display: none;
      gap: var(--space-4);
      inline-size: min(24rem, calc(100vw - 2 * var(--space-8)));
      padding: var(--space-6);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-lg);
      font-size: var(--text-small);
      background-color: var(--color-bg);
      box-shadow: var(--shadow-panel);
      animation: consent-in var(--duration-link) var(--ease-standard) both;
    }

    /* Shown while no choice is saved (set in the head before first paint), or when reopened. */
    :root[data-consent="ask"] .consent:where([data-consent-banner]),
    :root[data-consent-open] .consent:where([data-consent-banner]),
    .consent--preview {
      display: grid;
    }

    .consent--preview {
      position: static;
      animation: none;
    }

    .consent__text {
      margin: 0;
      text-wrap: pretty;
    }

    /* Two buttons of equal size across the card, Accept as the primary one. */
    .consent__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2);
    }

    .consent__actions > :global(.button) {
      inline-size: 100%;
    }

    @media (width < 48rem) {
      .consent {
        inset-block-end: var(--space-4);
        inset-inline: var(--space-4);
        inline-size: auto;
      }
    }

    @keyframes consent-in {
      from {
        opacity: 0;
        translate: 0 var(--space-4);
      }
    }
  }
</style>
