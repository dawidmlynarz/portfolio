---
/**
 * Light / dark switch. Light is the default; the OS setting is ignored on purpose, so the theme
 * only changes when the visitor asks. The choice is saved and applied before first paint by the
 * inline script in BaseLayout. Hidden until JS runs (without JS the site stays light).
 *
 * Transition: the new theme spreads from the button as a circle over the old one (a same-document
 * View Transition, styled in base.css). Listeners on `themechange` can delay the new snapshot by
 * passing a promise to event.detail.waitUntil (the liquid portrait uses it to repaint first).
 * Reduced motion or no View Transitions: the theme switches instantly.
 */
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-mode="light"
  aria-pressed="false"
  hidden
>
  <span class="theme-toggle__icons" aria-hidden="true">
    <svg class="theme-toggle__icon theme-toggle__icon--light" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <svg class="theme-toggle__icon theme-toggle__icon--dark" viewBox="0 0 24 24">
      <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
    </svg>
  </span>
  <span class="visually-hidden">Dark mode</span>
</button>

<script>
  type Mode = "light" | "dark";
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
  const current = (): Mode => (root.dataset.theme === "dark" ? "dark" : "light");

  /** Switch the theme and let listeners register work the new snapshot should wait for. */
  const apply = (mode: Mode) => {
    try {
      localStorage.setItem("theme", mode);
    } catch {
      // Storage blocked: the choice still applies for this page view.
    }
    root.dataset.theme = mode;
    const pending: Promise<unknown>[] = [];
    document.dispatchEvent(
      new CustomEvent("themechange", {
        detail: { mode, waitUntil: (promise: Promise<unknown>) => pending.push(promise) },
      }),
    );
    render();
    return Promise.allSettled(pending);
  };

  const render = () => {
    const mode = current();
    for (const button of buttons) {
      button.dataset.mode = mode;
      button.setAttribute("aria-pressed", String(mode === "dark"));
      button.title = mode === "dark" ? "Switch to light mode" : "Switch to dark mode";
    }
  };

  const toggle = (button: HTMLButtonElement) => {
    const next: Mode = current() === "dark" ? "light" : "dark";
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!document.startViewTransition || reduce) {
      apply(next);
      return;
    }

    // The circle starts at the button and grows to cover the farthest corner.
    const { left, top, width, height } = button.getBoundingClientRect();
    const x = left + width / 2;
    const y = top + height / 2;
    const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.style.setProperty("--theme-x", `${x}px`);
    root.style.setProperty("--theme-y", `${y}px`);
    root.style.setProperty("--theme-r", `${r}px`);
    root.dataset.themeTransition = "";

    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    const transition = document.startViewTransition(() => Promise.race([apply(next), wait(400)]));
    transition.finished.finally(() => delete root.dataset.themeTransition);
  };

  for (const button of buttons) {
    button.hidden = false;
    button.addEventListener("click", () => toggle(button));
  }
  render();
</script>

<style>
  @layer components {
    .theme-toggle {
      flex-shrink: 0;
      display: inline-grid;
      place-items: center;
      padding: var(--space-2);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background: transparent;
      transition: background-color var(--duration-fast) var(--ease-standard);
    }

    .theme-toggle[hidden] {
      display: none;
    }

    .theme-toggle:hover {
      background-color: var(--color-bg-subtle);
    }

    /* Sun and moon share one cell; the inactive one turns away and shrinks out. */
    .theme-toggle__icons {
      display: grid;
    }

    .theme-toggle__icon {
      grid-area: 1 / 1;
      inline-size: 1.125em;
      block-size: 1.125em;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition:
        rotate var(--duration-page) var(--ease-out-expo),
        scale var(--duration-page) var(--ease-out-expo),
        opacity var(--duration-fast) var(--ease-standard);
    }

    [data-mode="light"] .theme-toggle__icon--dark,
    [data-mode="dark"] .theme-toggle__icon--light {
      opacity: 0;
      rotate: -90deg;
      scale: 0.4;
    }
  }
</style>
