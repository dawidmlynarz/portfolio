---
// Cycles system → light → dark. Hidden until JS runs; without JS the OS theme applies.
// The saved theme is applied before first paint by the inline script in BaseLayout.
---

<button class="theme-toggle" type="button" data-theme-toggle data-mode="system" hidden>
  <svg class="theme-toggle__icon theme-toggle__icon--system" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="4" width="18" height="12" rx="2"></rect>
    <path d="M8 20h8M12 16v4"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--light" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--dark" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
  </svg>
  <span class="visually-hidden" data-theme-label>
    Theme
  </span>
</button>

<script>
  const MODES = ["system", "light", "dark"] as const;
  type Mode = (typeof MODES)[number];
  const LABELS: Record<Mode, string> = { system: "System", light: "Light", dark: "Dark" };
  const root = document.documentElement;

  const current = (): Mode => {
    const theme = root.dataset.theme;
    return theme === "light" || theme === "dark" ? theme : "system";
  };

  const apply = (mode: Mode) => {
    try {
      if (mode === "system") localStorage.removeItem("theme");
      else localStorage.setItem("theme", mode);
    } catch {
      // Storage blocked: the choice still applies for this page view.
    }
    if (mode === "system") delete root.dataset.theme;
    else root.dataset.theme = mode;
    document.dispatchEvent(new CustomEvent("themechange", { detail: { mode } }));
  };

  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

  const render = () => {
    const mode = current();
    const next = MODES[(MODES.indexOf(mode) + 1) % MODES.length]!;
    for (const button of buttons) {
      button.dataset.mode = mode;
      const label = button.querySelector("[data-theme-label]");
      if (label) label.textContent = `Theme: ${LABELS[mode]}. Switch to ${LABELS[next]}.`;
      button.title = `Theme: ${LABELS[mode]}`;
    }
  };

  for (const button of buttons) {
    button.hidden = false;
    button.addEventListener("click", () => {
      const mode = current();
      apply(MODES[(MODES.indexOf(mode) + 1) % MODES.length]!);
      render();
    });
  }
  render();
</script>

<style>
  @layer components {
    .theme-toggle {
      flex-shrink: 0;
      display: inline-grid;
      place-items: center;
      padding: var(--space-2);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background: transparent;
      transition: background-color var(--duration-fast) var(--ease-standard);
    }

    .theme-toggle[hidden] {
      display: none;
    }

    .theme-toggle:hover {
      background-color: var(--color-bg-subtle);
    }

    .theme-toggle__icon {
      display: none;
      inline-size: 1.125em;
      block-size: 1.125em;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    [data-mode="system"] .theme-toggle__icon--system,
    [data-mode="light"] .theme-toggle__icon--light,
    [data-mode="dark"] .theme-toggle__icon--dark {
      display: block;
    }
  }
</style>
