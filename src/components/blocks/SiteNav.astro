---
/**
 * PREVIEW: one floating bar for every screen size that grows into the menu, instead of a desktop
 * pill and a separate full-screen mobile sheet. Behaviour studied from thedesignsociety.fr (the
 * bar widens, then drops open) and anthracitestudio.be (the open menu is frosted glass over the
 * page). The NavPicker (or ?nav=current) switches back to today's nav for comparison.
 *
 * Opening runs in two steps. First the bar makes room: on desktop it widens a little and its
 * surface grows a few pixels past the content; below 48em the surface grows out to the screen
 * edges and the top. Then it drops open and the links come in one after another. Closing runs
 * backwards. The content never moves: only the box around it and the surface behind it change.
 *
 * The bar and the menu are one box, so the mark stays put and the menu icon turns into the close
 * icon in place. The box animates its real size (Web Animations); the menu content keeps its final
 * width while it is revealed, so nothing reflows. Esc, a click outside or tabbing out closes it.
 * Without JS the menu button is hidden and the links sit in the bar. Reduced motion: no morph.
 */
import ThemeToggle from "@/components/blocks/ThemeToggle.astro";
import { NAV_LINKS, SITE } from "@/lib/site";

const path = Astro.url.pathname.replace(/\.html$/, "");
const isHome = path === "/" || path === "/index";
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const menu = [{ href: "/", label: "Home" }, ...NAV_LINKS];
---

<script is:inline>
  // PREVIEW: pick the nav before first paint (?nav= wins and is remembered).
  (() => {
    const root = document.documentElement;
    const names = ["current", "new"];
    let nav = new URLSearchParams(location.search).get("nav");
    try {
      if (names.includes(nav)) localStorage.setItem("nav", nav);
      nav = localStorage.getItem("nav");
    } catch {}
    root.dataset.nav = names.includes(nav) ? nav : "new";
    root.classList.add("js");
  })();
</script>

<header class="site-nav" data-site-nav>
  <div class="site-nav__scrim" data-site-nav-scrim></div>
  <nav class="site-nav__box" aria-label="Primary">
    <div class="site-nav__surface" aria-hidden="true"></div>
    <div class="site-nav__clip">
      <div class="site-nav__bar">
        <a class="site-nav__home" href="/" aria-current={isHome ? "page" : undefined}>
          <span class="site-nav__mark" aria-hidden="true">
            {[0, 1].map(() => (
              <svg class="site-nav__mark-svg" viewBox="0 0 32 24">
                <path d="M23.84 0 15.99 7.94 8.15 0 0 17.69h9.1l1.01-2.21L16 24l5.87-8.52 1.06 2.21H32z" />
              </svg>
            ))}
          </span>
          <span class="site-nav__name">{SITE.name}</span>
          <span class="visually-hidden">, home</span>
        </a>
        <ul class="site-nav__links" role="list">
          {NAV_LINKS.map(({ href, label }) => (
            <li>
              <a
                class="site-nav__link"
                href={href}
                aria-current={isCurrent(href) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
        <span class="site-nav__bar-theme">
          <ThemeToggle />
        </span>
        <button
          class="site-nav__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav-panel"
          data-site-nav-toggle
        >
          <!-- Same 24-unit grid, box and stroke as the theme switch icon, so the two balance. -->
          <svg class="site-nav__toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path class="site-nav__toggle-line" d="M3.5 8.5h17"></path>
            <path class="site-nav__toggle-line" d="M3.5 15.5h17"></path>
          </svg>
          <span class="visually-hidden">Menu</span>
        </button>
      </div>

      <div class="site-nav__panel" id="site-nav-panel" data-site-nav-panel>
        <ul class="site-nav__menu" role="list">
          {menu.map(({ href, label }, i) => (
            <li class="site-nav__reveal" style={`--i: ${i}`}>
              <a
                class="site-nav__menu-link"
                href={href}
                aria-current={(href === "/" ? isHome : isCurrent(href)) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
        <div class="site-nav__meta site-nav__reveal" style={`--i: ${menu.length}`}>
          <a class="site-nav__contact" href={`mailto:${SITE.email}`}>
            {SITE.email}
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-site-nav]");
  const box = nav?.querySelector<HTMLElement>(".site-nav__box");
  const toggle = nav?.querySelector<HTMLButtonElement>("[data-site-nav-toggle]");
  const panel = nav?.querySelector<HTMLElement>("[data-site-nav-panel]");
  const scrim = nav?.querySelector<HTMLElement>("[data-site-nav-scrim]");

  if (nav && box && toggle && panel && scrim) {
    const root = document.documentElement;
    let animation: Animation | undefined;

    /** Read a duration token in ms (the build may minify "700ms" to ".7s"). */
    const duration = (name: string) => {
      const value = getComputedStyle(root).getPropertyValue(name).trim();
      return parseFloat(value) * (value.endsWith("ms") ? 1 : 1000);
    };
    const token = (name: string) => getComputedStyle(root).getPropertyValue(name).trim();
    const size = () => {
      const { width, height } = box.getBoundingClientRect();
      return { width: `${width}px`, height: `${height}px`, w: width };
    };
    const isOpen = () => nav.hasAttribute("data-open");

    const setOpen = (open: boolean) => {
      if (open === isOpen()) return;
      const from = size(); // mid-animation sizes included, so a quick re-toggle reverses smoothly
      animation?.cancel();
      nav.toggleAttribute("data-open", open);
      nav.toggleAttribute("data-closing", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.querySelector(".visually-hidden")!.textContent = open ? "Close menu" : "Menu";

      // The target size: the open box, or the closed one measured without the panel.
      if (!open) nav.removeAttribute("data-closing");
      const to = size();
      if (!open) nav.setAttribute("data-closing", "");

      const finish = () => {
        nav.removeAttribute("data-closing");
        panel.style.removeProperty("inline-size");
      };
      if (!box.animate || matchMedia("(prefers-reduced-motion: reduce)").matches) {
        finish();
        return;
      }

      // The panel keeps the open width while the box grows or shrinks around it.
      panel.style.inlineSize = `${Math.max(from.w, to.w)}px`;

      // Two steps: open widens (the surface grows out meanwhile), then drops; close lifts, then
      // narrows. On phones the width does not change, so the first step only lets the surface
      // reach the screen edges.
      const curve = token("--ease-in-out-quart");
      const middle = open
        ? { width: to.width, height: from.height, offset: 0.35 }
        : { width: from.width, height: to.height, offset: 0.6 };
      animation = box.animate(
        [
          { width: from.width, height: from.height, easing: curve },
          { ...middle, easing: curve },
          { width: to.width, height: to.height },
        ],
        { duration: duration("--duration-menu") },
      );
      animation.finished.then(finish, () => {});
    };

    toggle.addEventListener("click", () => setOpen(!isOpen()));
    scrim.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    // Tabbing out of the box closes it.
    box.addEventListener("focusout", (event) => {
      const next = event.relatedTarget;
      if (isOpen() && next instanceof Node && !box.contains(next)) setOpen(false);
    });
    // A link to the page you are on just closes the menu.
    panel.addEventListener("click", (event) => {
      const link = event.target instanceof Element && event.target.closest("a[aria-current]");
      if (link) setOpen(false);
    });
    // Coming back through the history cache: start closed.
    addEventListener("pageshow", (event) => {
      if (event.persisted && isOpen()) {
        nav.removeAttribute("data-open");
        toggle.setAttribute("aria-expanded", "false");
      }
    });
    document.addEventListener("navchange", () => setOpen(false));
  }
</script>

<style>
  @layer components {
    .site-nav {
      /* Every control in the bar is this tall; the bar adds an even --space-1 all round. */
      --nav-item-size: var(--space-10);
      --nav-radius: calc(var(--nav-item-size) / 2 + var(--space-1));
      --nav-bar-size: 22rem;
      --nav-open-size: 28rem;

      position: fixed;
      inset-block-start: var(--space-4);
      inset-inline: 0;
      z-index: var(--z-nav);
      display: flex;
      justify-content: center;
      padding-inline: var(--gutter);
      pointer-events: none;
    }

    /* Stays put during page transitions. Named only while one runs (html[data-vt], BaseLayout):
       a named element is a backdrop root, so at rest it would stop the bar and menu blurring. */
    :global(:root[data-vt]) .site-nav {
      view-transition-name: nav;
    }

    :global(:root[data-nav="current"]) .site-nav {
      display: none;
    }

    /* ---------- Scrim: a light dim behind the open menu; a click on it closes the menu ---------- */
    .site-nav__scrim {
      position: fixed;
      inset: 0;
      background-color: var(--color-scrim);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--duration-page) var(--ease-standard),
        visibility 0s linear var(--duration-page);
    }

    .site-nav[data-open] .site-nav__scrim {
      pointer-events: auto;
      opacity: 1;
      visibility: visible;
      transition:
        opacity var(--duration-page) var(--ease-standard),
        visibility 0s;
    }

    /* ---------- The box: its size is animated; the surface behind may grow past it ---------- */
    .site-nav__box {
      position: relative;
      display: grid;
      grid-template-rows: minmax(0, 1fr);
      inline-size: var(--nav-bar-size);
      max-inline-size: 100%;
      pointer-events: auto;
    }

    .site-nav[data-open] .site-nav__box {
      inline-size: var(--nav-open-size);
    }

    @media (width < 48em) {
      .site-nav__box,
      .site-nav[data-open] .site-nav__box {
        inline-size: 100%;
      }
    }

    /* Closed: the frosted bar. Open: thinner frosted glass with a stronger blur (the page shows
       through, softly), grown a little past the content on desktop and to the edges on phones. */
    .site-nav__surface {
      position: absolute;
      inset: 0;
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--nav-radius);
      background-color: var(--color-overlay);
      backdrop-filter: blur(var(--blur-nav));
      box-shadow: var(--shadow-bar);
      transition-property: inset, border-radius, background-color, backdrop-filter;
      transition-duration: var(--duration-page);
      transition-timing-function: var(--ease-out-expo);
    }

    .site-nav[data-open] .site-nav__surface {
      inset: calc(-1 * var(--space-2));
      background-color: var(--color-glass);
      backdrop-filter: blur(var(--blur-menu));
    }

    /* Closing: the surface pulls back in once the menu has lifted. */
    .site-nav[data-closing] .site-nav__surface {
      transition-delay: calc(var(--duration-menu) * 0.45);
    }

    @media (width < 48em) {
      .site-nav[data-open] .site-nav__surface {
        inset: calc(-1 * var(--space-4)) calc(-1 * var(--gutter));
        border-start-start-radius: 0;
        border-start-end-radius: 0;
      }
    }

    .site-nav__clip {
      position: relative;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
      grid-template-columns: minmax(0, 1fr);
      max-block-size: calc(100dvh - 2 * var(--space-4));
      overflow: clip;
      border-radius: var(--nav-radius);
    }

    .site-nav__bar {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      padding: var(--space-1);
    }

    /* Mark and name: on hover the M rolls up and out while its twin rolls in from below. */
    .site-nav__home {
      --underline-size: 0%;

      display: flex;
      flex-shrink: 0;
      align-items: center;
      gap: var(--space-3);
      padding-inline-end: var(--space-3);
      border-radius: var(--radius-pill);
      color: var(--color-text);
    }

    .site-nav__home:hover {
      --underline-size: 0%;
    }

    .site-nav__mark {
      display: grid;
      place-items: center;
      inline-size: var(--nav-item-size);
      block-size: var(--nav-item-size);
      overflow: clip;
      border-radius: var(--radius-pill);
      background-color: var(--color-text);
    }

    .site-nav__mark-svg {
      grid-area: 1 / 1;
      inline-size: 1.25rem;
      block-size: auto;
      fill: var(--color-bg);
      transition: translate var(--duration-link) var(--ease-out-expo);
    }

    .site-nav__mark-svg + .site-nav__mark-svg {
      translate: 0 var(--nav-item-size);
    }

    .site-nav__home:hover .site-nav__mark-svg,
    .site-nav__home:focus-visible .site-nav__mark-svg {
      translate: 0 calc(-1 * var(--nav-item-size));
    }

    .site-nav__home:hover .site-nav__mark-svg + .site-nav__mark-svg,
    .site-nav__home:focus-visible .site-nav__mark-svg + .site-nav__mark-svg {
      translate: 0 0;
    }

    .site-nav__name {
      font-size: var(--text-small);
      font-weight: var(--weight-medium);
      white-space: nowrap;
    }

    /* Bar links: only without JS, when there is no menu. */
    .site-nav__links {
      display: none;
      gap: var(--space-1);
      padding: 0;
    }

    .site-nav__link {
      --underline-size: 0%;

      display: flex;
      align-items: center;
      block-size: var(--nav-item-size);
      padding-inline: var(--space-4);
      border-radius: var(--radius-pill);
      color: var(--color-text-muted);
      transition:
        color var(--duration-fast) var(--ease-standard),
        background-color var(--duration-fast) var(--ease-standard);
    }

    .site-nav__link:hover,
    .site-nav__link[aria-current="page"] {
      --underline-size: 0%;

      color: var(--color-text);
      background-color: var(--color-bg-subtle);
    }

    :global(:root:not(.js)) .site-nav__links {
      display: flex;
      margin-inline-start: auto;
    }

    :global(:root:not(.js)) .site-nav__name,
    :global(:root:not(.js)) .site-nav__toggle {
      display: none;
    }

    :global(:root:not(.js)) .site-nav__box {
      inline-size: auto;
    }

    .site-nav__bar-theme {
      display: flex;
      margin-inline-start: auto;
    }

    /* The theme switch and the menu button: same size, round, no border, same icon box. */
    .site-nav__bar-theme :global(.theme-toggle:not([hidden])),
    .site-nav__toggle {
      display: grid;
      flex-shrink: 0;
      place-items: center;
      inline-size: var(--nav-item-size);
      block-size: var(--nav-item-size);
      padding: 0;
      border: 0;
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background: transparent;
      transition: background-color var(--duration-fast) var(--ease-standard);
    }

    .site-nav__toggle:hover {
      background-color: var(--color-bg-subtle);
    }

    /* Matches .theme-toggle__icon: 1.125em box, 24-unit grid, 1.75 stroke. */
    .site-nav__toggle-icon {
      inline-size: 1.125em;
      block-size: 1.125em;
      overflow: visible;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.75;
      stroke-linecap: round;
    }

    /* Two lines that meet in the middle and turn into a cross. */
    .site-nav__toggle-line {
      transform-box: view-box;
      transform-origin: 12px 8.5px; /* each line turns about its own centre */
      transition:
        translate var(--duration-page) var(--ease-in-out-quart),
        rotate var(--duration-page) var(--ease-in-out-quart);
    }

    .site-nav__toggle-line + .site-nav__toggle-line {
      transform-origin: 12px 15.5px;
    }

    .site-nav[data-open] .site-nav__toggle-line {
      translate: 0 3.5px;
      rotate: 45deg;
    }

    .site-nav[data-open] .site-nav__toggle-line + .site-nav__toggle-line {
      translate: 0 -3.5px;
      rotate: -45deg;
    }

    /* ---------- Panel ---------- */
    .site-nav__panel {
      display: none;
      gap: var(--space-8);
      justify-self: unsafe center; /* stays centred while the box is narrower than it */
      inline-size: 100%;
      min-block-size: 0;
      overflow-y: auto;
      padding: var(--space-4);
      contain: inline-size; /* takes the box's width, never widens it */
    }

    .site-nav[data-open] .site-nav__panel,
    .site-nav[data-closing] .site-nav__panel {
      display: grid;
    }

    .site-nav__menu {
      display: grid;
      padding: 0;
      font: var(--weight-medium) var(--text-h2) / var(--leading-h2) var(--font-heading);
      letter-spacing: var(--tracking-h2);
    }

    .site-nav__menu-link {
      --underline-size: 0%;

      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      padding-block: var(--space-1);
      color: var(--color-text);
      transition: color var(--duration-fast) var(--ease-standard);
    }

    .site-nav__menu-link:hover {
      --underline-size: 0%;
    }

    /* The other links step back while one is hovered. */
    .site-nav__menu:has(.site-nav__menu-link:hover) .site-nav__menu-link:not(:hover) {
      color: var(--color-text-muted);
    }

    /* The page you are on gets a dot. */
    .site-nav__menu-link[aria-current="page"]::after {
      content: "";
      inline-size: var(--space-2);
      block-size: var(--space-2);
      border-radius: var(--radius-pill);
      background-color: currentcolor;
    }

    .site-nav__meta {
      display: flex;
      padding-block-start: var(--space-4);
      border-block-start: var(--border-width) solid var(--color-border-subtle);
    }

    .site-nav__contact {
      --underline-size: 0%;

      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-pill);
      font-size: var(--text-small);
      font-weight: var(--weight-medium);
      color: var(--color-bg);
      background-color: var(--color-text);
    }

    .site-nav__contact:hover {
      --underline-size: 0%;
    }

    /* ---------- Content reveal: after the box has made room, one item after another ---------- */
    @media (prefers-reduced-motion: no-preference) {
      .site-nav[data-open] .site-nav__reveal {
        transition:
          translate var(--duration-page) var(--ease-out-expo),
          opacity var(--duration-page) var(--ease-out-expo);
        transition-delay: calc(var(--duration-menu) * 0.45 + var(--i) * 40ms);

        @starting-style {
          translate: 0 var(--space-6);
          opacity: 0;
        }
      }

      .site-nav[data-closing] .site-nav__reveal {
        opacity: 0;
        transition: opacity var(--duration-fast) var(--ease-standard);
      }
    }
  }
</style>
