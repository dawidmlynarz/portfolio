---
/**
 * Section opener: a mono label, a two-tone heading (ink, then muted) and an optional link
 * aligned to the right on wide screens.
 */
interface Props {
  label: string;
  title: string;
  titleMuted?: string;
  id?: string;
  href?: string;
  hrefLabel?: string;
  /** Optional lead paragraph under the title. */
  lead?: string;
}

const { label, title, titleMuted, id, href, hrefLabel, lead } = Astro.props;
---

<div class="section-intro">
  <p class="text-caption section-intro__label">{label}</p>
  <h2 class="section-intro__title" id={id} data-reveal="lines">
    {title}
    {titleMuted && " "}
    {titleMuted && <span class="section-intro__muted">{titleMuted}</span>}
  </h2>
  {href && (
    <a class="section-intro__link" href={href}>
      {hrefLabel}
    </a>
  )}
  {lead && (
    <p class="text-lead section-intro__lead" data-reveal="fade">
      {lead}
    </p>
  )}
</div>

<style>
  @layer components {
    .section-intro {
      display: grid;
      gap: var(--space-4) var(--space-8);
      align-items: end;
    }

    .section-intro__label,
    .section-intro__muted,
    .section-intro__lead {
      color: var(--color-text-muted);
    }

    .section-intro__link {
      justify-self: start;
    }

    @media (width >= 62em) {
      .section-intro {
        grid-template-columns: 1fr auto;
      }

      .section-intro__label,
      .section-intro__lead {
        grid-column: 1 / -1;
      }

      .section-intro__link {
        justify-self: end;
      }
    }
  }
</style>
