---
/**
 * Sign-off on every page: a giant closing line whose last words cycle (CSS only; static with
 * reduced motion; screen readers get the full sentence), the email as the main action,
 * social links and the copyright line.
 */
import Container from "@/components/layout/Container.astro";
import Link from "@/components/ui/Link.astro";
import { SITE, SOCIAL_LINKS } from "@/lib/site";

const year = new Date().getFullYear();
const endings = ["AI product", "design system", "product team"];
---

<footer class="footer">
  <Container class="footer__inner">
    <p class="text-caption footer__label">Contact</p>
    <h2 class="footer__title">
      <span class="visually-hidden">
        Let's build your next {endings.slice(0, -1).join(", ")} or {endings.at(-1)}.
      </span>
      <span aria-hidden="true">
        Let's build your next{" "}
        <span class="footer__ticker">
          <span class="footer__ticker-track">
            {[...endings, endings[0]].map((ending) => (
              <span>{ending}</span>
            ))}
          </span>
        </span>
      </span>
    </h2>
    <a class="footer__email" data-no-tear href={`mailto:${SITE.email}`}>
      {SITE.email}
      <svg class="footer__arrow" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
    <div class="footer__meta text-small">
      <ul class="footer__social" role="list">
        {SOCIAL_LINKS.map(({ href, label }) => (
          <li>
            <Link href={href}>{label}</Link>
          </li>
        ))}
      </ul>
      <p>
        {SITE.name}. All rights reserved © 2011 – {year}
      </p>
    </div>
  </Container>
</footer>

<style>
  @layer components {
    .footer {
      padding-block: var(--space-section-lg) var(--space-24); /* clears the floating back-to-top button */
    }

    .footer__inner {
      display: grid;
      justify-items: start;
      gap: var(--space-8);
    }

    .footer__label {
      color: var(--color-text-muted);
    }

    .footer__title {
      font: var(--weight-medium) var(--text-h1) / var(--leading-h1) var(--font-heading);
      letter-spacing: var(--tracking-h1);
      max-inline-size: 14em;
    }

    /* One line tall window over a column of endings that steps upward. The window is taller than
       the title's line (so descenders in "design system" aren't clipped); equal negative margins
       centre it on the line, so the endings sit on the same baseline as the words before them. */
    .footer__ticker {
      --ticker-line: 1.12em;
      --ticker-inset: calc((var(--leading-h1) * 1em - var(--ticker-line)) / 2);

      display: inline-block;
      block-size: var(--ticker-line);
      margin-block: var(--ticker-inset);
      overflow: clip;
      vertical-align: bottom;
      color: var(--color-text-muted);
    }

    .footer__ticker-track {
      display: flex;
      flex-direction: column;
      line-height: var(--ticker-line);
    }

    @media (prefers-reduced-motion: no-preference) {
      .footer__ticker-track {
        animation: footer-ticker 7.5s var(--ease-in-out-quart) infinite;
      }
    }

    @keyframes footer-ticker {
      0%,
      28% {
        translate: 0 0;
      }

      33%,
      61% {
        translate: 0 calc(-1 * var(--ticker-line));
      }

      66%,
      94% {
        translate: 0 calc(-2 * var(--ticker-line));
      }

      100% {
        translate: 0 calc(-3 * var(--ticker-line));
      }
    }

    .footer__email {
      --underline-size: 0%;

      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-4) var(--space-6);
      border-radius: var(--radius-pill);
      font-size: var(--text-lead);
      overflow-wrap: anywhere;
      color: var(--color-on-inverse);
      background-color: var(--color-inverse-bg);
    }

    .footer__email:hover {
      --underline-size: 0%;
    }

    .footer__arrow {
      flex-shrink: 0;
      inline-size: 1.25em;
      block-size: 1.25em;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: translate var(--duration-link) var(--ease-out-expo);
    }

    .footer__email:hover .footer__arrow {
      translate: var(--space-1) 0;
    }

    .footer__meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-4);
      inline-size: 100%;
      padding-block-start: var(--space-8);
      border-block-start: var(--border-width) solid var(--color-border-subtle);
      color: var(--color-text-muted);
    }

    .footer__social {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-6);
      padding: 0;
    }
  }
</style>
