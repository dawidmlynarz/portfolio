---
/**
 * "Selected work": a full-bleed, endlessly scrolling row of UI shots (from the original site's
 * Dribbble gallery). Pure CSS: the track is rendered twice and shifted by half its width.
 * Pauses on hover/focus; with reduced motion it becomes a static, horizontally scrollable row.
 */
import { Image } from "astro:assets";

interface Shot {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  title: string;
  shots: Shot[];
  /** Link to the full collection, e.g. a Dribbble profile. */
  href?: string;
  hrefLabel?: string;
}

const { title, shots, href, hrefLabel } = Astro.props;
---

<section class="shots" aria-labelledby="shots-title">
  <div class="shots__head">
    <h2 class="shots__title" id="shots-title">
      {title}
    </h2>
    {href && <a href={href}>{hrefLabel}</a>}
  </div>
  <div class="shots__viewport" tabindex="0" role="region" aria-labelledby="shots-title">
    <div class="shots__track">
      {[0, 1].map((copy) => (
        <ul class="shots__list" role="list" aria-hidden={copy === 1 ? "true" : undefined}>
          {shots.map(({ src, alt }) => (
            <li class="shots__item">
              <Image
                class="shots__image"
                src={src}
                alt={copy === 1 ? "" : alt}
                widths={[400, 800].filter((w) => w <= src.width)}
                sizes="(min-width: 62em) 25vw, (min-width: 48em) 40vw, 70vw"
                loading="lazy"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  @layer components {
    .shots {
      display: grid;
      gap: var(--space-8);
      padding-block: var(--space-section-md);
    }

    .shots__head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-4);
      inline-size: 100%;
      max-inline-size: calc(var(--container-max) + 2 * var(--gutter));
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .shots__viewport {
      overflow: hidden;
    }

    .shots__track {
      display: flex;
      inline-size: max-content;
      animation: shots-scroll var(--duration-marquee) linear infinite;
    }

    .shots__viewport:hover .shots__track,
    .shots__viewport:focus-within .shots__track {
      animation-play-state: paused;
    }

    .shots__list {
      display: flex;
      padding: 0;
    }

    .shots__item {
      inline-size: 70vw;
    }

    .shots__image {
      display: block;
      inline-size: 100%;
      block-size: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;
    }

    @keyframes shots-scroll {
      to {
        translate: -50% 0;
      }
    }

    @media (width >= 48em) {
      .shots__item {
        inline-size: 40vw;
      }
    }

    @media (width >= 62em) {
      .shots__item {
        inline-size: 25vw;
      }
    }

    /* No motion: a plain row the visitor scrolls themselves; the duplicate copy is hidden. */
    @media (prefers-reduced-motion: reduce) {
      .shots__viewport {
        overflow-x: auto;
      }

      .shots__track {
        animation: none;
      }

      .shots__list[aria-hidden="true"] {
        display: none;
      }
    }
  }
</style>
