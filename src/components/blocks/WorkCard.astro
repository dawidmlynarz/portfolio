---
import { Image } from "astro:assets";
import Tag from "@/components/ui/Tag.astro";
import { roleLine, workHref, type Work } from "@/lib/work";

interface Props {
  entry: Work;
  /** Heading level inside the list it sits in. */
  headingLevel?: 2 | 3;
  /** Load the cover eagerly (first card above the fold). */
  eager?: boolean;
}

const { entry, headingLevel = 2, eager = false } = Astro.props;
const { data } = entry;
const Heading = `h${headingLevel}` as const;
const href = data.draft ? undefined : workHref(entry);
---

<article class:list={["work-card", { "work-card--draft": data.draft }]}>
  <Image
    class="work-card__cover"
    src={data.cover}
    alt={data.coverAlt}
    widths={[480, 800, 1200, 1600]}
    sizes="(min-width: 62em) 40rem, calc(100vw - 2rem)"
    loading={eager ? "eager" : "lazy"}
  />
  <div class="work-card__body">
    <p class="work-card__role text-small">{roleLine(entry)}</p>
    <Heading class="work-card__title">
      {href ? <a href={href}>{data.title}</a> : data.title}
    </Heading>
    <p class="work-card__summary">{data.description}</p>
    <ul class="work-card__tags" role="list">
      {data.draft && (
        <Tag as="li" variant="solid">
          Draft · not published
        </Tag>
      )}
      <Tag as="li" variant="solid">
        {data.industry}
      </Tag>
      {data.tags.slice(0, 3).map((tag) => (
        <Tag as="li">{tag}</Tag>
      ))}
    </ul>
  </div>
</article>

<style>
  @layer components {
    .work-card {
      position: relative;
      display: grid;
      align-content: start;
      gap: var(--space-6);
    }

    .work-card__cover {
      inline-size: 100%;
      block-size: auto;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      border-radius: var(--radius-lg);
      background-color: var(--color-bg-subtle);
      transition: opacity var(--duration-fast) var(--ease-standard);
    }

    .work-card__body {
      display: grid;
      gap: var(--space-3);
    }

    .work-card__role,
    .work-card__summary {
      color: var(--color-text-muted);
    }

    .work-card__title {
      font: var(--weight-semibold) var(--text-h3) / var(--leading-h3) var(--font-heading);
      letter-spacing: var(--tracking-h3);
      text-wrap: balance;
    }

    /* The whole card is the link target; the visible link stays the title (one tab stop). */
    .work-card__title a {
      --underline-size: 0%;
      --underline-origin: right;
    }

    .work-card__title a::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: var(--radius-lg);
    }

    .work-card:hover .work-card__title a,
    .work-card__title a:focus-visible {
      --underline-size: 100%;
      --underline-origin: left;
    }

    .work-card:hover .work-card__cover {
      opacity: 0.88;
    }

    .work-card__tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      padding: 0;
      padding-block-start: var(--space-2);
    }

    .work-card--draft .work-card__cover {
      opacity: 0.6;
    }
  }
</style>
