---
/**
 * Case-study tile: the cover, then a mono "Company · Year" line and the outcome title.
 * No tags or summary; the case study tells the rest. The aspect ratio comes from the
 * surrounding WorkGrid (--work-card-ratio). The whole tile is the link target; the visible link
 * is the title (one tab stop). Entries without a page (page: false) render without a link.
 */
import { Image } from "astro:assets";
import { hasPage, workHref, type Work } from "@/lib/work";

interface Props {
  entry: Work;
  /** Heading level inside the list it sits in. */
  headingLevel?: 2 | 3;
  /** Load the cover eagerly (first tiles above the fold). */
  eager?: boolean;
}

const { entry, headingLevel = 3, eager = false } = Astro.props;
const { data } = entry;
const Heading = `h${headingLevel}` as const;
const href = hasPage(entry) ? workHref(entry) : undefined;
const meta = [data.company, data.year, data.draft && "Draft"].filter(Boolean).join(" · ");
---

<article class:list={["work-card", { "work-card--linked": href }]}>
  <div class="work-card__media" data-reveal="fade">
    <Image
      class="work-card__cover"
      src={data.cover}
      alt={data.coverAlt}
      widths={[480, 800, 1200, 1600].filter((w) => w <= data.cover.width)}
      sizes="(min-width: 62em) 55vw, (min-width: 48em) 50vw, 100vw"
      loading={eager ? "eager" : "lazy"}
      style={href ? `view-transition-name: cover-${entry.id}` : undefined}
    />
  </div>
  <div class="work-card__body">
    <p class="text-caption work-card__meta">{meta}</p>
    <Heading class="work-card__title">
      {href ? <a href={href}>{data.title}</a> : data.title}
    </Heading>
  </div>
</article>

<style>
  @layer components {
    .work-card {
      position: relative;
      display: grid;
      align-content: start;
      gap: var(--space-4);
    }

    .work-card__media {
      overflow: hidden;
      border-radius: var(--radius-md);
      background-color: var(--color-bg-subtle);
    }

    .work-card__cover {
      inline-size: 100%;
      block-size: auto;
      aspect-ratio: var(--work-card-ratio, 4 / 3);
      object-fit: cover;
      transition: scale var(--duration-zoom) var(--ease-out-expo);
    }

    .work-card__body {
      display: grid;
      gap: var(--space-2);
      max-inline-size: 36rem;
    }

    .work-card__meta {
      color: var(--color-text-muted);
    }

    .work-card__title {
      font: var(--weight-medium) var(--text-h4) / var(--leading-h4) var(--font-heading);
      letter-spacing: var(--tracking-h4);
      text-wrap: balance;
    }

    /* Quiet at rest; the underline draws in when the tile is hovered or the link focused. */
    .work-card__title a {
      --underline-size: 0%;
    }

    .work-card__title a::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    .work-card--linked:hover .work-card__title a,
    .work-card__title a:focus-visible {
      --underline-size: 100%;
    }

    .work-card--linked:hover .work-card__cover {
      scale: 1.03;
    }
  }
</style>
