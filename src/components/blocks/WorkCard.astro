---
/**
 * Case-study card in two layouts:
 * - tile (Home): the cover, the outcome title and the tags. No role or company line; the title
 *   carries the card.
 * - row (Work): cover on the left, a mono "Role · Company" line, the title, the tags and the
 *   card summary (`description`) cut to four lines.
 * Both show the first three tags as pills and "+N more" for the rest; the case study lists them all.
 * Every cover is cropped to 4:3 (centred) so the set reads as one. The whole card is the link
 * target; the visible link is the title (one tab stop). Entries without a page (page: false)
 * render without a link. Protected case studies show a padlock in a frosted circle on the cover.
 *
 * Hover: the cover zooms in slowly. Reduced motion keeps a still cover.
 */
import { Image } from "astro:assets";
import Tag from "@/components/ui/Tag.astro";
import { hasPage, workHref, type Work } from "@/lib/work";

/** Tags shown on a card; the rest are counted. */
const MAX_TAGS = 3;

interface Props {
  entry: Work;
  /** tile: cover on top (Home grid) · row: cover on the left with the summary (Work index) */
  layout?: "tile" | "row";
  /** Heading level inside the list it sits in. */
  headingLevel?: 2 | 3;
  /** Load the cover eagerly (first cards above the fold). */
  eager?: boolean;
}

const { entry, layout = "tile", headingLevel = 3, eager = false } = Astro.props;
const { data } = entry;
const Heading = `h${headingLevel}` as const;
const href = hasPage(entry) ? workHref(entry) : undefined;
const meta = [
  layout === "row" && data.role,
  layout === "row" && data.company,
  data.draft && "Draft",
]
  .filter(Boolean)
  .join(" · ");
/** Tiles drop the line entirely unless it still has something to say (Draft). */
const showMeta = Boolean(meta);
const tags = data.tags.slice(0, MAX_TAGS);
const moreTags = data.tags.length - tags.length;
const widths = [480, 800, 1200, 1600].filter((w) => w <= data.cover.width);
const sizes =
  layout === "row"
    ? "(min-width: 62em) 40vw, (min-width: 48em) 40vw, 100vw"
    : "(min-width: 62em) 55vw, (min-width: 48em) 50vw, 100vw";
---

<article class:list={["work-card", `work-card--${layout}`, { "work-card--linked": href }]}>
  <div class="work-card__media" data-reveal="fade">
    <div class="work-card__frame">
      <Image
        class="work-card__cover"
        src={data.cover}
        alt={data.coverAlt}
        widths={widths}
        sizes={sizes}
        loading={eager ? "eager" : "lazy"}
        format="avif"
      />
    </div>
    {data.protected && (
      <span class="work-card__lock" title="Password protected">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="5" y="10.5" width="14" height="10" rx="2.5" />
          <path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3" />
        </svg>
        <span class="visually-hidden">Password protected</span>
      </span>
    )}
  </div>
  <div class="work-card__body">
    {showMeta && <p class="text-caption work-card__meta">{meta}</p>}
    <Heading class="work-card__title">
      {href ? (
        <a href={href} data-no-tear>
          {data.title}
        </a>
      ) : (
        data.title
      )}
    </Heading>
    {layout === "row" && <p class="work-card__summary">{data.description}</p>}
    {tags.length > 0 && (
      <ul class="work-card__tags" role="list">
        {tags.map((tag) => (
          <Tag as="li">{tag}</Tag>
        ))}
        {moreTags > 0 && <li class="text-small work-card__more">+{moreTags} more</li>}
      </ul>
    )}
  </div>
</article>

<style>
  @layer components {
    .work-card {
      position: relative;
      display: grid;
      align-content: start;
      gap: var(--space-4);
    }

    .work-card__media {
      position: relative;
      overflow: hidden;
      border-radius: var(--radius-md);
      background-color: var(--color-bg-subtle);
    }

    .work-card__frame {
      position: relative;
      transition: scale var(--duration-zoom) var(--ease-out-expo);
    }

    .work-card__cover {
      inline-size: 100%;
      block-size: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;
    }

    .work-card__body {
      display: grid;
      align-content: start;
      gap: var(--space-2);
      max-inline-size: 36rem;
    }

    .work-card__meta,
    .work-card__summary,
    .work-card__more {
      color: var(--color-text-muted);
    }

    /* Password-protected case studies: a padlock in a frosted circle, top right of the cover.
       It sits outside the frame, so it stays put while the cover zooms on hover. */
    .work-card__lock {
      position: absolute;
      inset-block-start: var(--space-3);
      inset-inline-end: var(--space-3);
      display: grid;
      place-items: center;
      inline-size: var(--space-10);
      block-size: var(--space-10);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background-color: var(--color-overlay);
      backdrop-filter: blur(var(--blur-nav));
    }

    .work-card__lock svg {
      inline-size: 50%;
      block-size: 50%;
      fill: none;
      stroke: currentcolor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .work-card__title {
      font: var(--weight-medium) var(--text-h3) / var(--leading-h3) var(--font-heading);
      letter-spacing: var(--tracking-h3);
      text-wrap: balance;
    }

    /* Quiet at rest; the underline draws in when the card is hovered or the link focused. */
    .work-card__title a {
      --underline-size: 0%;
      --underline-offset: var(--underline-offset-quiet);
    }

    .work-card__title a::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    .work-card--linked:hover .work-card__title a,
    .work-card__title a:focus-visible {
      --underline-size: 100%;
    }

    .work-card--linked:hover .work-card__frame,
    .work-card--linked:focus-within .work-card__frame {
      scale: 1.03;
    }

    /* Four lines at most; the browser adds the ellipsis. */
    .work-card__summary {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 4;
      line-clamp: 4;
      margin-block-start: var(--space-2);
    }

    .work-card__tags {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
      margin-block-start: var(--space-2);
      padding: 0;
    }

    .work-card__more {
      padding-inline-start: var(--space-1);
    }

    /* Row: cover on the left, rows divided by a hairline (WorkGrid's index layout). Same vertical
       rhythm as the Services page rows (Services, detailed). */
    .work-card--row {
      gap: var(--space-6);
      padding-block: var(--space-section-sm);
      border-block-start: var(--border-width) solid var(--color-border-subtle);
    }

    .work-card--row .work-card__media {
      align-self: start;
    }

    .work-card--row .work-card__body {
      max-inline-size: none;
    }

    @media (width >= 48em) {
      .work-card--row {
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: var(--space-8);
      }
    }

    @media (width >= 62em) {
      .work-card--row {
        grid-template-columns: repeat(12, minmax(0, 1fr));
      }

      .work-card--row .work-card__media {
        grid-column: 1 / span 5;
      }

      .work-card--row .work-card__body {
        grid-column: 7 / span 6;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .work-card__frame {
        transition: none;
      }

      .work-card--linked:hover .work-card__frame,
      .work-card--linked:focus-within .work-card__frame {
        scale: none;
      }
    }
  }
</style>
