---
/**
 * Quotes from people Dawid worked with, one at a time in large type. Slides sit in a row that
 * scrolls and snaps sideways (swipe, trackpad or arrow keys on the focused row), with ghost back
 * and next buttons below, aligned left. Without JS it is a swipeable row and the
 * controls stay hidden. Data: src/lib/testimonials.ts.
 */
import Quote from "@/components/content/Quote.astro";
import Button from "@/components/ui/Button.astro";
import type { Testimonial } from "@/lib/testimonials";

interface Props {
  testimonials: Testimonial[];
  label?: string;
}

const { testimonials, label = "What people say" } = Astro.props;
---

<div class="testimonials" role="region" aria-roledescription="carousel" aria-label={label}>
  <ul class="testimonials__track" role="list" tabindex="0" data-testimonials-track>
    {testimonials.map(({ quote, name, role, company }, index) => (
      <li
        class="testimonials__slide"
        role="group"
        aria-roledescription="slide"
        aria-label={`${index + 1} of ${testimonials.length}`}
      >
        <Quote size="lg" author={name} role={company ? `${role}, ${company}` : role}>
          {quote}
        </Quote>
      </li>
    ))}
  </ul>
  <div class="testimonials__controls" data-testimonials-controls hidden>
    <Button variant="ghost" icon="arrow-left" label="Previous quote" data-testimonials-prev />
    <Button variant="ghost" icon="arrow" label="Next quote" data-testimonials-next />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".testimonials").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-testimonials-track]");
    const controls = root.querySelector<HTMLElement>("[data-testimonials-controls]");
    const prev = root.querySelector<HTMLButtonElement>("[data-testimonials-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-testimonials-next]");
    if (!track || !controls || !prev || !next) return;
    const count = track.children.length;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (to: number) => {
      const target = Math.max(0, Math.min(count - 1, to));
      track.scrollTo({
        left: target * track.clientWidth,
        behavior: reduced.matches ? "auto" : "smooth",
      });
    };
    const update = () => {
      const at = index();
      prev.disabled = at === 0;
      next.disabled = at === count - 1;
    };

    prev.addEventListener("click", () => go(index() - 1));
    next.addEventListener("click", () => go(index() + 1));
    track.addEventListener("scroll", update, { passive: true });
    new ResizeObserver(update).observe(track);
    controls.hidden = count < 2;
    update();
  });
</script>

<style>
  @layer components {
    .testimonials {
      display: grid;
      gap: var(--space-10);
    }

    .testimonials__track {
      position: relative;
      display: flex;
      padding: 0;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
    }

    .testimonials__track::-webkit-scrollbar {
      display: none;
    }

    .testimonials__track:focus-visible {
      outline-offset: var(--space-2);
    }

    .testimonials__slide {
      flex: 0 0 100%;
      scroll-snap-align: start;
      padding-inline-end: var(--space-1);
    }

    .testimonials__slide :global(.quote__text) {
      max-inline-size: 22em;
      text-wrap: pretty;
    }

    /* Ghost buttons have no ring at rest, so pull the first arrow back to the text edge. */
    .testimonials__controls {
      display: flex;
      gap: var(--space-2);
      margin-inline-start: calc(-1 * var(--space-3));
    }

    .testimonials__controls[hidden] {
      display: none;
    }
  }
</style>
