---
/**
 * PREVIEW ONLY: a floating switcher to compare the page transition variants (base.css,
 * html[data-pt]). The choice is remembered, so it carries across every page. Never rendered on
 * production; it goes away once a transition is picked.
 */
const OPTIONS = [
  { value: "sheet", label: "Current: sheet" },
  { value: "curtain", label: "1. Curtain" },
  { value: "rise", label: "2. Soft rise" },
  { value: "columns", label: "3. Columns" },
  { value: "spread", label: "4. Spread" },
] as const;
---

<label class="transition-picker">
  <span class="transition-picker__label text-caption">Transition</span>
  <select class="transition-picker__select" data-transition-picker>
    {OPTIONS.map(({ value, label }) => (
      <option value={value}>{label}</option>
    ))}
  </select>
</label>

<script>
  const root = document.documentElement;
  for (const select of document.querySelectorAll<HTMLSelectElement>("[data-transition-picker]")) {
    select.value = root.dataset.pt ?? "sheet";
    select.addEventListener("change", () => {
      root.dataset.pt = select.value;
      try {
        localStorage.setItem("pt", select.value);
      } catch {
        // Storage blocked: the choice lasts for this page only.
      }
    });
  }
</script>

<style>
  @layer components {
    .transition-picker {
      position: fixed;
      inset-block-end: var(--space-8);
      inset-inline-start: var(--space-8);
      z-index: var(--z-nav);
      display: flex;
      gap: var(--space-2);
      align-items: center;
      padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background-color: var(--color-overlay);
      backdrop-filter: blur(var(--blur-nav));
      view-transition-name: transition-picker;
    }

    .transition-picker__label {
      color: var(--color-text-muted);
    }

    .transition-picker__select {
      padding: var(--space-1) var(--space-3);
      border: var(--border-width) solid var(--color-border-muted);
      border-radius: var(--radius-pill);
      font: inherit;
      font-size: var(--text-small);
      color: var(--color-text);
      background-color: var(--color-bg);
    }

    .transition-picker__select:focus-visible {
      outline: calc(var(--border-width) * 2) solid var(--color-focus);
      outline-offset: var(--space-1);
    }

    @media (width < 48em) {
      .transition-picker {
        inset-block-end: var(--space-4);
        inset-inline-start: var(--space-4);
      }
    }
  }
</style>
