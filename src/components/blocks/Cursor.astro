---
/**
 * Cursor label for fine pointers: a cobalt disc with a short label ("View case") that follows
 * the pointer over elements marked [data-cursor]. Driven by src/scripts/motion.ts; hidden
 * otherwise. Decorative only: the real link text stays in the page.
 */
---

<div class="cursor" aria-hidden="true" data-cursor-follower>
  <span class="cursor__disc">
    <span class="text-caption cursor__label" data-cursor-label></span>
  </span>
</div>

<style>
  @layer components {
    .cursor {
      position: fixed;
      inset: 0 auto auto 0;
      z-index: var(--z-nav);
      pointer-events: none;
    }

    .cursor__disc {
      display: grid;
      place-items: center;
      inline-size: var(--space-24);
      block-size: var(--space-24);
      border-radius: var(--radius-pill);
      color: var(--color-on-brand);
      background-color: var(--color-brand-bg);
      translate: -50% -50%;
      scale: 0;
      transition: scale var(--duration-link) var(--ease-out-expo);
    }

    [data-active] > .cursor__disc {
      scale: 1;
    }

    @media (pointer: coarse) {
      .cursor {
        display: none;
      }
    }
  }
</style>
