---
/**
 * PREVIEW ONLY: a floating switcher to compare hero backdrops on the real pages. It sets
 * data-hero-bg on <html>, which swaps --bg-hero (tokens.css). The choice is remembered across
 * pages and can also be set with ?bg=<option>. Never rendered on production; it goes away once a
 * backdrop is picked.
 */
import { BACKDROPS } from "@/lib/backdrops";

const names = BACKDROPS.map(({ value }) => value);
---

<!-- Inline and early, so the page paints with the chosen backdrop. -->
<script is:inline define:vars={{ names }}>
  (() => {
    let bg = new URLSearchParams(location.search).get("bg");
    try {
      if (bg && names.includes(bg)) localStorage.setItem("hero-bg", bg);
      bg = localStorage.getItem("hero-bg");
    } catch {
      // Storage blocked: the choice lasts for this page only.
    }
    document.documentElement.dataset.heroBg = bg && names.includes(bg) ? bg : "grain";
  })();
</script>

<label class="backdrop-picker">
  <span class="backdrop-picker__label text-caption">Background</span>
  <select class="backdrop-picker__select" data-backdrop-picker>
    {BACKDROPS.map(({ value, label }) => (
      <option value={value}>{label}</option>
    ))}
  </select>
</label>

<script>
  const select = document.querySelector<HTMLSelectElement>("[data-backdrop-picker]");
  if (select) {
    select.value = document.documentElement.dataset.heroBg ?? "grain";
    select.addEventListener("change", () => {
      document.documentElement.dataset.heroBg = select.value;
      try {
        localStorage.setItem("hero-bg", select.value);
      } catch {
        // as above
      }
    });
  }
</script>

<style>
  @layer components {
    .backdrop-picker {
      position: fixed;
      inset-block-end: var(--space-8);
      inset-inline-start: var(--space-8);
      z-index: var(--z-nav);
      display: flex;
      gap: var(--space-2);
      align-items: center;
      padding: var(--space-1) var(--space-1) var(--space-1) var(--space-4);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background-color: var(--color-overlay);
      backdrop-filter: blur(var(--blur-nav));
    }

    .backdrop-picker__label {
      color: var(--color-text-muted);
    }

    .backdrop-picker__select {
      padding: var(--space-1) var(--space-3);
      border: var(--border-width) solid var(--color-border-muted);
      border-radius: var(--radius-pill);
      font: inherit;
      font-size: var(--text-small);
      color: var(--color-text);
      background-color: var(--color-bg);
      cursor: pointer;
    }

    .backdrop-picker__select:focus-visible {
      outline: calc(var(--border-width) * 2) solid var(--color-focus);
      outline-offset: var(--space-1);
    }

    /* Phones and tablets: above the reveal picker on the home page (bottom right). */
    @media (width < 62em) {
      .backdrop-picker {
        inset-block-end: calc(var(--space-4) + var(--space-16));
        inset-inline-start: var(--space-4);
      }
    }

    /* Desktop: top left, clear of the hero copy and the centred nav. */
    @media (width >= 62em) {
      .backdrop-picker {
        inset-block: var(--space-6) auto;
      }
    }
  }
</style>
