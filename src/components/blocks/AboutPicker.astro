---
/**
 * PREVIEW ONLY: a floating switcher to compare how the home hero hands over to the About
 * statement (src/lib/about-variants.ts). The inline script sets html[data-about] before first
 * paint, from ?about=<variant>, then the remembered choice, then the default. Picking one reloads
 * the page at the top so the hand-off can be scrolled through again. Never rendered on production.
 */
import { ABOUT_VARIANTS, DEFAULT_ABOUT_VARIANT } from "@/lib/about-variants";

const names = ABOUT_VARIANTS.map((variant) => variant.value);
const fallback = DEFAULT_ABOUT_VARIANT;
---

<script is:inline define:vars={{ names, fallback }}>
  let about = new URLSearchParams(location.search).get("about");
  try {
    if (about && names.includes(about)) localStorage.setItem("about", about);
    about = localStorage.getItem("about");
  } catch {
    // Storage blocked: only ?about= is remembered (in the address).
  }
  document.documentElement.dataset.about = about && names.includes(about) ? about : fallback;
</script>

<label class="about-picker">
  <span class="about-picker__label text-caption">About</span>
  <select class="about-picker__select" data-about-picker>
    {ABOUT_VARIANTS.map(({ value, label }) => (
      <option value={value}>{label}</option>
    ))}
  </select>
</label>

<script>
  const select = document.querySelector<HTMLSelectElement>("[data-about-picker]");
  if (select) {
    select.value = document.documentElement.dataset.about ?? "";
    select.addEventListener("change", () => {
      const url = new URL(location.href);
      url.searchParams.set("about", select.value);
      url.hash = "";
      location.assign(url);
    });
  }
</script>

<style>
  @layer components {
    .about-picker {
      position: fixed;
      inset-block-end: var(--space-8);
      inset-inline-start: var(--space-8);
      z-index: var(--z-nav);
      display: flex;
      gap: var(--space-2);
      align-items: center;
      padding: var(--space-1) var(--space-1) var(--space-1) var(--space-4);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background-color: var(--color-overlay);
      backdrop-filter: blur(var(--blur-nav));
    }

    .about-picker__label {
      color: var(--color-text-muted);
    }

    .about-picker__select {
      padding: var(--space-1) var(--space-3);
      border: 0;
      border-radius: var(--radius-pill);
      font: inherit;
      font-size: var(--text-small);
      color: var(--color-bg);
      background-color: var(--color-text);
      cursor: pointer;
    }

    .about-picker__select:focus-visible {
      outline: calc(var(--border-width) * 2) solid var(--color-focus);
      outline-offset: var(--space-1);
    }

    @media (width < 48em) {
      .about-picker {
        inset-block-end: var(--space-4);
        inset-inline-start: var(--space-4);
      }
    }
  }
</style>
