---
/**
 * The password panel of a locked case study (protected: true). A plain form that posts the
 * password to the case study's own URL, where the Pages Function checks it
 * (functions/work/_middleware.ts). Works without JS.
 *
 * Wrong password: the function serves the locked page again with the form's data-lock-state set
 * to "error" and the input marked invalid and focused. The field takes a heavier red ring, a red
 * tint and a warning sign, the message shows under it in red, and the field skips sideways once
 * (the site's glitch, a lost sync; still with reduced motion). Typing again clears the error
 * (small script; without it the error simply stays until the next try).
 */
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import { SITE } from "@/lib/site";

interface Props {
  /** Where the form posts: the case study's URL. */
  action: string;
  /** Who the case study is for, used in the email subject. */
  company: string;
  /** Show the "wrong password" state (styleguide only; on the site the function sets it). */
  error?: boolean;
  /** Heading level: h1 on the locked page, h3 on the styleguide. */
  headingLevel?: 1 | 3;
  class?: string;
}

const { action, company, error = false, headingLevel = 1, class: className } = Astro.props;
const Heading = `h${headingLevel}` as const;
const id = (name: string) => (error ? `${name}-demo` : name);
const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent(`Access to the ${company} case study`)}`;
---

<section class:list={["lock-panel", className]} aria-labelledby={id("lock-title")}>
  <span class="lock-panel__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
      <rect x="5" y="10.5" width="14" height="10" rx="2.5"></rect>
      <path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"></path>
    </svg>
  </span>
  <Heading class="lock-panel__title" id={id("lock-title")}>
    This case study is password protected
  </Heading>

  <form
    class="lock-panel__form"
    method="post"
    action={action}
    data-lock-state={error ? "error" : "locked"}
  >
    <label class="visually-hidden" for={id("lock-password")}>
      Password
    </label>
    <span class="lock-panel__control">
      <input
        class="lock-panel__input"
        id={id("lock-password")}
        type="password"
        name="password"
        placeholder="Password"
        autocomplete="current-password"
        required
        data-lock-input="password"
        aria-invalid={error ? "true" : undefined}
        aria-describedby={error ? id("lock-error") : undefined}
      />
      <svg class="lock-panel__alert" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7.5v5.5M12 16.5v.01"></path>
      </svg>
    </span>
    <p class="text-small lock-panel__error" id={id("lock-error")}>
      Wrong password. Check it and try again.
    </p>
    <Button class="lock-panel__submit" type="submit">
      Unlock
    </Button>
  </form>

  <p class="text-small lock-panel__caption">
    Want to see this one? Email me at{" "}
    <Link href={mailto} data-no-tear>
      {SITE.email}
    </Link>{" "}
    and I’ll send you access.
  </p>
</section>

<script>
  // Typing again clears the "wrong password" state.
  for (const input of document.querySelectorAll<HTMLInputElement>("[data-lock-input]")) {
    input.addEventListener("input", () => {
      const form = input.form;
      if (form?.dataset.lockState !== "error") return;
      form.dataset.lockState = "locked";
      input.removeAttribute("aria-invalid");
    });
  }
</script>

<style>
  @layer components {
    .lock-panel {
      container-type: inline-size;
      display: grid;
      justify-items: center;
      gap: var(--space-4);
      inline-size: min(100%, 30rem);
      padding: var(--space-10) var(--space-6) var(--space-8);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-lg);
      text-align: center;
      background-color: var(--color-bg);
      box-shadow: var(--shadow-panel);
    }

    .lock-panel__icon {
      display: grid;
      place-items: center;
      inline-size: var(--space-12);
      block-size: var(--space-12);
      margin-block-end: var(--space-2);
      border-radius: var(--radius-pill);
      color: var(--color-on-inverse);
      background-color: var(--color-inverse-bg);
    }

    .lock-panel__icon svg,
    .lock-panel__alert {
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .lock-panel__icon svg {
      inline-size: var(--space-6);
      block-size: var(--space-6);
    }

    .lock-panel__title {
      max-inline-size: 18ch;
      font: var(--weight-medium) var(--text-h3) / var(--leading-h3) var(--font-heading);
      letter-spacing: var(--tracking-h3);
      text-wrap: balance;
    }

    /* Narrow: field, its error, then the button, stacked. Wide enough: field and button in a row,
       the error under the field. The error always sits right under the field it belongs to. */
    .lock-panel__form {
      display: grid;
      grid-template-areas: "control" "error" "submit";
      gap: var(--space-2);
      inline-size: 100%;
      margin-block-start: var(--space-2);
    }

    .lock-panel__form > :global(.lock-panel__submit) {
      grid-area: submit;
    }

    @container (width >= 24rem) {
      .lock-panel__form {
        grid-template-areas: "control submit" "error error";
        grid-template-columns: minmax(0, 1fr) auto;
      }
    }

    /* The input and its warning sign share one cell, the sign at the end. */
    .lock-panel__control {
      display: grid;
      grid-area: control;
      align-items: center;
      min-inline-size: 0;
    }

    .lock-panel__input,
    .lock-panel__alert {
      grid-area: 1 / 1;
    }

    .lock-panel__input {
      min-inline-size: 0;
      padding: var(--space-3) var(--space-6);
      border: 0;
      border-radius: var(--radius-pill);
      line-height: 1.2;
      background-color: var(--color-bg);
      box-shadow: inset 0 0 0 var(--border-width) var(--color-border-muted);
      transition:
        box-shadow var(--duration-fast) var(--ease-standard),
        background-color var(--duration-fast) var(--ease-standard);
    }

    .lock-panel__input::placeholder {
      color: var(--color-text-muted);
      opacity: 1;
    }

    .lock-panel__input:hover {
      box-shadow: inset 0 0 0 var(--border-width) var(--color-border);
    }

    .lock-panel__input:focus-visible {
      outline: none;
      box-shadow: inset 0 0 0 calc(2 * var(--border-width)) var(--color-focus);
    }

    .lock-panel__alert {
      display: none;
      justify-self: end;
      inline-size: 1.25em;
      block-size: 1.25em;
      margin-inline-end: var(--space-4);
      pointer-events: none;
    }

    .lock-panel__error {
      display: none;
      grid-area: error;
      color: var(--color-danger);
      text-align: start;
    }

    /* ---------- Wrong password ----------
       A heavier red ring, a red tint, the warning sign and the message, in --color-danger. The
       field skips sideways once when the page comes back with the error. */
    [data-lock-state="error"] .lock-panel__input {
      padding-inline-end: calc(var(--space-4) + var(--space-8));
      background-color: var(--color-danger-bg);
      box-shadow: inset 0 0 0 calc(2 * var(--border-width)) var(--color-danger);
    }

    [data-lock-state="error"] .lock-panel__alert {
      color: var(--color-danger);
    }

    [data-lock-state="error"] .lock-panel__alert,
    [data-lock-state="error"] .lock-panel__error {
      display: block;
    }

    [data-lock-state="error"] .lock-panel__control {
      animation: lock-panel-jolt var(--duration-tear) steps(1, end);
    }

    @keyframes lock-panel-jolt {
      0% {
        translate: calc(-1 * var(--space-2)) 0;
      }

      25% {
        translate: var(--space-3) 0;
      }

      50% {
        translate: calc(-1 * var(--space-1)) 0;
      }

      75% {
        translate: var(--space-1) 0;
      }

      100% {
        translate: 0;
      }
    }

    .lock-panel__caption {
      inline-size: 100%;
      margin-block-start: var(--space-2);
      color: var(--color-text-muted);
      text-wrap: pretty;
    }

    @media (width >= 48em) {
      .lock-panel {
        padding: var(--space-12) var(--space-10) var(--space-10);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      [data-lock-state="error"] .lock-panel__control {
        animation: none;
      }
    }
  }
</style>
