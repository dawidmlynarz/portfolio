---
import ClientLogo from "@/components/ui/ClientLogo.astro";
import { CLIENTS, type Client } from "@/lib/clients";

/**
 * Client logos (each one a `ClientLogo`, in the text colour).
 *
 * Variants: a wrapping row (default), spread across the width, or a marquee (Home, above the
 * footer): an endless, full-width loop. The marquee renders the list twice (the copy hidden from
 * assistive tech) and slides it by one copy, pure CSS. It pauses on hover; with reduced motion it
 * is a static, centred row.
 */
interface Props {
  clients?: Client[];
  /** Accessible name for the list. */
  label?: string;
  /** Distribute across the full width instead of packing from the start. */
  spread?: boolean;
  /** Endless horizontal loop, edge to edge (place it outside a Container). */
  marquee?: boolean;
  class?: string;
}

const {
  clients = Object.keys(CLIENTS) as Client[],
  label = "Companies I have worked with",
  spread = false,
  marquee = false,
  class: className,
} = Astro.props;
---

{marquee ? (
  <div class:list={["client-logos-marquee", className]}>
    <div class="client-logos-marquee__track">
      {[0, 1].map((copy) => (
        <ul
          class="client-logos client-logos--marquee"
          role="list"
          aria-label={copy === 0 ? label : undefined}
          aria-hidden={copy === 1 ? "true" : undefined}
        >
          {clients.map((key) => (
            <li class="client-logos__item" data-client={key}>
              <ClientLogo client={key} />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
) : (
  <ul
    class:list={["client-logos", { "client-logos--spread": spread }, className]}
    role="list"
    aria-label={label}
  >
    {clients.map((key) => (
      <li class="client-logos__item" data-client={key}>
        <ClientLogo client={key} />
      </li>
    ))}
  </ul>
)}

<style>
  @layer components {
    .client-logos {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4) var(--space-10);
      padding: 0;
    }

    .client-logos--spread {
      justify-content: space-between;
    }

    .client-logos__item :global(svg) {
      display: block;
      inline-size: auto;
      block-size: var(--space-12);
    }

    /* Marquee: two copies side by side, slid left by one copy, forever. Each copy ends with the
       same gap it has between logos, so the seam is invisible. Edges fade into the page. */
    .client-logos-marquee {
      --marquee-gap: var(--space-24);

      overflow: hidden;
      mask-image: linear-gradient(
        to right,
        transparent,
        var(--color-text) var(--space-16),
        var(--color-text) calc(100% - var(--space-16)),
        transparent
      );
    }

    .client-logos-marquee__track {
      display: flex;
      inline-size: max-content;
      animation: client-logos-marquee var(--duration-marquee) linear infinite;
    }

    .client-logos-marquee:hover .client-logos-marquee__track {
      animation-play-state: paused;
    }

    .client-logos--marquee {
      flex-wrap: nowrap;
      gap: var(--marquee-gap);
      padding-inline-end: var(--marquee-gap);
    }

    .client-logos--marquee .client-logos__item {
      flex-shrink: 0;
    }

    @keyframes client-logos-marquee {
      to {
        translate: -50% 0;
      }
    }

    /* Reduced motion: one static, centred row that wraps. */
    @media (prefers-reduced-motion: reduce) {
      .client-logos-marquee {
        mask-image: none;
      }

      .client-logos-marquee__track {
        inline-size: auto;
        justify-content: center;
        padding-inline: var(--gutter);
        animation: none;
      }

      .client-logos--marquee {
        flex-wrap: wrap;
        justify-content: center;
        padding-inline-end: 0;
        gap: var(--space-6) var(--space-12);
      }

      .client-logos--marquee[aria-hidden="true"] {
        display: none;
      }
    }

    @media (width < 48em) {
      .client-logos__item :global(svg) {
        block-size: var(--space-10);
      }

      .client-logos-marquee {
        --marquee-gap: var(--space-16);
      }
    }
  }
</style>
