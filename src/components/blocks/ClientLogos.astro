---
import { CLIENTS, nextLogoId, type Client } from "@/lib/clients";

/**
 * Client logos. The SVGs in src/assets/clients share a 48px-tall artboard, so they read at an even
 * size. They are inlined with black → currentColor, so they follow the surrounding text colour
 * (white is only used inside their masks and clip paths and stays as is). Mask and clip ids get a
 * per-copy suffix so repeated logos stay valid.
 *
 * Variants: a wrapping row (default), spread across the width, or a strip: one line repeated
 * three times that the motion layer slides left to right on scroll ([data-logo-strip], used in
 * the About story). Without the motion layer the strip is a plain row.
 */
const files = import.meta.glob<string>("/src/assets/clients/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

interface Props {
  clients?: Client[];
  /** Accessible name for the list. */
  label?: string;
  /** Distribute across the full width instead of packing from the start. */
  spread?: boolean;
  /** One line that scrolls with the page (motion layer). */
  strip?: boolean;
  class?: string;
}

const {
  clients = Object.keys(CLIENTS) as Client[],
  label = "Companies I have worked with",
  spread = false,
  strip = false,
  class: className,
} = Astro.props;

const themed = (svg: string, name: string, suffix: string) =>
  svg
    .replace(/<\?xml[^>]*>/, "")
    .replace(/fill="(black|#000|#000000)"/gi, 'fill="currentColor"')
    .replace(/\bid="([^"]+)"/g, `id="$1-${suffix}"`)
    .replace(/url\(#([^)]+)\)/g, `url(#$1-${suffix})`)
    .replace(/<svg\b/, `<svg role="img" aria-label="${name}" focusable="false"`);

const logosFor = (copy: number) =>
  clients
    .map((key) => ({ key, name: CLIENTS[key], svg: files[`/src/assets/clients/${key}.svg`] }))
    .filter((logo): logo is typeof logo & { svg: string } => Boolean(logo.svg))
    .map((logo) => ({ ...logo, svg: themed(logo.svg, logo.name, `${nextLogoId()}-${copy}`) }));

const copies = strip ? [0, 1, 2] : [0];
---

{strip ? (
  <div class:list={["client-logos-strip", className]} data-logo-strip>
    <div class="client-logos-strip__track" data-logo-track>
      {copies.map((copy) => (
        <ul
          class="client-logos client-logos--strip"
          role="list"
          aria-label={copy === 0 ? label : undefined}
          aria-hidden={copy === 0 ? undefined : "true"}
        >
          {logosFor(copy).map(({ key, svg }) => (
            <li class="client-logos__item" data-client={key}>
              <Fragment set:html={svg} />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
) : (
  <ul
    class:list={["client-logos", { "client-logos--spread": spread }, className]}
    role="list"
    aria-label={label}
  >
    {logosFor(0).map(({ key, svg }) => (
      <li class="client-logos__item" data-client={key}>
        <Fragment set:html={svg} />
      </li>
    ))}
  </ul>
)}

<style>
  @layer components {
    .client-logos {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4) var(--space-10);
      padding: 0;
    }

    .client-logos--spread {
      justify-content: space-between;
    }

    .client-logos__item :global(svg) {
      display: block;
      inline-size: auto;
      block-size: var(--space-12);
    }

    /* Strip: without motion, the first copy is a plain wrapping row. */
    .client-logos-strip [aria-hidden="true"] {
      display: none;
    }

    :global(.motion) .client-logos-strip {
      overflow: hidden;
      margin-inline: calc(-1 * var(--gutter));
    }

    :global(.motion) .client-logos-strip__track {
      display: flex;
      inline-size: max-content;
    }

    :global(.motion) .client-logos-strip [aria-hidden="true"] {
      display: flex;
    }

    :global(.motion) .client-logos--strip {
      flex-wrap: nowrap;
      padding-inline-end: var(--space-16);
      gap: var(--space-16);
    }

    @media (width < 48em) {
      .client-logos__item :global(svg) {
        block-size: var(--space-10);
      }

      :global(.motion) .client-logos--strip {
        padding-inline-end: var(--space-10);
        gap: var(--space-10);
      }
    }
  }
</style>
