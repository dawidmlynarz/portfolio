---
import { CLIENTS, nextLogoId, type Client } from "@/lib/clients";

/**
 * Client logos. The SVGs in src/assets/clients share a 48px-tall artboard, so they read at an even
 * size. They are inlined with black → currentColor, so they follow the surrounding text colour
 * (white is only used inside their masks and clip paths and stays as is). Mask and clip ids get a
 * unique suffix so several sets on one page stay valid.
 *
 * Variants: a wrapping row (default), spread across the width, or a marquee (Home, above the
 * footer): an endless, full-width loop. The marquee renders the list twice (the copy hidden from
 * assistive tech) and slides it by one copy, pure CSS. It pauses on hover; with reduced motion it
 * is a static, centred row.
 */
const files = import.meta.glob<string>("/src/assets/clients/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

interface Props {
  clients?: Client[];
  /** Accessible name for the list. */
  label?: string;
  /** Distribute across the full width instead of packing from the start. */
  spread?: boolean;
  /** Endless horizontal loop, edge to edge (place it outside a Container). */
  marquee?: boolean;
  class?: string;
}

const {
  clients = Object.keys(CLIENTS) as Client[],
  label = "Companies I have worked with",
  spread = false,
  marquee = false,
  class: className,
} = Astro.props;

const themed = (svg: string, name: string, suffix: number) =>
  svg
    .replace(/<\?xml[^>]*>/, "")
    .replace(/fill="(black|#000|#000000)"/gi, 'fill="currentColor"')
    .replace(/\bid="([^"]+)"/g, `id="$1-${suffix}"`)
    .replace(/url\(#([^)]+)\)/g, `url(#$1-${suffix})`)
    .replace(/<svg\b/, `<svg role="img" aria-label="${name}" focusable="false"`);

const logosFor = () =>
  clients
    .map((key) => ({ key, name: CLIENTS[key], svg: files[`/src/assets/clients/${key}.svg`] }))
    .filter((logo): logo is typeof logo & { svg: string } => Boolean(logo.svg))
    .map((logo) => ({ ...logo, svg: themed(logo.svg, logo.name, nextLogoId()) }));
---

{marquee ? (
  <div class:list={["client-logos-marquee", className]}>
    <div class="client-logos-marquee__track">
      {[0, 1].map((copy) => (
        <ul
          class="client-logos client-logos--marquee"
          role="list"
          aria-label={copy === 0 ? label : undefined}
          aria-hidden={copy === 1 ? "true" : undefined}
        >
          {logosFor().map(({ key, svg }) => (
            <li class="client-logos__item" data-client={key}>
              <Fragment set:html={svg} />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
) : (
  <ul
    class:list={["client-logos", { "client-logos--spread": spread }, className]}
    role="list"
    aria-label={label}
  >
    {logosFor().map(({ key, svg }) => (
      <li class="client-logos__item" data-client={key}>
        <Fragment set:html={svg} />
      </li>
    ))}
  </ul>
)}

<style>
  @layer components {
    .client-logos {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4) var(--space-10);
      padding: 0;
    }

    .client-logos--spread {
      justify-content: space-between;
    }

    .client-logos__item :global(svg) {
      display: block;
      inline-size: auto;
      block-size: var(--space-12);
    }

    /* Marquee: two copies side by side, slid left by one copy, forever. Each copy ends with the
       same gap it has between logos, so the seam is invisible. Edges fade into the page. */
    .client-logos-marquee {
      --marquee-gap: var(--space-24);

      overflow: hidden;
      mask-image: linear-gradient(
        to right,
        transparent,
        var(--color-text) var(--space-16),
        var(--color-text) calc(100% - var(--space-16)),
        transparent
      );
    }

    .client-logos-marquee__track {
      display: flex;
      inline-size: max-content;
      animation: client-logos-marquee var(--duration-marquee) linear infinite;
    }

    .client-logos-marquee:hover .client-logos-marquee__track {
      animation-play-state: paused;
    }

    .client-logos--marquee {
      flex-wrap: nowrap;
      gap: var(--marquee-gap);
      padding-inline-end: var(--marquee-gap);
    }

    .client-logos--marquee .client-logos__item {
      flex-shrink: 0;
    }

    @keyframes client-logos-marquee {
      to {
        translate: -50% 0;
      }
    }

    /* Reduced motion: one static, centred row that wraps. */
    @media (prefers-reduced-motion: reduce) {
      .client-logos-marquee {
        mask-image: none;
      }

      .client-logos-marquee__track {
        inline-size: auto;
        justify-content: center;
        padding-inline: var(--gutter);
        animation: none;
      }

      .client-logos--marquee {
        flex-wrap: wrap;
        justify-content: center;
        padding-inline-end: 0;
        gap: var(--space-6) var(--space-12);
      }

      .client-logos--marquee[aria-hidden="true"] {
        display: none;
      }
    }

    @media (width < 48em) {
      .client-logos__item :global(svg) {
        block-size: var(--space-10);
      }

      .client-logos-marquee {
        --marquee-gap: var(--space-16);
      }
    }
  }
</style>
