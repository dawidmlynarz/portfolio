---
import { CLIENTS, type Client } from "@/lib/clients";

/**
 * Row of client logos. The SVGs in src/assets/clients are single-colour (black on transparent,
 * some with white knock-outs); they are inlined with black → currentColor and white → the page
 * background, so they follow the theme in the text colour (black in light, white in dark).
 */
const files = import.meta.glob<string>("/src/assets/clients/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

interface Props {
  clients?: Client[];
  /** Accessible name for the list. */
  label?: string;
  /** spread: distribute across the full width (home hero), otherwise packed from the start. */
  spread?: boolean;
  class?: string;
}

const {
  clients = Object.keys(CLIENTS) as Client[],
  label = "Companies I have worked with",
  spread = false,
  class: className,
} = Astro.props;

const themed = (svg: string, name: string) =>
  svg
    .replace(/<\?xml[^>]*>/, "")
    .replace(/fill="(black|#000|#000000)"/gi, 'fill="currentColor"')
    .replace(/fill="(white|#fff|#ffffff)"/gi, 'fill="currentColor" class="client-logos__knockout"')
    .replace(/<svg\b/, `<svg role="img" aria-label="${name}" focusable="false"`);

const logos = clients
  .map((key) => ({ key, name: CLIENTS[key], svg: files[`/src/assets/clients/${key}.svg`] }))
  .filter((logo): logo is typeof logo & { svg: string } => Boolean(logo.svg));
---

<ul
  class:list={["client-logos", { "client-logos--spread": spread }, className]}
  role="list"
  aria-label={label}
>
  {logos.map(({ key, name, svg }) => (
    <li class="client-logos__item" data-client={key}>
      <Fragment set:html={themed(svg, name)} />
    </li>
  ))}
</ul>

<style>
  @layer components {
    .client-logos {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-6) var(--space-10);
      padding: 0;
      color: var(--color-text);
    }

    .client-logos--spread {
      justify-content: space-between;
    }

    .client-logos__item :global(svg) {
      display: block;
      inline-size: auto;
      block-size: var(--space-12);
    }

    .client-logos__item :global(.client-logos__knockout) {
      color: var(--color-bg);
    }
  }
</style>
