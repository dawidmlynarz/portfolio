---
/**
 * PREVIEW ONLY: a floating switcher to compare the hero portrait's reveal styles (liquid, pixels,
 * glitch). It sets data-style on every <liquid-reveal>. The choice is remembered and can also be
 * set with ?reveal=<style>. Never rendered on production; it goes away once a style is picked.
 */
const OPTIONS = [
  { value: "liquid", label: "Liquid" },
  { value: "pixels", label: "Pixels" },
  { value: "glitch", label: "Glitch" },
] as const;
---

<div class="reveal-picker" role="group" aria-label="Portrait reveal">
  <span class="reveal-picker__label text-caption">Reveal</span>
  {OPTIONS.map(({ value, label }) => (
    <button class="reveal-picker__option" type="button" data-reveal-style={value}>
      {label}
    </button>
  ))}
</div>

<script>
  const names = ["liquid", "pixels", "glitch"];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-reveal-style]")];

  const apply = (style: string) => {
    for (const el of document.querySelectorAll<HTMLElement>("liquid-reveal"))
      el.dataset.style = style;
    for (const b of buttons)
      b.setAttribute("aria-pressed", String(b.dataset.revealStyle === style));
  };

  let initial = new URLSearchParams(location.search).get("reveal");
  try {
    if (initial && names.includes(initial)) localStorage.setItem("reveal", initial);
    initial = localStorage.getItem("reveal");
  } catch {
    // Storage blocked: the choice lasts for this page only.
  }
  const preset = document.querySelector<HTMLElement>("liquid-reveal")?.dataset.style ?? "liquid";
  apply(initial && names.includes(initial) ? initial : preset);

  for (const b of buttons) {
    b.addEventListener("click", () => {
      const style = b.dataset.revealStyle!;
      apply(style);
      try {
        localStorage.setItem("reveal", style);
      } catch {
        // as above
      }
    });
  }
</script>

<style>
  @layer components {
    .reveal-picker {
      position: fixed;
      inset-block-end: var(--space-8);
      inset-inline-end: var(--space-8);
      z-index: var(--z-nav);
      display: flex;
      gap: var(--space-1);
      align-items: center;
      padding: var(--space-1) var(--space-1) var(--space-1) var(--space-4);
      border: var(--border-width) solid var(--color-border-subtle);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      background-color: var(--color-overlay);
      backdrop-filter: blur(var(--blur-nav));
    }

    .reveal-picker__label {
      margin-inline-end: var(--space-2);
      color: var(--color-text-muted);
    }

    .reveal-picker__option {
      padding: var(--space-1) var(--space-3);
      border: var(--border-width) solid transparent;
      border-radius: var(--radius-pill);
      font: inherit;
      font-size: var(--text-small);
      color: var(--color-text-muted);
      background: none;
      cursor: pointer;
    }

    .reveal-picker__option[aria-pressed="true"] {
      color: var(--color-bg);
      background-color: var(--color-text);
    }

    .reveal-picker__option:focus-visible {
      outline: calc(var(--border-width) * 2) solid var(--color-focus);
      outline-offset: var(--space-1);
    }

    @media (width < 48em) {
      .reveal-picker {
        inset-block-end: var(--space-4);
        inset-inline-end: var(--space-4);
      }
    }
  }
</style>
