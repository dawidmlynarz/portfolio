---
/**
 * Plans, never a row of pricing cards. The featured plan (the retainer) leads as a wide tinted
 * panel: what it is and its price on the left, the list of what's included and the button on the
 * right (stacked on small screens). The others follow side by side from 48em, as open blocks
 * under a rule, each said in one paragraph. Prices are always one step smaller than the plan's
 * name. Every plan ends in "Book a call"; the featured one gets the primary button.
 * Data: src/lib/plans.ts.
 */
import Button from "@/components/ui/Button.astro";
import { formatPrice, type Plan } from "@/lib/plans";
import { BOOKING_HREF } from "@/lib/site";

interface Props {
  plans: Plan[];
  headingLevel?: 2 | 3 | 4;
  /** Anchor for the list; plans also get their own ids (data: plan.id) unless `anchors` is false. */
  id?: string;
  anchors?: boolean;
}

const { plans, headingLevel = 3, id, anchors = true } = Astro.props;
const Heading = `h${headingLevel}` as const;
// The featured plan always leads, whatever the data order.
const ordered = [...plans].sort(
  (a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)),
);
---

<ul class="plans" role="list" id={id}>
  {ordered.map((plan) => {
    const { title, label, promise, price, terms, includes, featured } = plan;
    return (
      <li
        class:list={["plans__plan", featured && "plans__plan--featured"]}
        id={anchors ? plan.id : undefined}
        data-reveal="fade"
      >
        <div class="plans__head">
          <p class="text-caption plans__label">{label}</p>
          <Heading class="plans__title">{title}</Heading>
          <p class="plans__promise">{promise}</p>
          <p class="plans__price">
            <span class="plans__amount">{price ? formatPrice(price) : "Let’s talk"}</span>
            <span class="text-small plans__terms">{terms}</span>
          </p>
        </div>
        <div class="plans__body">
          {includes && includes.length > 0 && (
            <ul class="plans__includes" role="list">
              {includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          <Button
            class="plans__cta"
            href={BOOKING_HREF}
            variant={featured ? "primary" : "secondary"}
            icon="arrow"
            aria-label={`Book a call about the ${title.toLowerCase()}`}
          >
            Book a call
          </Button>
        </div>
      </li>
    );
  })}
</ul>

<style>
  @layer components {
    .plans {
      display: grid;
      gap: var(--space-12);
      padding: 0;
    }

    .plans__plan {
      display: grid;
      align-content: start;
      gap: var(--space-8);
      padding-block-start: var(--space-8);
      border-block-start: var(--border-width) solid var(--color-text);
    }

    .plans__plan--featured {
      grid-column: 1 / -1;
      padding: var(--space-8) var(--space-6);
      border: 0;
      border-radius: var(--radius-lg);
      background-color: var(--color-bg-subtle);
    }

    .plans__head,
    .plans__body {
      display: grid;
      align-content: start;
      gap: var(--space-4);
    }

    .plans__body {
      gap: var(--space-8);
    }

    .plans__label,
    .plans__promise,
    .plans__terms {
      color: var(--color-text-muted);
    }

    .plans__title {
      font: var(--weight-medium) var(--text-h2) / var(--leading-h2) var(--font-heading);
      letter-spacing: var(--tracking-h2);
    }

    .plans__promise {
      max-inline-size: var(--measure-lead);
    }

    .plans__price {
      display: grid;
      gap: var(--space-1);
      padding-block-start: var(--space-2);
    }

    /* One step under the title. */
    .plans__amount {
      font: var(--weight-medium) var(--text-h3) / var(--leading-h3) var(--font-heading);
      letter-spacing: var(--tracking-h3);
    }

    .plans__includes {
      display: grid;
      padding: 0;
    }

    .plans__includes li {
      padding-block: var(--space-3);
      border-block-start: var(--border-width) solid var(--color-border-subtle);
    }

    /* The list starts level with the label opposite, so no rule above the first item. */
    .plans__includes li:first-child {
      padding-block-start: 0;
      border-block-start: 0;
    }

    .plans__cta {
      justify-self: start;
    }

    @media (width >= 48em) {
      .plans {
        grid-template-columns: repeat(2, 1fr);
        column-gap: var(--space-10);
      }

      .plans__plan--featured {
        padding: var(--space-12) var(--space-10);
      }
    }

    /* Wide: the featured plan is one row, head on the left and the list on the right. */
    @media (width >= 62em) {
      .plans__plan--featured {
        grid-template-columns: 5fr 6fr;
        column-gap: var(--space-12);
      }
    }
  }
</style>
