---
import type { HTMLTag } from "astro/types";
import { space, type Space } from "@/lib/tokens";

interface Props {
  as?: HTMLTag;
  gap?: Space;
  align?: "stretch" | "start" | "center" | "end";
  class?: string;
}

const { as: Tag = "div", gap = "4", align = "stretch", class: className } = Astro.props;
---

<Tag
  class:list={["stack", className]}
  style={`--stack-gap: ${space(gap)}; --stack-align: ${align}`}
>
  <slot />
</Tag>

<style>
  @layer components {
    .stack {
      display: flex;
      flex-direction: column;
      align-items: var(--stack-align);
      gap: var(--stack-gap);
    }
  }
</style>
