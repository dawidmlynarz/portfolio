---
import type { HTMLTag } from "astro/types";

interface Props {
  as?: HTMLTag;
  /** default: page width · narrow: reading measure · full: edge to edge with gutters */
  width?: "default" | "narrow" | "full";
  class?: string;
}

const { as: Tag = "div", width = "default", class: className } = Astro.props;
---

<Tag class:list={["container", `container--${width}`, className]}>
  <slot />
</Tag>

<style>
  @layer components {
    .container {
      inline-size: 100%;
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .container--default {
      max-inline-size: calc(var(--container-max) + 2 * var(--gutter));
    }

    .container--narrow {
      max-inline-size: calc(var(--measure) + 2 * var(--gutter));
    }
  }
</style>
