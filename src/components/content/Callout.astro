---
import { isProduction } from "@/lib/site";

interface Props {
  title?: string;
  /**
   * draft: a note for Dawid on a case study in review (what needs his words or a check). Dashed,
   * labelled "Draft note", and shown on previews only, never in production.
   */
  variant?: "default" | "draft";
}
const { title, variant = "default" } = Astro.props;
const draft = variant === "draft";
---

{!(draft && isProduction) && (
  <aside class:list={["callout", { "callout--draft": draft }]}>
    {draft && <p class="callout__label text-caption">Draft note</p>}
    {title && <p class="callout__title">{title}</p>}
    <div class="callout__body">
      <slot />
    </div>
  </aside>
)}

<style>
  @layer components {
    .callout {
      display: grid;
      gap: var(--space-3);
      padding: var(--space-6);
      border-inline-start: calc(var(--border-width) * 3) solid var(--color-text);
      border-radius: var(--radius-md);
      background-color: var(--color-bg-subtle);
    }

    .callout__title {
      font-weight: var(--weight-semibold);
    }

    .callout__body {
      display: grid;
      gap: var(--space-3);
    }

    .callout--draft {
      border: var(--border-width) dashed var(--color-border);
      color: var(--color-text-muted);
    }

    .callout__label {
      color: var(--color-text);
    }
  }
</style>
