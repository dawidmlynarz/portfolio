---
interface Props {
  author?: string;
  role?: string;
  /** md: case studies · lg: the /services quotes carousel */
  size?: "md" | "lg";
}
const { author, role, size = "md" } = Astro.props;
---

<figure class:list={["quote", `quote--${size}`]}>
  <blockquote class="quote__text">
    <slot />
  </blockquote>
  {author && (
    <figcaption class="quote__source text-small">
      <span class="quote__author">{author}</span>
      {role && <span>, {role}</span>}
    </figcaption>
  )}
</figure>

<style>
  @layer components {
    .quote {
      display: grid;
      gap: var(--space-4);
    }

    .quote__text {
      font: var(--weight-medium) var(--text-h3) / var(--leading-h3) var(--font-heading);
      letter-spacing: var(--tracking-h3);
      text-wrap: balance;
    }

    .quote--lg {
      gap: var(--space-8);
    }

    .quote--lg .quote__text {
      font-size: var(--text-h2);
      line-height: var(--leading-h2);
      letter-spacing: var(--tracking-h2);
    }

    .quote__source {
      color: var(--color-text-muted);
    }

    .quote__author {
      color: var(--color-text);
      font-weight: var(--weight-semibold);
    }
  }
</style>
