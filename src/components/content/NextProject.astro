---
import { Image } from "astro:assets";
import Container from "@/components/layout/Container.astro";
import { roleLine, workHref, type Work } from "@/lib/work";

interface Props {
  entry: Work;
}
const { entry } = Astro.props;
---

<aside class="next-project" aria-labelledby="next-project-title">
  <Container class="next-project__inner">
    <div class="next-project__text">
      <p class="text-caption next-project__eyebrow">Next case study</p>
      <p class="text-small next-project__role">{roleLine(entry)}</p>
      <h2 class="next-project__title" id="next-project-title">
        <a href={workHref(entry)}>{entry.data.title}</a>
      </h2>
    </div>
    <Image
      class="next-project__cover"
      src={entry.data.cover}
      alt=""
      widths={[480, 800, 1200]}
      sizes="(min-width: 62em) 36rem, calc(100vw - 2rem)"
      format="avif"
    />
  </Container>
</aside>

<style>
  @layer components {
    .next-project {
      position: relative;
      padding-block: var(--space-section-md);
      border-block-start: var(--border-width) solid var(--color-border-subtle);
    }

    .next-project__inner {
      display: grid;
      align-items: center;
      gap: var(--space-8);
    }

    .next-project__text {
      display: grid;
      gap: var(--space-3);
    }

    .next-project__eyebrow,
    .next-project__role {
      color: var(--color-text-muted);
    }

    .next-project__title a {
      --underline-size: 0%;
      --underline-origin: right;
    }

    .next-project__title a::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    .next-project:hover .next-project__title a {
      --underline-size: 100%;
      --underline-origin: left;
    }

    .next-project__cover {
      inline-size: 100%;
      block-size: auto;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      border-radius: var(--radius-lg);
    }

    @media (width >= 62em) {
      .next-project__inner {
        grid-template-columns: 1fr 1fr;
        gap: var(--space-16);
      }
    }
  }
</style>
