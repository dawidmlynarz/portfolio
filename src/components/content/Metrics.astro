---
interface Props {
  items: { value: string; label: string }[];
  width?: "content" | "wide";
}
const { items, width = "wide" } = Astro.props;
---

<dl class="metrics" data-width={width}>
  {items.map(({ value, label }) => (
    <div class="metrics__item">
      <dt class="metrics__label">{label}</dt>
      <dd class="metrics__value">{value}</dd>
    </div>
  ))}
</dl>

<style>
  @layer components {
    .metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
      gap: var(--space-8);
      padding-block: var(--space-8);
      border-block: var(--border-width) solid var(--color-border-subtle);
    }

    .metrics__item {
      display: flex;
      flex-direction: column-reverse;
      gap: var(--space-2);
    }

    .metrics__value {
      font: var(--weight-medium) var(--text-h1) / var(--leading-h1) var(--font-heading);
      letter-spacing: var(--tracking-h1);
      margin: 0;
    }

    .metrics__label {
      color: var(--color-text-muted);
    }
  }
</style>
