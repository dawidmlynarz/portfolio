---
interface Props {
  /** One to three highlights. More than three dilutes them, so the build fails. */
  items: { value: string; label: string }[];
  /** Inside Prose: content (reading measure, default) or wide (page width). */
  width?: "content" | "wide";
}
const { items, width = "content" } = Astro.props;
if (items.length > 3) {
  throw new Error(`Metrics holds at most 3 items, got ${items.length}.`);
}
---

<dl class="metrics" data-width={width} style={`--metrics-columns: ${items.length}`}>
  {items.map(({ value, label }) => (
    <div class="metrics__item">
      <dt class="metrics__label">{label}</dt>
      <dd class="metrics__value">{value}</dd>
    </div>
  ))}
</dl>

<style>
  @layer components {
    .metrics {
      display: grid;
      grid-template-columns: 1fr;
      align-items: start;
      gap: var(--space-6) var(--space-8);
      padding-block: var(--space-8);
      border-block: var(--border-width) solid var(--color-border-subtle);
    }

    @media (width >= 36em) {
      .metrics {
        grid-template-columns: repeat(var(--metrics-columns), minmax(0, 1fr));
      }
    }

    /* Value above label, both pinned to the top so labels of any length line up. */
    .metrics__item {
      display: grid;
      grid-template-rows: auto auto;
      align-content: start;
      gap: var(--space-2);
    }

    .metrics__value {
      grid-row: 1;
      font: var(--weight-medium) var(--text-h2) / var(--leading-h2) var(--font-heading);
      letter-spacing: var(--tracking-h2);
      margin: 0;
    }

    .metrics__label {
      grid-row: 2;
      color: var(--color-text-muted);
    }

    .metrics[data-width="wide"] .metrics__value {
      font-size: var(--text-h1);
      line-height: var(--leading-h1);
      letter-spacing: var(--tracking-h1);
    }
  }
</style>
