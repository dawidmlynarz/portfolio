---
/**
 * Case-study contents as a mini map, fixed at the right edge from 62em. One short line per h2.
 * Hovering the map opens the rows up a little; the hovered (or focused) row swaps its line for its
 * section title, one at a time, with no panel behind it. The title arrives with the row tear (CSS
 * only: two aria-hidden copies and the link-tear keyframes from base.css). Each row links to its
 * section (Lenis smooths the jump when the motion layer runs).
 *
 * Progress: each line fills as you read its section, so the filled lines show where you are; the
 * current section's title is in the text colour (aria-current). The map only shows while the
 * case-study body is on screen. Both need the small script below; without it the map stays
 * hidden (the page is complete without it).
 */
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  /** Selector of the element that holds the sections (its end closes the last one). */
  body: string;
}

const { headings, body } = Astro.props;
const sections = headings.filter(({ depth }) => depth === 2);
---

{sections.length > 1 && (
  <nav class="toc" aria-label="On this page" data-toc data-toc-body={body}>
    <ol class="toc__list" role="list">
      {sections.map(({ slug, text }) => (
        <li>
          <a class="toc__link" href={`#${slug}`} data-toc-link={slug} data-no-tear>
            <span class="toc__label">
              <span class="toc__text">{text}</span>
              {["outer", "middle"].map((part) => (
                <span class:list={["toc__tear", `toc__tear--${part}`]} aria-hidden="true">
                  {text}
                </span>
              ))}
            </span>
            <span class="toc__bar" aria-hidden="true">
              <span class="toc__fill" />
            </span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  // Fills each section's line as it is read, marks the current one, and shows the map only while
  // the case-study body is on screen. The reading line sits a third of the way down the screen.
  const toc = document.querySelector<HTMLElement>("[data-toc]");
  const body = toc && document.querySelector<HTMLElement>(toc.dataset.tocBody ?? "");
  if (toc && body) {
    const rows = [...toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")].flatMap((link) => {
      const heading = document.getElementById(link.dataset.tocLink ?? "");
      return heading ? [{ link, heading }] : [];
    });

    let frame = 0;
    const update = () => {
      frame = 0;
      const line = innerHeight / 3;
      const end = body.getBoundingClientRect().bottom;
      toc.toggleAttribute(
        "data-visible",
        body.getBoundingClientRect().top < innerHeight / 2 && end > line,
      );
      rows.forEach(({ link, heading }, i) => {
        const top = heading.getBoundingClientRect().top;
        const next = rows[i + 1]?.heading.getBoundingClientRect().top ?? end;
        const fill = Math.min(1, Math.max(0, (line - top) / Math.max(1, next - top)));
        link.style.setProperty("--toc-fill", String(fill));
        if (top <= line && next > line) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };
    const schedule = () => (frame ||= requestAnimationFrame(update));

    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    toc.setAttribute("data-ready", "");
    update();
  }
</script>

<style>
  @layer components {
    .toc {
      display: none;
    }

    @media (width >= 62em) {
      .toc[data-ready] {
        position: fixed;
        inset-block-start: 50%;
        inset-inline-end: var(--space-8); /* in line with Back to top */
        z-index: calc(var(--z-nav) - 1);
        display: block;
        opacity: 0;
        visibility: hidden;
        translate: 0 -50%;
        transition:
          opacity var(--duration-link) var(--ease-standard),
          visibility var(--duration-link);
      }

      .toc[data-visible],
      .toc:focus-within {
        opacity: 1;
        visibility: visible;
      }
    }

    .toc__list {
      display: grid;
      justify-items: end;
      padding: var(--space-2) 0;
    }

    /* A row is just its line. The title sits on top of it, folded away, and only the hovered or
       focused row swaps its line for its title. The rows open up a little while the map is
       hovered, so a title has room between its neighbours. */
    .toc__link {
      --underline-size: 0%;

      position: relative;
      display: grid;
      justify-items: end;
      padding-block: var(--space-1);
      padding-inline-start: var(--space-4);
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--color-text-muted);
      transition: padding-block var(--duration-fast) var(--ease-standard);
    }

    .toc:is(:hover, :focus-within) .toc__link {
      padding-block: calc(1.5 * var(--space-1));
    }

    .toc__link:hover,
    .toc__link:focus-visible,
    .toc__link[aria-current] {
      color: var(--color-text);
    }

    .toc__label {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-end: 0;
      max-inline-size: 20rem;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      visibility: hidden;
      pointer-events: none;
      translate: 0 -50%;
    }

    /* The title arrives with the site's row tear: two copies cut into rows jolt sideways for
       --duration-tear while the real text waits, then the clean title stays. */
    .toc__link:is(:hover, :focus-visible) .toc__label {
      visibility: visible;
    }

    .toc__tear {
      position: absolute;
      inset: 0;
      opacity: 0;
    }

    .toc__tear--outer {
      clip-path: polygon(0 0, 100% 0, 100% 34%, 0 34%, 0 67%, 100% 67%, 100% 100%, 0 100%);
    }

    .toc__tear--middle {
      clip-path: inset(34% 0 33% 0);
    }

    .toc__link:is(:hover, :focus-visible) .toc__text {
      animation: toc-tear-hide var(--duration-tear) steps(1, end);
    }

    .toc__link:is(:hover, :focus-visible) .toc__tear--outer {
      animation: link-tear-outer var(--duration-tear) steps(1, end);
    }

    .toc__link:is(:hover, :focus-visible) .toc__tear--middle {
      animation: link-tear-middle var(--duration-tear) steps(1, end);
    }

    @keyframes toc-tear-hide {
      0%,
      100% {
        opacity: 0;
      }
    }

    .toc__bar {
      overflow: hidden;
      inline-size: var(--space-4);
      block-size: calc(2 * var(--border-width));
      border-radius: var(--radius-pill);
      background-color: var(--color-border-muted);
      transform-origin: right;
      transition:
        inline-size var(--duration-fast) var(--ease-standard),
        opacity var(--duration-fast) var(--ease-standard),
        scale var(--duration-fast) var(--ease-standard);
    }

    .toc__link:is(:hover, :focus-visible) .toc__bar {
      opacity: 0;
      scale: 0 1;
    }

    .toc__link[aria-current] .toc__bar {
      inline-size: var(--space-6);
    }

    .toc__fill {
      display: block;
      block-size: 100%;
      background-color: var(--color-text);
      transform-origin: left;
      scale: var(--toc-fill, 0) 1;
    }

    @media (prefers-reduced-motion: reduce) {
      .toc[data-ready],
      .toc__link,
      .toc__bar {
        transition: none;
      }

      .toc__link:is(:hover, :focus-visible) :is(.toc__text, .toc__tear) {
        animation: none;
      }
    }
  }
</style>
